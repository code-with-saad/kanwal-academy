	"content": {
		"courses": [
			{
				"id": "course-quranic-recitation",
				"slug": "quranic-recitation",
				"status": "published",
				"data": {
					"name": "Qur'anic Recitation",
					"summary": "Build fluent, accurate recitation with a teacher who listens and corrects in real time.",
					"level": "All levels",
					"order": 1,
					"description": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "This course is for students who want to read the Qur'an aloud with confidence. Lessons focus on pronunciation, rhythm and the correct articulation of each letter."
								}
							]
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [{ "_type": "span", "text": "What you will work on" }]
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Your teacher listens to you recite, corrects mistakes as they happen and gives you a short practice plan for the week."
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Students can start from the alphabet or from full surahs. The pace is set by you and your teacher."
								}
							]
