# Generate a key with: npx emdash secrets generate
EMDASH_ENCRYPTION_KEY=

# Optional Cloudflare Turnstile keys for the enrolment and newsletter forms.
# Without them the forms still validate on the server, but no challenge is shown.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# EmailJS notification settings for new enrolment leads. Leads are always
# saved to D1 / EmDash first; with these unset the email step is simply
# skipped. Create all four values at https://dashboard.emailjs.com.
# The EmailJS template must use {{to_email}} in its "To" field and
# {{reply_to}} in "Reply to". Server-side (non-browser) calls authenticate
# with the PRIVATE key via the accessToken field. If EmailJS still rejects
# the call, disable the origin check (or add your domain to the allowed
# origins) under Account -> General in the EmailJS dashboard.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Fallback owner notification email if site_settings.owner_email is not set.
OWNER_EMAIL=

# Demo placeholders: set to 1 to show the three labelled "Sample" review cards
# and the three labelled teacher placeholders. Leave unset (or 0) in production:
# the testimonials section then stays hidden until real reviews with
# consent_given = true exist in the CMS.
EMDASH_DEMO=1
