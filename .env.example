# Generate a key with: npx emdash secrets generate
EMDASH_ENCRYPTION_KEY=

# Optional Cloudflare Turnstile keys for the newsletter form.
# Without them the form still validates on the server, but no challenge is shown.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Demo placeholders: set to 1 to show the three labelled "Sample" review cards
# and the three labelled teacher placeholders. Leave unset (or 0) in production:
# the testimonials section then stays hidden until real reviews with
# consent_given = true exist in the CMS.
EMDASH_DEMO=1
