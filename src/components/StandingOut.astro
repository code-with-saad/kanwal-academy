---
import { useUi } from "../i18n";

const { t } = useUi(Astro);

interface Item {
	number: string;
	title: string;
	text: string;
	icon: "clock" | "book" | "screens";
}

interface Props {
	eyebrow?: string;
	heading?: string;
	items?: Item[];
}

const defaults: Item[] = [
	{
		number: "01",
		title: t.home.standing_item_1_title,
		text: t.home.standing_item_1_text,
		icon: "clock",
	},
	{
		number: "02",
		title: t.home.standing_item_2_title,
		text: t.home.standing_item_2_text,
		icon: "book",
	},
	{
		number: "03",
		title: t.home.standing_item_3_title,
		text: t.home.standing_item_3_text,
		icon: "screens",
	},
];

const icons: Item["icon"][] = ["clock", "book", "screens"];

const {
	eyebrow = t.home.standing_eyebrow,
	heading = t.home.standing_heading,
	items = defaults,
} = Astro.props;
---

<div class="standing" data-reveal="fade">
	<h2 class="standing__title" data-reveal-words>{heading}</h2>

	<ul class="standing__grid">
		{
			items.map((item, index) => (
				<li
					class="standing__item"
					style={`--item-index: ${index}`}
					data-reveal="up"
					data-reveal-delay={120 + index * 100}
				>
					<span class="standing__tab" aria-hidden="true">
						{String(index + 1).padStart(2, "0")}
					</span>

					<span class="standing__icon" aria-hidden="true">
						<svg
							viewBox="0 0 48 48"
							width="48"
							height="48"
							fill="none"
							stroke="currentColor"
							stroke-width="1.4"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							{(item.icon ?? icons[index] ?? "clock") === "clock" && (
								<>
									<circle cx="24" cy="24" r="18" />
									<circle cx="24" cy="24" r="14" />
									<path class="standing__hand standing__hand--hour" d="M24 24V16" />
									<path class="standing__hand standing__hand--minute" d="M24 24h8" />
									<circle cx="24" cy="24" r="1.6" fill="currentColor" stroke="none" />
								</>
							)}
							{(item.icon ?? icons[index] ?? "clock") === "book" && (
								<>
									<circle cx="24" cy="24" r="18" />
									<path d="M24 14c-3.7-2.5-8.4-3.2-13.5-3v26c5.1-.2 9.8.5 13.5 3 3.7-2.5 8.4-3.2 13.5-3v-26c-5.1-.2-9.8.5-13.5 3Z" />
									<path d="M24 14v22" />
									<path class="standing__ribbon" d="M24 15v10l3-2.5 3 2.5v-10" />
								</>
							)}
							{(item.icon ?? icons[index] ?? "clock") === "screens" && (
								<>
									<circle cx="24" cy="24" r="18" />
									<rect x="7" y="14" width="13" height="16" rx="2.5" />
									<rect x="28" y="14" width="13" height="16" rx="2.5" />
									<path d="M20 22h8" />
									<circle class="standing__pulse" cx="24" cy="22" r="1.5" fill="currentColor" stroke="none" />
								</>
							)}
						</svg>
					</span>

					<h3 class="standing__item-title">{item.title}</h3>
					<p class="standing__text">{item.text}</p>
				</li>
			))
		}
	</ul>
</div>

<style>
	.standing {
		padding: clamp(28px, 5vw, 48px);
		border-radius: var(--radius-panel);
		background: var(--mint-100);
		color: var(--ink);
		display: grid;
		gap: clamp(32px, 5vw, 56px);
	}

	.standing__title {
		margin: 0;
	}

	.standing__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(16px, 3vw, 32px);
		width: 100%;
	}

	.standing__item {
		position: relative;
		display: grid;
		align-content: start;
		gap: var(--space-md);
		padding: 48px 24px 28px;
		border-radius: 24px;
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: 0 8px 28px -12px rgba(11, 26, 20, 0.1);
		transition:
			transform var(--transition),
			box-shadow var(--transition);
	}

	.standing__item:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 36px -12px rgba(11, 26, 20, 0.16);
	}

	/* Mint number tab with rounded inner corner */
	.standing__tab {
		position: absolute;
		top: 0;
		inset-inline-start: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 36px;
		padding-inline-start: 16px;
		background: var(--mint-100);
		color: var(--green-deep);
		font-size: 18px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		line-height: 1;
		border-radius: 0 0 16px 0;
	}

	/* 96px outlined ring icon circle */
	.standing__icon {
		display: grid;
		place-items: center;
		width: 96px;
		height: 96px;
		border: 1.5px solid var(--line);
		border-radius: 50%;
		background: var(--mint-50);
		color: var(--green-deep);
	}

	.standing__icon svg {
		width: 44px;
		height: 44px;
	}

	.standing__item-title {
		font-size: var(--type-h3-size);
		font-weight: 500;
	}

	.standing__text {
		max-width: 34ch;
		color: var(--ink-muted);
		font-size: var(--type-small-size);
		line-height: 1.6;
	}

	/* Icon animations on reveal */
	.standing__hand {
		transform-origin: 24px 24px;
	}

	.standing.is-revealed .standing__hand--minute {
		animation: standing-sweep 6s linear infinite;
	}

	.standing.is-revealed .standing__hand--hour {
		animation: standing-sweep 24s linear infinite;
	}

	.standing__ribbon {
		transform-origin: 24px 15px;
	}

	.standing.is-revealed .standing__ribbon {
		animation: standing-wave 1500ms var(--ease-out) 200ms 1;
	}

	.standing__pulse {
		opacity: 0;
	}

	.standing.is-revealed .standing__pulse {
		animation: standing-travel 2.8s var(--ease-out) 300ms infinite;
	}

	@keyframes standing-sweep {
		to { transform: rotate(360deg); }
	}

	@keyframes standing-wave {
		0%   { transform: rotate(0deg); }
		30%  { transform: rotate(9deg); }
		55%  { transform: rotate(-5deg); }
		78%  { transform: rotate(3deg); }
		100% { transform: rotate(0deg); }
	}

	@keyframes standing-travel {
		0%   { transform: translateX(0); opacity: 0; }
		15%  { opacity: 1; }
		85%  { opacity: 1; }
		100% { transform: translateX(8px); opacity: 0; }
	}

	/* ========== MOBILE ========== */
	@media (max-width: 768px) {
		.standing {
			padding: clamp(24px, 5vw, 36px);
			border-radius: 0;
		}

		.standing__grid {
			grid-template-columns: 1fr;
			gap: 20px;
		}

		.standing__item {
			padding: 44px 20px 24px;
		}
	}

	@media (max-width: 400px) {
		.standing__icon {
			width: 80px;
			height: 80px;
		}

		.standing__icon svg {
			width: 36px;
			height: 36px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.standing__item {
			transition: none;
		}

		.standing__hand,
		.standing__ribbon,
		.standing__pulse {
			animation: none !important;
		}
	}
</style>
