---
import { formatUsdPrice } from "../utils/price";

export interface PlanCardData {
	slug?: string;
	name: string;
	price: number | string;
	classesPerWeek: number;
	classesPerMonth: number;
	hoursPerMonth: number;
	isPopular?: boolean;
}

interface Props {
	plan: PlanCardData;
	href?: string;
	revealDelay?: number;
}

const { plan, revealDelay } = Astro.props;
const priceLabel = formatUsdPrice(plan.price);
---

<div
	class="plan-card"
	class:list={[plan.isPopular && "plan-card--popular"]}
	role="group"
	aria-label={plan.name}
	data-reveal="up"
	style={revealDelay ? `--reveal-delay: ${revealDelay}ms` : undefined}
>
	{plan.isPopular && (
		<span class="plan-card__badge">
			<svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
				<path d="M8 1.5l1.76 3.57 3.94.57-2.85 2.78.67 3.93L8 10.47l-3.52 1.88.67-3.93L2.3 5.64l3.94-.57z" />
			</svg>
			Most popular
		</span>
	)}

	<div class="plan-card__body">
		<h3 class="plan-card__name">{plan.name}</h3>
		<p class="plan-card__price">
			<span class="plan-card__amount">{priceLabel}</span>
			<span class="plan-card__period">/ month</span>
		</p>

		<div class="plan-card__hairline" aria-hidden="true"></div>

		<ul class="plan-card__meta">
			<li>
				<span class="plan-card__meta-icon" aria-hidden="true">
					<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="var(--green-deep)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="4" width="14" height="13" rx="2" />
						<path d="M3 8h14" />
						<path d="M7 2v3" />
						<path d="M13 2v3" />
					</svg>
				</span>
				<span class="plan-card__meta-label">Classes each week</span>
				<span class="plan-card__meta-value">{plan.classesPerWeek}</span>
			</li>
			<li>
				<span class="plan-card__meta-icon" aria-hidden="true">
					<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="var(--green-deep)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="4" width="14" height="13" rx="2" />
						<path d="M3 8h14" />
						<path d="M7 2v3" />
						<path d="M13 2v3" />
					</svg>
				</span>
				<span class="plan-card__meta-label">Classes each month</span>
				<span class="plan-card__meta-value">{plan.classesPerMonth}</span>
			</li>
			<li>
				<span class="plan-card__meta-icon" aria-hidden="true">
					<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="var(--green-deep)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="10" cy="10" r="7.5" />
						<path d="M10 6v4l2.5 2.5" />
					</svg>
				</span>
				<span class="plan-card__meta-label">Teaching hours each month</span>
				<span class="plan-card__meta-value">{plan.hoursPerMonth}</span>
			</li>
		</ul>

		<button
			class="plan-card__cta"
			type="button"
			data-open-modal
			data-prefill-plan={plan.name}
		>
			Select plan
			<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4 10h12m-5-5 5 5-5 5" />
			</svg>
		</button>
	</div>
</div>

<style>
	.plan-card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		border-radius: 24px;
		border: 1px solid var(--line);
		background: var(--surface);
		box-shadow: 0 8px 28px -12px rgba(11, 26, 20, 0.1);
		transition:
			transform var(--transition),
			box-shadow var(--transition),
			border-color var(--transition);
	}

	.plan-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 36px -12px rgba(11, 26, 20, 0.16);
	}

	.plan-card--popular {
		border-color: var(--green);
		box-shadow: 0 12px 40px -12px rgba(14, 134, 96, 0.18);
	}

	.plan-card--popular:hover {
		box-shadow: 0 16px 48px -12px rgba(14, 134, 96, 0.24);
	}

	@media (hover: none) {
		.plan-card:hover {
			transform: none;
			box-shadow: 0 8px 28px -12px rgba(11, 26, 20, 0.1);
		}

		.plan-card--popular:hover {
			box-shadow: 0 12px 40px -12px rgba(14, 134, 96, 0.18);
		}
	}

	.plan-card__badge {
		position: absolute;
		top: 16px;
		right: 16px;
		z-index: 3;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 30px;
		padding: 0 14px;
		border-radius: 999px;
		background: var(--green);
		color: #ffffff;
		font-size: 12px;
		font-weight: 600;
		line-height: 1;
	}

	.plan-card__body {
		display: grid;
		align-content: start;
		gap: var(--space-sm);
		padding: 28px 24px;
		flex: 1;
	}

	.plan-card__name {
		font-size: var(--type-h3-size);
		font-weight: 500;
	}

	.plan-card__price {
		display: flex;
		align-items: baseline;
		gap: 6px;
		margin-top: 4px;
	}

	.plan-card__amount {
		font-size: clamp(36px, 4vw, 48px);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.plan-card__period {
		color: var(--ink-muted);
		font-size: var(--type-small-size);
	}

	.plan-card__hairline {
		height: 1px;
		background: var(--line);
		margin: 4px 0;
	}

	.plan-card__meta {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.plan-card__meta li {
		display: grid;
		grid-template-columns: 32px 1fr auto;
		align-items: center;
		gap: 12px;
		padding-block: 10px;
		border-bottom: 1px solid var(--line);
	}

	.plan-card__meta li:last-child {
		border-bottom: none;
	}

	.plan-card__meta-icon {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--mint-100);
	}

	.plan-card__meta-label {
		color: var(--ink-muted);
		font-size: var(--type-small-size);
	}

	.plan-card__meta-value {
		font-weight: 600;
		font-size: var(--type-body-size);
	}

	.plan-card__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		width: 100%;
		height: 48px;
		margin-top: var(--space-sm);
		border: none;
		border-radius: 999px;
		background: var(--green);
		color: #ffffff;
		font: inherit;
		font-size: var(--type-body-size);
		font-weight: 500;
		text-decoration: none;
		cursor: pointer;
		transition:
			background-color var(--transition),
			transform var(--transition);
	}

	.plan-card__cta:hover {
		background: var(--green-deep);
	}

	/* Dark theme adjustments for popular card */
	:global(html[data-theme="dark"]) .plan-card--popular {
		background: var(--green);
		color: var(--on-accent);
	}

	:global(html[data-theme="dark"]) .plan-card--popular .plan-card__name,
	:global(html[data-theme="dark"]) .plan-card--popular .plan-card__amount {
		color: var(--on-accent);
	}

	:global(html[data-theme="dark"]) .plan-card--popular .plan-card__period,
	:global(html[data-theme="dark"]) .plan-card--popular .plan-card__meta-label {
		color: color-mix(in srgb, var(--on-accent) 70%, transparent);
	}

	:global(html[data-theme="dark"]) .plan-card--popular .plan-card__hairline,
	:global(html[data-theme="dark"]) .plan-card--popular .plan-card__meta li {
		border-color: color-mix(in srgb, var(--on-accent) 20%, transparent);
	}

	:global(html[data-theme="dark"]) .plan-card--popular .plan-card__meta-icon {
		background: color-mix(in srgb, var(--on-accent) 20%, transparent);
	}

	:global(html[data-theme="dark"]) .plan-card--popular .plan-card__meta-icon svg {
		stroke: var(--on-accent);
	}

	:global(html[data-theme="dark"]) .plan-card--popular .plan-card__cta {
		background: var(--on-accent);
		color: var(--green);
	}

	:global(html[data-theme="dark"]) .plan-card--popular .plan-card__cta:hover {
		background: #ffffff;
	}

	:global(html[data-theme="dark"]) .plan-card--popular .plan-card__badge {
		background: var(--on-accent);
		color: var(--green);
	}

	@media (prefers-reduced-motion: reduce) {
		.plan-card {
			transition: none;
		}

		.plan-card__cta {
			transition: none;
		}
	}
</style>
