---
import Button from "./Button.astro";

export interface PlanCardData {
	slug?: string;
	name: string;
	price: number | string;
	classesPerWeek: number;
	classesPerMonth: number;
	hoursPerMonth: number;
	isPopular?: boolean;
}

interface Props {
	plan: PlanCardData;
	variant?: "default" | "inverted";
	showBismillah?: boolean;
	href?: string;
}

const { plan, variant = "default", showBismillah = false, href } = Astro.props;
const inverted = variant === "inverted";

const numericPrice = typeof plan.price === "number" ? plan.price : Number(plan.price);
const priceLabel = Number.isFinite(numericPrice)
	? new Intl.NumberFormat("en-US", {
			style: "currency",
			currency: "USD",
			maximumFractionDigits: 0,
		}).format(numericPrice)
	: String(plan.price);

const planHref =
	href ?? (plan.slug ? `/free-trial?plan=${encodeURIComponent(plan.slug)}` : "/free-trial");
---

<article class:list={["plan-card", inverted && "plan-card--inverted tone-dark"]}>
	{
		showBismillah && (
			<p class="plan-card__bismillah" lang="ar" dir="rtl">
				بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
			</p>
		)
	}

	<div class="plan-card__head">
		<h3 class="plan-card__name">{plan.name}</h3>
		{plan.isPopular && <span class="plan-card__badge">Most popular</span>}
	</div>

	<p class="plan-card__price">
		<span class="plan-card__amount">{priceLabel}</span>
		<span class="plan-card__period">/ month</span>
	</p>

	<dl class="plan-card__meta">
		<div>
			<dt>Classes each week</dt>
			<dd>{plan.classesPerWeek}</dd>
		</div>
		<div>
			<dt>Classes each month</dt>
			<dd>{plan.classesPerMonth}</dd>
		</div>
		<div>
			<dt>Teaching hours each month</dt>
			<dd>{plan.hoursPerMonth}</dd>
		</div>
	</dl>

	<div class="plan-card__cta">
		<Button href={planHref} variant={inverted ? "primary" : "secondary"}>Select plan</Button>
	</div>
</article>

<style>
	.plan-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: var(--space-xl);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--surface);
		color: var(--text);
	}

	.plan-card--inverted {
		border-color: var(--line-dark);
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.plan-card__bismillah {
		margin-bottom: var(--space-lg);
		color: var(--sage);
		font-family: var(--font-arabic, "Amiri", serif);
		font-size: 1.25rem;
		line-height: 1.6;
		text-align: center;
	}

	.plan-card__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-md);
	}

	.plan-card__name {
		font-size: 1.375rem;
	}

	.plan-card__badge {
		flex: none;
		padding: 4px 8px;
		border-radius: var(--radius-button);
		background: var(--sage);
		color: var(--bg-dark);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.plan-card__price {
		display: flex;
		align-items: baseline;
		gap: var(--space-xs);
		margin-top: var(--space-md);
		padding-bottom: var(--space-lg);
	}

	.plan-card__amount {
		font-family: var(--font-heading, Georgia, serif);
		font-size: clamp(2.5rem, 4vw, 3rem);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.plan-card__period {
		color: var(--muted);
		font-size: var(--size-small);
	}

	.plan-card__meta {
		display: grid;
		margin: 0;
	}

	.plan-card__meta > div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-md);
		padding-block: 10px;
		border-top: 1px solid var(--line);
	}

	.plan-card__meta dt {
		color: var(--muted);
		font-size: var(--size-small);
	}

	.plan-card__meta dd {
		margin: 0;
		font-weight: 600;
	}

	.plan-card__cta {
		margin-top: auto;
		padding-top: var(--space-lg);
	}

	.plan-card__cta :global(.btn) {
		width: 100%;
	}
</style>
