---
import type { EditProxy } from "emdash";
import Button from "./Button.astro";
import { formatUsdPrice } from "../utils/price";

export interface PlanCardData {
	slug?: string;
	name: string;
	price: number | string;
	classesPerWeek: number;
	classesPerMonth: number;
	hoursPerMonth: number;
	isPopular?: boolean;
}

interface Props {
	plan: PlanCardData;
	variant?: "default" | "inverted" | "hero";
	showBismillah?: boolean;
	href?: string;
	headingLevel?: 2 | 3;
	planEdit?: EditProxy;
	homeEdit?: EditProxy;
	periodLabel?: string;
	classesWeekLabel?: string;
	classesMonthLabel?: string;
	hoursLabel?: string;
	popularLabel?: string;
	selectLabel?: string;
}

const {
	plan,
	variant = "default",
	showBismillah = false,
	href,
	headingLevel = 3,
	planEdit,
	homeEdit,
	periodLabel = "/ month",
	classesWeekLabel = "Classes each week",
	classesMonthLabel = "Classes each month",
	hoursLabel = "Teaching hours each month",
	popularLabel = "Most popular",
	selectLabel = "Select plan",
} = Astro.props;
const inverted = variant === "inverted" || variant === "hero";
const Heading = `h${headingLevel}` as "h2" | "h3";

const priceLabel = formatUsdPrice(plan.price);

const planHref =
	href ?? (plan.slug ? `/free-trial?plan=${encodeURIComponent(plan.slug)}` : "/free-trial");
---

<article
	class:list={[
		"plan-card",
		variant === "inverted" && "plan-card--inverted",
		variant === "hero" && "plan-card--hero",
	]}
>
	{
		showBismillah && (
			<p class="plan-card__bismillah" lang="ar" dir="rtl">
				بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
			</p>
		)
	}

	<div class="plan-card__head">
		<Heading class="plan-card__name" {...planEdit?.name}>{plan.name}</Heading>
		{plan.isPopular && <span class="plan-card__badge" {...homeEdit?.pricing_popular_label}>{popularLabel}</span>}
	</div>

	<p class="plan-card__price">
		<span class="plan-card__amount" {...planEdit?.price}>{priceLabel}</span>
		<span class="plan-card__period" {...homeEdit?.pricing_period_label}>{periodLabel}</span>
	</p>

	<dl class="plan-card__meta">
		<div>
			<dt {...homeEdit?.pricing_classes_week_label}>{classesWeekLabel}</dt>
			<dd {...planEdit?.classes_per_week}>{plan.classesPerWeek}</dd>
		</div>
		<div>
			<dt {...homeEdit?.pricing_classes_month_label}>{classesMonthLabel}</dt>
			<dd {...planEdit?.classes_per_month}>{plan.classesPerMonth}</dd>
		</div>
		<div>
			<dt {...homeEdit?.pricing_hours_label}>{hoursLabel}</dt>
			<dd {...planEdit?.hours_per_month}>{plan.hoursPerMonth}</dd>
		</div>
	</dl>

	<div class="plan-card__cta">
		<Button href={planHref} variant={inverted ? "primary" : "secondary"} edit={homeEdit?.pricing_select_cta}>{selectLabel}</Button>
	</div>
</article>

<style>
	.plan-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: var(--space-lg);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--page);
		color: var(--ink);
	}

	.plan-card--inverted,
	.plan-card--hero {
		border-color: transparent;
		background: var(--deep);
		color: #eaf4ef;
		--ink: #eaf4ef;
		--ink-muted: #9db3a8;
		--line: color-mix(in srgb, #eaf4ef 18%, transparent);
		--accent: #3fc391;
		--green: #3fc391;
		--green-deep: #6fd9ae;
		--on-accent: #062017;
	}

	/* In dark mode the featured plan is a green card with dark text, a dark
	 * badge and a dark select button, all above 4.5:1. */
	:global(html[data-theme="dark"]) .plan-card--inverted,
	:global(html[data-theme="dark"]) .plan-card--hero {
		background: var(--green);
		color: #062017;
		--ink: #062017;
		--ink-muted: #0b3a26;
		--line: color-mix(in srgb, #062017 25%, transparent);
		--accent: #062017;
		--green: #062017;
		--green-deep: #062017;
		--on-accent: #3fc391;
	}

	.plan-card__bismillah {
		margin-bottom: var(--space-lg);
		color: var(--green-deep);
		font-family: var(--font-arabic, "Amiri", serif);
		font-size: 1.25rem;
		line-height: 1.6;
		text-align: center;
	}

	.plan-card__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-md);
	}

	.plan-card__name {
		font-size: 1.375rem;
		font-weight: 500;
	}

	.plan-card__badge {
		flex: none;
		padding: 6px 10px;
		border-radius: var(--radius-chip);
		background: var(--green);
		color: var(--on-accent);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.plan-card__price {
		display: flex;
		align-items: baseline;
		gap: var(--space-xs);
		margin-top: var(--space-md);
		padding-bottom: var(--space-lg);
	}

	.plan-card__amount {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 4vw, 3rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.plan-card__period {
		color: var(--ink-muted);
		font-size: var(--size-small);
	}

	.plan-card__meta {
		display: grid;
		margin: 0;
	}

	.plan-card__meta > div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-md);
		padding-block: 10px;
		border-top: 1px solid var(--line);
	}

	.plan-card__meta dt {
		color: var(--ink-muted);
		font-size: var(--size-small);
	}

	.plan-card__meta dd {
		margin: 0;
		font-weight: 600;
	}

	.plan-card__cta {
		margin-top: auto;
		padding-top: var(--space-lg);
	}

	.plan-card__cta :global(.btn) {
		width: 100%;
	}
</style>
