---
import Button from "./Button.astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface Props {
	titleBefore: string;
	titleHighlight: string;
	titleAfter?: string;
	paragraphs: string[];
	imageSrc: string;
	imageAlt: string;
	imageLabel: string;
	reverse?: boolean;
	tips?: string[];
	ctaLabel?: string;
	ctaHref: string;
}

const {
	titleBefore,
	titleHighlight,
	titleAfter = "",
	paragraphs,
	imageSrc,
	imageAlt,
	imageLabel,
	reverse = false,
	tips,
	ctaLabel = "Learn more",
	ctaHref,
} = Astro.props;
---

<div class:list={["study", reverse && "study--reverse"]}>
	<div class="study__media">
		<ImagePlaceholder
			src={imageSrc}
			alt={imageAlt}
			label={imageLabel}
			ratio="4 / 3"
			class="study__image"
		/>
	</div>

	<div class="study__copy">
		<h2 class="study__title">
			{titleBefore} <span class="heading-highlight">{titleHighlight}</span>{titleAfter}
		</h2>
		{paragraphs.map((paragraph) => <p>{paragraph}</p>)}

		{
			tips && tips.length > 0 && (
				<ul class="study__tips">
					{tips.map((tip) => (
						<li>
							<svg
								class="study__tick"
								viewBox="0 0 16 16"
								width="16"
								height="16"
								aria-hidden="true"
								focusable="false"
							>
								<path
									d="M3 8.4l3.1 3.1L13 4.8"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
							<span>{tip}</span>
						</li>
					))}
				</ul>
			)
		}

		<div class="study__actions">
			<Button href={ctaHref} variant="secondary">{ctaLabel}</Button>
		</div>
	</div>
</div>

<style>
	.study {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(32px, 6vw, 88px);
	}

	.study__media {
		overflow: clip;
		border-radius: var(--radius-panel);
		background: var(--mint-50);
	}

	.study__media :global(.study__image),
	.study__media :global(.study__image .img-ph__img),
	.study__media :global(.study__image .img-ph__box) {
		border-radius: var(--radius-panel);
	}

	.study__copy {
		display: grid;
		justify-items: start;
		gap: var(--space-md);
	}

	.study__title {
		max-width: 20ch;
	}

	.study__copy > p {
		max-width: 50ch;
		color: var(--ink-muted);
	}

	.study__tips {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-sm) var(--space-lg);
		width: 100%;
		margin-top: var(--space-xs);
	}

	.study__tips li {
		display: flex;
		align-items: flex-start;
		gap: var(--space-xs);
		color: var(--ink);
		font-size: var(--size-small);
		line-height: 1.5;
	}

	.study__tick {
		flex: none;
		margin-top: 3px;
		color: var(--green-deep);
	}

	.study__actions {
		margin-top: var(--space-sm);
	}

	/* Image right by default, image left when reversed. */
	.study--reverse .study__media {
		order: -1;
	}

	@media (max-width: 900px) {
		.study {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}

		.study--reverse .study__media {
			order: 0;
		}
	}

	@media (max-width: 460px) {
		.study__tips {
			grid-template-columns: 1fr;
		}
	}
</style>
