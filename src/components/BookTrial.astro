---
import Eyebrow from "./Eyebrow.astro";
import Button from "./Button.astro";
import { emailHref, phoneHref, type SiteContact } from "../utils/site-config";

interface Props {
	contact: SiteContact;
}

const { contact } = Astro.props;

// Old plan and course deep links (/ ?plan=...#book) still prefill the modal.
const preselectedPlan = Astro.url.searchParams.get("plan") ?? "";
const preselectedCourse = Astro.url.searchParams.get("course") ?? "";

const modalProps = (): Record<string, string> => ({
	"data-open-modal": "",
	...(preselectedPlan ? { "data-prefill-plan": preselectedPlan } : {}),
	...(preselectedCourse ? { "data-prefill-course": preselectedCourse } : {}),
});
---

<div class="book">
	<div class="book__copy">
		<Eyebrow>Free trial</Eyebrow>
		<h2 class="book__title">Book a free trial class</h2>
		<p class="book__lead">
			Tell us a little about the student and the times that suit you. We will reply with the
			next available trial slot. The trial class is free and no payment details are needed.
		</p>

		<address class="book__contact">
			<span class="book__contact-label">Reach us directly</span>
			<a href={phoneHref(contact.phone)}>{contact.phone}</a>
			<a href={emailHref(contact.email)}>{contact.email}</a>
			<span>{contact.address}</span>
		</address>

		<div class="book__actions">
			<Button variant="primary" {...modalProps()}>Request free trial</Button>
			<p class="book__note">
				Lessons run live in a video call. You only need a phone, tablet or laptop with a camera.
			</p>
		</div>
	</div>
</div>

<style>
	.book {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-md);
		align-items: start;
	}

	.book__copy {
		display: grid;
		justify-items: start;
		gap: var(--space-md);
	}

	.book__title {
		max-width: 16ch;
	}

	.book__lead {
		max-width: 46ch;
		color: var(--ink-muted);
	}

	.book__contact {
		display: grid;
		gap: var(--space-xs);
		margin-top: var(--space-sm);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--line);
		color: var(--ink-muted);
		font-style: normal;
	}

	.book__contact-label {
		color: var(--ink);
		font-weight: 600;
	}

	.book__contact a {
		color: var(--ink);
		text-decoration: none;
		transition: color var(--transition);
	}

	.book__contact a:hover,
	.book__contact a:focus-visible {
		color: var(--green-deep);
		text-decoration: underline;
	}

	.book__actions {
		display: grid;
		justify-items: start;
		gap: var(--space-md);
		margin-top: var(--space-sm);
	}

	.book__note {
		max-width: 44ch;
		color: var(--ink-muted);
		font-size: var(--type-small-size);
	}
</style>
