---
/**
 * Mobile bottom navigation (below 768px only).
 *
 * Five equal slots: Home, About, Courses, Pricing and a filled green Free
 * trial CTA. Every slot points at its real page and the active state comes
 * from the route. The CTA slot is the sticky "Book free trial" action: on Home
 * it scrolls to the inline free trial form, everywhere else it opens
 * /contact-us and carries the plan and course prefill query along.
 */
import { localizePath, stripLocalePrefix, useUi } from "../i18n";

const { locale, t } = useUi(Astro);

const { path } = stripLocalePrefix(Astro.url.pathname);
const currentPath = path.length > 1 ? path.replace(/\/+$/, "") : "/";
const isHome = currentPath === "/";

const isCurrent = (target: string) =>
	target === "/" ? currentPath === "/" : currentPath === target || currentPath.startsWith(`${target}/`);

// Keep the plan and course preselection when the visitor moves to the form.
const prefill = new URLSearchParams();
for (const key of ["plan", "course"]) {
	const value = Astro.url.searchParams.get(key);
	if (value) prefill.set(key, value);
}
const prefillQuery = prefill.toString();
const contactHref = isHome
	? "#book"
	: `${localizePath("/contact-us", locale)}${prefillQuery ? `?${prefillQuery}` : ""}#book`;

const items = [
	{ key: "home", label: t.nav.home, href: localizePath("/", locale), current: "/", cta: false },
	{ key: "about", label: t.nav.about, href: localizePath("/about", locale), current: "/about", cta: false },
	{ key: "courses", label: t.nav.courses, href: localizePath("/courses", locale), current: "/courses", cta: false },
	{ key: "pricing", label: t.nav.pricing, href: localizePath("/pricing", locale), current: "/pricing", cta: false },
	{
		key: "contact",
		label: t.nav.freeTrial,
		href: contactHref,
		// The CTA href carries a query and an anchor; match the route instead.
		current: "/contact-us",
		cta: true,
	},
];
---

<nav class="mobile-bar" data-mobile-bar aria-label={t.a11y.primaryNav}>
	{
		items.map((item) => (
			<a
				href={item.href}
				class:list={["mobile-bar__item", item.cta && "mobile-bar__item--cta"]}
				aria-current={isCurrent(item.current) ? "page" : undefined}
				aria-label={item.cta ? t.actions.bookFreeTrial : undefined}
			>
				<span class="mobile-bar__icon" aria-hidden="true">
					{item.key === "home" && (
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 10.5 12 4l8 6.5" />
							<path d="M6 9.5V20h12V9.5" />
							<path d="M10 20v-5h4v5" />
						</svg>
					)}
					{item.key === "about" && (
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="8" r="3.5" />
							<path d="M5.5 19c.7-3 3.1-4.75 6.5-4.75S17.8 16 18.5 19" />
						</svg>
					)}
					{item.key === "courses" && (
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 6.1c-1.9-1.55-4.25-2-7-1.9v13.6c2.75-.1 5.1.35 7 1.9 1.9-1.55 4.25-2 7-1.9V4.2c-2.75-.1-5.1.35-7 1.9z" />
							<path d="M12 6.1v13.6" />
						</svg>
					)}
					{item.key === "pricing" && (
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3.5 11.5v-6a2 2 0 0 1 2-2h6l9 9-8 8-9-9z" />
							<circle cx="8" cy="8" r="1.5" />
						</svg>
					)}
					{item.key === "contact" && (
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
							<path d="M3.5 9.5h17M8 3.5v3M16 3.5v3" />
							<path d="M12 12.5v5M9.5 15h5" />
						</svg>
					)}
				</span>
				<span class="mobile-bar__label">{item.label}</span>
			</a>
		))
	}
</nav>

<style>
	.mobile-bar {
		position: fixed;
		inset-inline: 0;
		bottom: 0;
		z-index: 30; /* below the Result modal (200) and the menu overlay (55-60). */
		display: none;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		align-items: stretch;
		background: var(--surface);
		border-top: 1px solid var(--line);
		box-shadow: 0 -8px 24px -16px rgba(11, 26, 20, 0.4);
		padding-bottom: env(safe-area-inset-bottom);
	}

	@media (max-width: 767px) {
		.mobile-bar {
			display: grid;
		}
	}

	.mobile-bar__item {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		min-width: 0;
		min-height: var(--mobile-bar-height);
		padding: 8px 2px 6px;
		color: var(--ink-muted);
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
		transition: color var(--dur-fast) var(--ease-out);
	}

	/* Small top indicator, visible only on the active item. */
	.mobile-bar__item::before {
		content: "";
		position: absolute;
		top: 0;
		left: 50%;
		width: 18px;
		height: 2px;
		border-radius: 999px;
		background: var(--green);
		opacity: 0;
		transform: translateX(-50%);
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	.mobile-bar__icon {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		flex: none;
		border-radius: 999px;
		color: var(--ink-muted);
		transition:
			background-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}

	.mobile-bar__label {
		max-width: 100%;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: 12px;
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.01em;
	}

	:global(html[lang="ar"]) .mobile-bar__label {
		font-size: 12px;
		letter-spacing: 0;
	}

	.mobile-bar__item:hover {
		color: var(--ink);
	}

	.mobile-bar__item:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: -3px;
		border-radius: var(--radius-input);
	}

	/* Active item: filled icon, green text, weight 700, top indicator. */
	.mobile-bar__item[aria-current="page"] {
		color: var(--green-deep);
	}

	.mobile-bar__item[aria-current="page"] .mobile-bar__label {
		font-weight: 700;
	}

	.mobile-bar__item[aria-current="page"] .mobile-bar__icon {
		background: var(--green);
		color: var(--on-accent);
	}

	.mobile-bar__item[aria-current="page"]::before {
		opacity: 1;
	}

	/* The fifth slot is the sticky Book free trial CTA: filled green so it
	 * reads as the primary action on every mobile page. */
	.mobile-bar__item--cta {
		color: var(--on-accent);
		background: var(--green);
	}

	.mobile-bar__item--cta .mobile-bar__icon {
		color: var(--on-accent);
	}

	.mobile-bar__item--cta .mobile-bar__label {
		font-weight: 700;
	}

	.mobile-bar__item--cta:hover,
	.mobile-bar__item--cta[aria-current="page"] {
		color: var(--on-accent);
		background: var(--green-deep);
	}

	.mobile-bar__item--cta[aria-current="page"] .mobile-bar__icon {
		background: transparent;
		color: var(--on-accent);
	}

	.mobile-bar__item--cta::before {
		background: var(--on-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-bar__item,
		.mobile-bar__icon,
		.mobile-bar__item::before {
			transition: none;
		}
	}
</style>
