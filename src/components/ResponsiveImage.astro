---
import { optimizedImages } from "../config/optimized-images";

interface Props {
	src: string;
	alt: string;
	width?: number;
	height?: number;
	sizes?: string;
	loading?: "eager" | "lazy";
	priority?: boolean;
	class?: string;
}

const {
	src,
	alt,
	width,
	height,
	sizes = "100vw",
	loading = "lazy",
	priority = false,
	class: className,
} = Astro.props;
const optimized = optimizedImages[src];
const fallbackVariant =
	optimized?.webp.find((variant) => variant.width >= 320) ??
	optimized?.webp.at(-1);
const webpSrcSet = optimized?.webp
	.map((variant) => `${variant.src} ${variant.width}w`)
	.join(", ");
const hasResponsiveAvif =
	optimized !== undefined && optimized.avif.length === optimized.webp.length;
const avifSrcSet = hasResponsiveAvif
	? optimized.avif.map((variant) => `${variant.src} ${variant.width}w`).join(", ")
	: undefined;
const imageWidth = width ?? optimized?.width ?? 800;
const imageHeight = height ?? optimized?.height ?? 500;
---

<picture>
	{avifSrcSet && <source type="image/avif" srcset={avifSrcSet} sizes={sizes} />}
	<img
		class={className}
		src={fallbackVariant?.src ?? src}
		srcset={webpSrcSet || undefined}
		sizes={sizes}
		alt={alt}
		width={imageWidth}
		height={imageHeight}
		loading={priority ? "eager" : loading}
		fetchpriority={priority ? "high" : undefined}
		decoding="async"
	/>
</picture>
