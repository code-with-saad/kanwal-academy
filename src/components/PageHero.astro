---
/**
 * Inner-page hero in the About design language: full-bleed mint panel,
 * faint geometric texture, Arabic brand watermark, arch-framed photograph
 * with orbit ring and stars, a badge pill and an organic wave into the
 * next section. The header floats over it (Base overlayHeader).
 */
import Chip from "./Chip.astro";
import Container from "./Container.astro";
import Eyebrow from "./Eyebrow.astro";
import ResponsiveImage from "./ResponsiveImage.astro";

interface Props {
	eyebrow?: string;
	headingBefore?: string;
	headingHighlight?: string;
	headingAfter?: string;
	/** Plain heading, used when no highlighted word is set. */
	heading?: string;
	lead?: string;
	imageSrc: string;
	imageAlt: string;
	badge?: string;
	chips?: string[];
}

const {
	eyebrow,
	headingBefore = "",
	headingHighlight = "",
	headingAfter = "",
	heading = "",
	lead,
	imageSrc,
	imageAlt,
	badge,
	chips = [],
} = Astro.props;
---

<section class="page-hero" aria-labelledby="page-hero-title">
	<svg class="page-hero__texture" aria-hidden="true" focusable="false">
		<defs>
			<pattern id="page-hero-pattern" width="72" height="72" patternUnits="userSpaceOnUse">
				<path d="M36 8L44 28L64 36L44 44L36 64L28 44L8 36L28 28Z" fill="none" stroke="currentColor" stroke-width="1" />
			</pattern>
		</defs>
		<rect width="100%" height="100%" fill="url(#page-hero-pattern)" />
	</svg>
	<span class="page-hero__watermark arabic" lang="ar" dir="rtl" aria-hidden="true">كنول</span>
	<Container>
		<div class="page-hero__grid">
			<div class="page-hero__copy">
				{eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
				<h1 id="page-hero-title">
					{headingHighlight ? (
						<>{headingBefore}<span class="heading-highlight page-hero__highlight">{headingHighlight}<svg class="page-hero__underline" viewBox="0 0 220 14" preserveAspectRatio="none" aria-hidden="true"><path d="M4 10C60 3 150 3 216 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg></span>{headingAfter}</>
					) : (
						heading
					)}
				</h1>
				{lead && <p class="page-hero__lead">{lead}</p>}
				{chips.length > 0 && (
					<div class="page-hero__badges">
						{chips.map((chip) => <Chip>{chip}</Chip>)}
					</div>
				)}
			</div>

			<div class="page-hero__media">
				<svg class="page-hero__orbit" viewBox="0 0 400 520" aria-hidden="true" focusable="false">
					<circle cx="200" cy="260" r="248" fill="none" stroke="var(--green-deep)" stroke-width="1" stroke-dasharray="2 10" opacity="0.35" />
				</svg>
				<span class="page-hero__arch-back" aria-hidden="true"></span>
				<div class="page-hero__arch">
					<ResponsiveImage
						src={imageSrc}
						alt={imageAlt}
						sizes="(max-width: 900px) 82vw, 380px"
						priority
						class="page-hero__image"
					/>
				</div>
				<span class="page-hero__star page-hero__star--a" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" /></svg>
				</span>
				<span class="page-hero__star page-hero__star--b" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" /></svg>
				</span>
				{badge && (
					<p class="page-hero__badge">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
							<path d="M12 4l2.2 5.8L20 12l-5.8 2.2L12 20l-2.2-5.8L4 12l5.8-2.2z" />
						</svg>
						{badge}
					</p>
				)}
			</div>
		</div>
	</Container>
	<svg class="page-hero__wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
		<path d="M0 38C220 82 470 0 720 28C970 56 1210 6 1440 42" fill="none" stroke="var(--mint-100)" stroke-width="2" opacity="0.8" />
		<path d="M0 90V44C220 88 470 6 720 34C970 62 1210 12 1440 48V90Z" fill="var(--page)" />
	</svg>
</section>

<style>
	/* Same rhythm as the About hero, a touch shorter than full viewport. */
	.page-hero {
		position: relative;
		overflow: clip;
		display: grid;
		align-items: center;
		min-height: clamp(540px, 88svh, 880px);
		padding-top: calc(var(--header-height) + 12px + 24px);
		padding-bottom: calc(clamp(48px, 7vw, 88px) + 40px);
		background: var(--mint-300);
	}

	.page-hero__texture {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		color: var(--ink);
		opacity: 0.06;
		pointer-events: none;
	}

	/* Oversized Arabic brand word, flat ink at 5%: depth without gradients. */
	.page-hero__watermark {
		position: absolute;
		top: 6%;
		inset-inline-start: -2%;
		color: color-mix(in srgb, var(--ink) 5%, transparent);
		font-size: clamp(140px, 22vw, 320px);
		line-height: 1;
		pointer-events: none;
		user-select: none;
	}

	.page-hero__grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		align-items: center;
		gap: clamp(32px, 6vw, 80px);
	}

	.page-hero__copy {
		display: grid;
		justify-items: start;
		gap: var(--space-md);
	}

	.page-hero__copy h1 {
		max-width: 18ch;
		font-size: clamp(2.5rem, 5.6vw, 4rem);
		line-height: 1.08;
	}

	.page-hero__highlight {
		position: relative;
		white-space: nowrap;
	}

	/* Hand-drawn curve under the highlighted words. */
	.page-hero__underline {
		position: absolute;
		inset-inline: 0;
		bottom: -0.18em;
		width: 100%;
		height: 0.22em;
		color: var(--green-deep);
		opacity: 0.35;
	}

	.page-hero__lead {
		max-width: 40ch;
		color: var(--type-copy-color);
		font-size: var(--type-lead-size);
		line-height: var(--type-lead-line);
	}

	.page-hero__badges {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-sm);
	}

	.page-hero__media {
		position: relative;
		justify-self: center;
		width: min(100%, clamp(280px, 26vw, 380px));
	}

	.page-hero__orbit {
		position: absolute;
		top: -14%;
		inset-inline-start: -16%;
		width: 132%;
		height: 128%;
		pointer-events: none;
	}

	/* Offset flat arch behind the photograph: depth without gradients. */
	.page-hero__arch-back {
		position: absolute;
		inset: 0;
		translate: 18px 18px;
		border-radius: 999px 999px 24px 24px;
		background: var(--mint-100);
	}

	.page-hero__arch {
		position: relative;
		overflow: clip;
		aspect-ratio: 3 / 4;
		border-radius: 999px 999px 24px 24px;
		background: var(--surface);
		box-shadow: 0 18px 44px -22px rgba(11, 26, 20, 0.35);
	}

	/* ResponsiveImage renders a picture wrapper: stretch it and the img so
	   landscape photography still fills the 3/4 arch. */
	.page-hero__arch :global(picture) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.page-hero__arch :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.page-hero__star {
		position: absolute;
		color: var(--green-deep);
		opacity: 0.5;
	}

	.page-hero__star svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.page-hero__star--a {
		top: -14px;
		inset-inline-end: -10px;
		width: 26px;
		height: 26px;
	}

	.page-hero__star--b {
		bottom: 22%;
		inset-inline-start: -34px;
		width: 18px;
		height: 18px;
	}

	.page-hero__badge {
		position: absolute;
		inset-inline-start: -24px;
		bottom: 24px;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		padding: 10px 16px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
		box-shadow: 0 12px 32px -16px rgba(11, 26, 20, 0.25);
		color: var(--green-deep);
		font-size: var(--type-small-size);
		font-weight: 600;
	}

	.page-hero__badge svg {
		width: 18px;
		height: 18px;
	}

	/* Organic curve into the next section instead of a straight edge. */
	.page-hero__wave {
		position: absolute;
		inset-inline: 0;
		bottom: -1px;
		width: 100%;
		height: clamp(48px, 7vw, 88px);
		pointer-events: none;
	}

	@media (max-width: 900px) {
		.page-hero {
			min-height: auto;
			padding-top: calc(var(--header-height) + 12px + 16px);
		}

		.page-hero__grid {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}

		.page-hero__media {
			width: min(100%, 300px);
		}

		.page-hero__arch-back {
			translate: 12px 12px;
		}

		.page-hero__badge {
			inset-inline-start: 0;
		}

		.page-hero__star--b {
			inset-inline-start: -16px;
		}

		.page-hero__watermark {
			top: auto;
			bottom: 10%;
			font-size: 46vw;
		}
	}

	/* Mirror the offset arch in RTL (translate is physical). */
	:global([dir="rtl"]) .page-hero__arch-back {
		translate: -18px 18px;
	}

	@media (max-width: 900px) {
		:global([dir="rtl"]) .page-hero__arch-back {
			translate: -12px 12px;
		}
	}
</style>