---
import type { SocialLink } from "../utils/site-config";

interface Props {
	links: SocialLink[];
}

const { links } = Astro.props;

type Platform =
	| "instagram"
	| "facebook"
	| "youtube"
	| "tiktok"
	| "whatsapp"
	| "x"
	| "linkedin"
	| "telegram"
	| "snapchat"
	| "pinterest"
	| "twitch"
	| "unknown";

function detectPlatform(url: string): Platform {
	try {
		const parsed = new URL(url);
		const host = parsed.hostname.toLowerCase().replace(/^www\./, "");

		if (host.includes("instagram.com")) return "instagram";
		if (host.includes("facebook.com") || host.includes("fb.com")) return "facebook";
		if (host.includes("youtube.com") || host.includes("youtu.be")) return "youtube";
		if (host.includes("tiktok.com")) return "tiktok";
		if (host.includes("wa.me") || host.includes("whatsapp.com")) return "whatsapp";
		if (host.includes("twitter.com") || host.includes("x.com")) return "x";
		if (host.includes("linkedin.com")) return "linkedin";
		if (host.includes("t.me") || host.includes("telegram.org")) return "telegram";
		if (host.includes("snapchat.com")) return "snapchat";
		if (host.includes("pinterest.com")) return "pinterest";
		if (host.includes("twitch.tv")) return "twitch";
		return "unknown";
	} catch {
		return "unknown";
	}
}

/**
 * Build the aria-label for the link.
 * The admin always types a platform name in the social_links repeater,
 * and `normalize()` filters out empty labels, so we use it as-is.
 * The platform enum is kept here for the icon switch below.
 */
function platformLabel(label: string): string {
	return label.trim();
}
---

{links.length > 0 && (
	<div class="social-links" aria-label="Social media links">
		{links.map((link) => {
			const platform = detectPlatform(link.url);
			const label = platformLabel(link.label);

			return (
				<a
					href={link.url}
					class="social-link"
					target="_blank"
					rel="noopener noreferrer"
					aria-label={label}
				>
					<span class="social-link__icon" aria-hidden="true">
						{platform === "instagram" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="3" width="18" height="18" rx="5" />
								<circle cx="12" cy="12" r="4" />
								<circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
							</svg>
						)}
						{platform === "facebook" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
							</svg>
						)}
						{platform === "youtube" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<rect x="2" y="5" width="20" height="14" rx="3" />
								<path d="M10 9l5 3-5 3z" fill="currentColor" />
							</svg>
						)}
						{platform === "tiktok" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" />
							</svg>
						)}
						{platform === "whatsapp" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
							</svg>
						)}
						{platform === "x" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 4l16 16M4 20L20 4" />
							</svg>
						)}
						{platform === "linkedin" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="3" width="18" height="18" rx="3" />
								<circle cx="7.5" cy="7.5" r="1" fill="currentColor" stroke="none" />
								<path d="M8 11v6M12 17v-4a2 2 0 0 1 4 0v4" />
							</svg>
						)}
						{platform === "telegram" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
							</svg>
						)}
						{platform === "snapchat" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 2C8 2 6 5 6 9c0 2-1 3-2 4h4l1 2c-1 1-3 2-3 3s2 1 6 1 6 0 6-1-2-2-3-3l1-2h4c-1-1-2-2-2-4 0-4-2-7-6-7z" />
							</svg>
						)}
						{platform === "pinterest" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="9" />
								<path d="M8 14s1-1 2-1 2 1 3 1 2-1 3-1M12 9v4" />
							</svg>
						)}
						{platform === "twitch" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 2H3v16h5v4l4-4h5l4-4V2zM10 11V7M16 11V7" />
							</svg>
						)}
						{platform === "unknown" && (
							<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="9" />
								<ellipse cx="12" cy="12" rx="4" ry="9" />
								<path d="M3 12h18" />
							</svg>
						)}
					</span>
				</a>
			);
		})}
	</div>
)}

<style>
	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-md);
	}

	/* The link is 44px square with a circular clip via border-radius.
	 * border-radius also narrows the hit area in modern browsers, so the
	 * hover flicker at the corners is avoided. No translate on hover —
	 * that would move the bounding box and re-trigger the flicker loop. */
	.social-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: transparent;
		color: var(--ink-muted);
		border: 1px solid rgba(11, 26, 20, 0.2);
		transition:
			background-color var(--transition),
			color var(--transition),
			border-color var(--transition);
		/* The icon scales instead of the whole link, so the hitbox is
		 * stable and cannot flicker. */
		overflow: hidden;
	}

	.social-link:hover,
	.social-link:focus-visible {
		background: var(--green);
		color: var(--on-accent);
		border-color: var(--green);
	}

	:global(html[data-theme="dark"]) .social-link {
		border-color: var(--line);
	}

	:global(html[data-theme="dark"]) .social-link:hover,
	:global(html[data-theme="dark"]) .social-link:focus-visible {
		background: var(--green);
		color: var(--on-accent);
		border-color: var(--green);
	}

	.social-link:focus-visible {
		outline: 2px solid var(--green);
		outline-offset: 2px;
	}

	.social-link__icon {
		display: grid;
		place-items: center;
		transition: transform var(--transition);
	}

	/* Subtle icon scale on hover — this does NOT move the link hitbox. */
	.social-link:hover .social-link__icon,
	.social-link:focus-visible .social-link__icon {
		transform: scale(1.08);
	}

	@media (max-width: 760px) {
		.social-link {
			width: 40px;
			height: 40px;
		}

		.social-links {
			gap: 10px;
		}
	}
</style>
