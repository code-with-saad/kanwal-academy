---
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";
import { Image } from "emdash/ui";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import type { ImageValue } from "emdash";
import { useUi } from "../i18n";

const { t } = useUi(Astro);


interface Props {
	eyebrow?: string;
	titleBefore?: string;
	titleHighlight?: string;
	titleAfter?: string;
	badgeLabel?: string;
	paragraph1?: string;
	paragraph2?: string;
	imageSrc?: string;
	imageAlt?: string;
	image?: ImageValue | null;
	years?: string;
}

const {
	eyebrow = t.home.about_eyebrow,
	titleBefore = t.home.about_title_before,
	titleHighlight = t.home.about_title_highlight,
	titleAfter = t.home.about_title_after,
	badgeLabel = t.home.about_badge_label,
	paragraph1 = t.home.about_paragraph_1,
	paragraph2 = "",
	imageSrc = "/images/wisdom.jpg",
	imageAlt = t.home.about_image_alt,
	image,
	years = "5+",
} = Astro.props;

// Split "5+" into a number and a suffix so the counter can animate it.
const yearCount = years.replace(/[^\d.]/g, "") || "5";
const yearSuffix = years.replace(/[\d.]/g, "") || "+";
---

<div class="wisdom">
	<div class="wisdom__media">
		<span class="wisdom__block" aria-hidden="true"></span>
		<div class="wisdom__frame" data-reveal="image">
			{image ? (
				<Image
					image={image}
					alt={image.alt || imageAlt}
					class="wisdom__image"
				/>
			) : (
				<ImagePlaceholder
					src={imageSrc}
					alt={imageAlt}
					label={t.images.wisdomPlaceholder}
					ratio="4 / 5"
					class="wisdom__image"
				/>
			)}
		</div>
		<p class="wisdom__badge" data-reveal="up" data-reveal-delay="200">
			<span class="wisdom__badge-value">
				<span data-count-to={yearCount} data-count-suffix={yearSuffix}>{years}</span> years
			</span>
			<span class="wisdom__badge-label">{badgeLabel}</span>
		</p>
	</div>

	<div class="wisdom__copy">
		<span data-reveal="up">
			<Eyebrow>{eyebrow}</Eyebrow>
		</span>
		<h2 class="wisdom__title" data-reveal-words>
			{titleBefore} <span class="heading-highlight">{titleHighlight}</span> {titleAfter}
		</h2>
		<p data-reveal="up" data-reveal-delay="80">
			{paragraph1}
		</p>
		{paragraph2 && (
			<p data-reveal="up" data-reveal-delay="160">
				{paragraph2}
			</p>
		)}
		<div class="wisdom__actions" data-reveal="up" data-reveal-delay="240">
			<Button book variant="primary">{t.actions.bookFreeTrial}</Button>
		</div>
	</div>
</div>

<style>
	.wisdom {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		align-items: center;
		gap: clamp(32px, 6vw, 96px);
	}

	.wisdom__media {
		position: relative;
		padding-block-end: 20px;
		padding-inline-end: 20px;
	}

	/* Flat mint block, offset behind the frame. */
	.wisdom__block {
		position: absolute;
		inset-inline-end: 0;
		bottom: 0;
		width: calc(100% - 20px);
		height: calc(100% - 20px);
		border-radius: var(--radius-panel);
		background: var(--mint-300);
	}

	.wisdom__frame {
		position: relative;
		overflow: clip;
		border-radius: var(--radius-panel);
		background: var(--mint-50);
	}

	.wisdom__frame :global(.wisdom__image),
	.wisdom__frame :global(.wisdom__image .img-ph__img),
	.wisdom__frame :global(.wisdom__image .img-ph__box) {
		border-radius: var(--radius-panel);
	}

	.wisdom__badge {
		position: absolute;
		inset-inline-start: 20px;
		bottom: 44px;
		display: grid;
		gap: 2px;
		padding: 12px 18px;
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--surface);
		box-shadow: 0 12px 32px -18px rgba(11, 26, 20, 0.32);
	}

	.wisdom__badge-value {
		color: var(--ink);
		font-size: var(--type-h3-size);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.01em;
	}

	.wisdom__badge-label {
		color: var(--ink-muted);
		font-size: var(--type-small-size);
		line-height: 1.2;
	}

	.wisdom__copy {
		display: grid;
		justify-items: start;
		gap: var(--space-md);
	}

	.wisdom__title {
		max-width: 18ch;
	}

	.wisdom__copy p {
		max-width: 50ch;
		color: var(--ink-muted);
	}

	.wisdom__actions {
		margin-top: var(--space-sm);
	}

	@media (max-width: 900px) {
		.wisdom {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}

		.wisdom__media {
			width: min(100%, 440px);
		}
	}

	@media (max-width: 560px) {
		.wisdom__media {
			width: 100%;
			padding-block-end: 14px;
			padding-inline-end: 14px;
		}

		.wisdom__block {
			width: calc(100% - 14px);
			height: calc(100% - 14px);
		}

		.wisdom__badge {
			inset-inline-start: 14px;
			bottom: 30px;
			padding: 10px 14px;
		}

		.wisdom__badge-value {
			font-size: var(--type-h3-size);
		}
	}
</style>
