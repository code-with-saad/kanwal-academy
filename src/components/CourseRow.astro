---
interface Props {
	index: number;
	title: string;
	summary?: string;
	level?: string;
	href: string;
}

const { index, title, summary, level, href } = Astro.props;
const number = String(index).padStart(2, "0");
---

<li class="course-row">
	<a class="course-row__link" {href}>
		<span class="course-row__index" aria-hidden="true">{number}</span>
		<span class="course-row__body">
			<span class="course-row__title">{title}</span>
			{level && <span class="course-row__level">{level}</span>}
			{summary && <span class="course-row__summary">{summary}</span>}
		</span>
		<svg
			class="course-row__arrow"
			viewBox="0 0 20 20"
			width="20"
			height="20"
			aria-hidden="true"
			focusable="false"
		>
			<path
				d="M3.5 10h12M11 5.5l4.5 4.5-4.5 4.5"
				fill="none"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
	</a>
</li>

<style>
	.course-row {
		border-top: 1px solid var(--line);
	}

	.course-row:last-child {
		border-bottom: 1px solid var(--line);
	}

	.course-row__link {
		display: grid;
		grid-template-columns: 44px minmax(0, 1fr) 20px;
		align-items: start;
		gap: var(--space-md);
		padding-block: var(--space-lg);
		color: var(--text);
		text-decoration: none;
		transition: background-color var(--transition);
	}

	.course-row__link:hover {
		background: color-mix(in srgb, var(--line) 28%, transparent);
	}

	.course-row__index {
		color: var(--muted);
		font-size: 0.875rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		line-height: 1.6;
	}

	.course-row__body {
		display: grid;
		gap: 4px;
	}

	.course-row__title {
		font-family: var(--font-heading, Georgia, serif);
		font-size: clamp(1.25rem, 2vw, 1.5rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.01em;
		transition: color var(--transition);
	}

	.course-row__link:hover .course-row__title {
		color: var(--accent);
	}

	.course-row__level {
		color: var(--accent);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.course-row__summary {
		max-width: 56ch;
		color: var(--muted);
		font-size: var(--size-small);
		line-height: 1.55;
	}

	.course-row__arrow {
		margin-top: 6px;
		color: var(--muted);
		transition:
			color var(--transition),
			transform var(--transition);
	}

	.course-row__link:hover .course-row__arrow {
		color: var(--accent);
		transform: translateX(3px);
	}

	@media (max-width: 520px) {
		.course-row__link {
			grid-template-columns: 32px minmax(0, 1fr) 18px;
			gap: var(--space-sm);
		}
	}
</style>
