---
import Chip from "./Chip.astro";

interface Props {
	index: number;
	title: string;
	summary?: string;
	level?: string;
	href: string;
	/** Arabic course name, shown at the end of the row. */
	arabic?: string;
}

const { index, title, summary, level, href, arabic } = Astro.props;
const number = String(index).padStart(2, "0");
---

<li class="course-row" data-reveal="up" data-reveal-delay={index * 80}>
	<a class:list={["course-row__link", "lift", arabic && "course-row__link--arabic"]} {href}>
		<span class="course-row__index" aria-hidden="true">{number}</span>
		<span class="course-row__body">
			<span class="course-row__head">
				<span class="course-row__title">{title}</span>
				{level && <Chip class="course-row__level">{level}</Chip>}
			</span>
			{summary && <span class="course-row__summary">{summary}</span>}
		</span>
		{
			arabic && (
				<span class="course-row__arabic" lang="ar" dir="rtl">
					{arabic}
				</span>
			)
		}
		<svg
			class="course-row__arrow"
			viewBox="0 0 20 20"
			width="20"
			height="20"
			aria-hidden="true"
			focusable="false"
		>
			<path
				d="M3.5 10h12M11 5.5l4.5 4.5-4.5 4.5"
				fill="none"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
	</a>
</li>

<style>
	.course-row {
		border-top: 1px solid var(--line);
	}

	.course-row:last-child {
		border-bottom: 1px solid var(--line);
	}

	.course-row__link {
		display: grid;
		grid-template-columns: 44px minmax(0, 1fr) 20px;
		align-items: center;
		gap: var(--space-md);
		padding: var(--space-lg) var(--space-md);
		border-radius: var(--radius-card);
		color: var(--ink);
		text-decoration: none;
		transition:
			background-color var(--transition),
			color var(--transition),
			transform var(--dur-base) var(--ease);
	}

	.course-row__link--arabic {
		grid-template-columns: 44px minmax(0, 1fr) auto 20px;
	}

	.course-row__link:hover,
	.course-row__link:focus-visible {
		background: var(--green);
		color: var(--on-accent);
	}

	.course-row__index {
		align-self: start;
		margin-top: 4px;
		color: var(--ink-muted);
		font-size: var(--size-small);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		line-height: 1.4;
		transition: color var(--transition);
	}

	.course-row__body {
		display: grid;
		gap: 6px;
	}

	.course-row__head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm);
	}

	.course-row__title {
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 2vw, 1.5rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.course-row__link :global(.course-row__level) {
		height: 28px;
		padding: 0 12px;
		color: var(--ink-muted);
		font-size: 0.75rem;
	}

	.course-row__summary {
		max-width: 56ch;
		color: var(--ink-muted);
		font-size: var(--size-small);
		line-height: 1.55;
		transition: color var(--transition);
	}

	.course-row__arabic {
		color: var(--green-deep);
		font-family: var(--font-arabic, "Amiri", serif);
		font-size: clamp(1.375rem, 2vw, 1.75rem);
		line-height: 1.4;
		transition: color var(--transition);
	}

	.course-row__arrow {
		color: var(--ink-muted);
		transition:
			color var(--transition),
			transform var(--transition);
	}

	.course-row__link:hover .course-row__index,
	.course-row__link:hover .course-row__summary,
	.course-row__link:hover .course-row__arabic,
	.course-row__link:hover .course-row__arrow,
	.course-row__link:focus-visible .course-row__index,
	.course-row__link:focus-visible .course-row__summary,
	.course-row__link:focus-visible .course-row__arabic,
	.course-row__link:focus-visible .course-row__arrow {
		color: var(--on-accent);
	}

	.course-row__link:hover :global(.course-row__level),
	.course-row__link:focus-visible :global(.course-row__level) {
		border-color: color-mix(in srgb, var(--on-accent) 60%, transparent);
		color: var(--on-accent);
	}

	.course-row__link:hover .course-row__arrow,
	.course-row__link:focus-visible .course-row__arrow {
		transform: translateX(3px);
	}

	@media (max-width: 620px) {
		.course-row__link {
			grid-template-columns: 26px minmax(0, 1fr) 18px;
			gap: var(--space-sm);
			padding: var(--space-md) var(--space-sm);
		}

		.course-row__link--arabic {
			grid-template-columns: 26px minmax(0, 1fr) auto 18px;
		}

		.course-row__arabic {
			font-size: 1.125rem;
		}

		.course-row__link :global(.course-row__level) {
			height: 26px;
			padding: 0 10px;
			font-size: 0.6875rem;
		}
	}
</style>
