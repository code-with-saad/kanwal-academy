---
import type { ContentEntry } from "emdash";
import type { Teacher } from "../../emdash-env";
import { Image } from "emdash/ui";
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface Props {
	teachers: ContentEntry<Teacher>[];
	demo?: boolean;
}

const { teachers, demo = false } = Astro.props;

const shown = teachers.slice(0, 6).map((teacher) => ({
	id: teacher.id,
	name: teacher.data.name,
	role: teacher.data.role,
	photo: teacher.data.photo,
}));

const demoCards =
	demo && shown.length === 0
		? [1, 2, 3].map((index) => ({
				id: `demo-teacher-${index}`,
				name: `Teacher profile ${index}`,
				role: "Placeholder profile",
				photo: undefined,
			}))
		: [];

const cards = shown.length > 0 ? shown : demoCards;
---

<ul class="teacher-grid">
	{
		cards.map((card, index) => (
			<li
				class="teacher-card lift"
				data-reveal="up"
				data-reveal-delay={index * 80}
			>
				<div class="teacher-card__photo" data-reveal="image">
					{card.photo ? (
						<Image image={card.photo} alt={card.photo.alt || card.name} />
					) : (
						<ImagePlaceholder label="Teacher photo placeholder" ratio="4 / 5" />
					)}
				</div>
				<div class="teacher-card__meta">
					<h3 class="teacher-card__name">{card.name}</h3>
					<p class="teacher-card__role">{card.role}</p>
					{demo && shown.length === 0 && (
						<span class="teacher-card__flag">Demo placeholder</span>
					)}
				</div>
			</li>
		))
	}
</ul>

<style>
	.teacher-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-lg);
	}

	.teacher-card {
		display: grid;
		align-content: start;
		gap: var(--space-md);
	}

	.teacher-card__photo {
		overflow: clip;
		aspect-ratio: 4 / 5;
		border-radius: var(--radius-card);
		background: var(--mint-50);
	}

	.teacher-card__photo :global(.img-ph) {
		border-radius: var(--radius-card);
	}

	.teacher-card__photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.teacher-card__meta {
		display: grid;
		gap: 2px;
	}

	.teacher-card__name {
		font-size: var(--type-h3-size);
		font-weight: 500;
	}

	.teacher-card__role {
		color: var(--ink-muted);
		font-size: var(--type-small-size);
	}

	.teacher-card__flag {
		justify-self: start;
		margin-top: 6px;
		padding: 4px 10px;
		border: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent);
		border-radius: var(--radius-chip);
		color: var(--ink-muted);
		font-size: var(--type-eyebrow-size);
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	@media (max-width: 900px) {
		.teacher-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.teacher-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
