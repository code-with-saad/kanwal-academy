---
import type { FieldAnnotation } from "emdash";
import NumberText from "./NumberText.astro";

interface Props {
	number: number;
	title: string;
	body: string;
	titleEdit?: Partial<FieldAnnotation>;
	bodyEdit?: Partial<FieldAnnotation>;
}

const { number, title, body, titleEdit, bodyEdit } = Astro.props;
const label = String(number).padStart(2, "0");
---

<li class="step" data-reveal="up">
	<span class="step__number" aria-hidden="true"><NumberText text={label} /></span>
	<h3 class="step__title" {...titleEdit}>{title}</h3>
	<p class="step__body" {...bodyEdit}>{body}</p>
</li>

<style>
	.step {
		position: relative;
		padding-top: var(--space-lg);
	}

	/* Top rule draws from left to right when the step is revealed. */
	.step::before {
		content: "";
		position: absolute;
		inset-inline: 0;
		top: 0;
		height: 1px;
		background: var(--line);
		transform-origin: left center;
	}

	:global(.js-motion) .step::before {
		transform: scaleX(0);
		transition: transform var(--dur-slow) var(--ease) 120ms;
	}

	:global(.js-motion) .step.is-revealed::before {
		transform: scaleX(1);
	}

	.step__number {
		display: block;
		color: var(--accent);
		font-size: var(--type-small-size);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.step__title {
		margin-top: var(--space-md);
		font-size: var(--type-h3-size);
	}

	.step__body {
		max-width: 40ch;
		margin-top: var(--space-sm);
		color: var(--ink-muted);
		font-size: var(--type-small-size);
		line-height: 1.6;
	}
</style>
