---
import Button from "./Button.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site, type NavItem } from "../config/site";

interface Props {
	items?: NavItem[];
	cta?: NavItem;
	tone?: "dark" | "light";
	currentPath?: string;
	siteName?: string;
}

const {
	items = [...site.nav],
	cta = site.cta,
	tone = "light",
	currentPath = Astro.url.pathname,
	siteName = site.name,
} = Astro.props;

const path = currentPath.length > 1 ? currentPath.replace(/\/+$/, "") : "/";
const isLinkCurrent = (item: NavItem) =>
	item.href.startsWith("#") ? false : item.href === "/" ? path === "/" : path === item.href;

const isHome = tone === "dark";
---

<header
	class:list={["site-header", isHome && "site-header--home"]}
	data-header
>
	<div class="header__inner">
		<a href="/" class="header__brand" aria-label={`${siteName}, home`}>
			<img
				class="header__mark header__mark--on-light"
				src="/images/kanwal-mark-on-light.png"
				alt=""
				width="592"
				height="688"
			/>
			<img
				class="header__mark header__mark--on-dark"
				src="/images/kanwal-mark-on-dark.png"
				alt=""
				width="592"
				height="688"
			/>
			<span class="header__name">{siteName}</span>
		</a>

		<nav class="header__nav" aria-label="Primary">
			{
				items.map((item) => (
					<a
						href={item.href}
						class="header__link"
						data-nav-link
						data-nav-anchor={item.anchor}
						aria-current={isLinkCurrent(item) ? "page" : undefined}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="header__end">
			<ThemeToggle />
			<div class="header__cta-wrap">
				<Button href={cta.href} variant="primary">
					{cta.label}
				</Button>
			</div>

			<button
				type="button"
				class="header__toggle"
				data-menu-toggle
				aria-expanded="false"
				aria-controls="site-menu"
				aria-label="Open menu"
			>
				<span class="header__toggle-icon" aria-hidden="true">
					<span></span>
					<span></span>
				</span>
			</button>
		</div>
	</div>

	<div class="header__panel" id="site-menu" data-menu-panel>
		<button
			type="button"
			class="header__close"
			data-menu-close
			aria-label="Close menu"
		>
			<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
				<path
					d="m6 6 12 12M18 6 6 18"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
				/>
			</svg>
		</button>
		<nav class="header__panel-nav" aria-label="Primary">
			{
				items.map((item) => (
					<a
						href={item.href}
						class="header__mobile-link"
						data-nav-link
						data-nav-anchor={item.anchor}
						aria-current={isLinkCurrent(item) ? "page" : undefined}
					>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="header__panel-end">
			<ThemeToggle />
			<Button href={cta.href} variant="primary">
				{cta.label}
			</Button>
		</div>
	</div>
	<div class="header__scrim" data-menu-scrim hidden></div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]");
	const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
	const scrim = document.querySelector<HTMLElement>("[data-menu-scrim]");
	const header = document.querySelector<HTMLElement>("[data-header]");

	if (toggle && panel) {
		const setOpen = (open: boolean) => {
			panel.classList.toggle("is-open", open);
			scrim?.toggleAttribute("hidden", !open);
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			document.body.toggleAttribute("data-menu-open", open);
		};

		const close = () => setOpen(false);

		toggle.addEventListener("click", () => {
			setOpen(toggle.getAttribute("aria-expanded") !== "true");
		});

		closeButton?.addEventListener("click", close);
		scrim?.addEventListener("click", close);

		panel.addEventListener("click", (event) => {
			if (event.target instanceof Element && event.target.closest("a")) close();
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && panel.classList.contains("is-open")) {
				close();
				toggle.focus();
			}
		});

		const desktop = window.matchMedia("(min-width: 1024px)");
		desktop.addEventListener("change", (event) => {
			if (event.matches) close();
		});
	}

	if (header) {
		const onScroll = () => {
			header.classList.toggle("is-scrolled", window.scrollY > 8);
		};
		window.addEventListener("scroll", onScroll, { passive: true });
		onScroll();
		document.addEventListener("astro:after-swap", onScroll);
	}
</script>

<script>
	// In-page navigation: smooth scroll, hash without a jump, and an active
	// link that follows the section in view. Reduced motion means instant.
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
	const navLinks = Array.from(
		document.querySelectorAll<HTMLAnchorElement>("[data-nav-link][data-nav-anchor]"),
	);
	const header = document.querySelector<HTMLElement>("[data-header]");
	const headerHeight = () => header?.offsetHeight ?? 0;

	const targetFrom = (href: string) => {
		const url = new URL(href, window.location.href);
		if (url.pathname !== window.location.pathname || !url.hash) return null;
		return document.getElementById(decodeURIComponent(url.hash.slice(1)));
	};

	for (const link of document.querySelectorAll<HTMLAnchorElement>("a[href*='#']")) {
		const target = targetFrom(link.href);
		if (!target) continue;
		link.addEventListener("click", (event) => {
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			event.preventDefault();
			target.scrollIntoView({
				behavior: reduceMotion.matches ? "auto" : "smooth",
				block: "start",
			});
			const url = new URL(link.href);
			history.pushState(null, "", `${url.pathname}${url.search}${url.hash}`);
			// Keep keyboard focus with the visitor, without a second jump.
			if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
			target.focus({ preventScroll: true });
		});
	}

	if (navLinks.length > 0) {
		const sections = navLinks
			.map((link) => document.getElementById(link.dataset.navAnchor ?? ""))
			.filter((section): section is HTMLElement => section !== null);

		const setActive = (id: string) => {
			for (const link of navLinks) {
				const active = link.dataset.navAnchor === id;
				if (active) link.setAttribute("aria-current", "location");
				else if (link.getAttribute("aria-current") === "location") {
					link.removeAttribute("aria-current");
				}
			}
		};

		if (sections.length > 0 && "IntersectionObserver" in window) {
			const visible = new Set<string>();
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) visible.add(entry.target.id);
						else visible.delete(entry.target.id);
					}
					const first = sections.find((section) => visible.has(section.id));
					if (first) setActive(first.id);
				},
				{
					rootMargin: `-${headerHeight() + 1}px 0px -55% 0px`,
					threshold: 0,
				},
			);
			for (const section of sections) observer.observe(section);
		}
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--page);
		border-bottom: 1px solid var(--line);
		transition:
			top 220ms var(--ease-out),
			background-color 220ms var(--ease-out),
			border-color 220ms var(--ease-out),
			margin 220ms var(--ease-out),
			border-radius 220ms var(--ease-out),
			box-shadow 220ms var(--ease-out);
	}

	.site-header--home {
		background: transparent;
		border-bottom-color: transparent;
	}

	/* Sticky pill, 12px from the viewport top, narrower than the sheet. */
	.site-header.is-scrolled {
		top: 12px;
		background: var(--page);
		border: 1px solid var(--line);
		border-radius: var(--radius-panel);
		margin-inline: 16px;
		box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 4%, transparent);
	}

	.site-header.is-scrolled.site-header--home {
		background: var(--page);
		border-color: var(--line);
	}

	.header__inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: var(--space-lg);
		width: 100%;
		max-width: calc(var(--container) + var(--gutter) * 2);
		margin-inline: auto;
		padding-inline: var(--gutter);
		min-height: var(--header-height);
	}

	/* Brand */
	.header__brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--ink);
		text-decoration: none;
	}

	.header__mark {
		display: block;
		height: 44px;
		width: auto;
		object-fit: contain;
	}

	.header__mark--on-dark {
		display: none;
	}

	:global(html[data-theme="dark"]) .header__mark--on-light {
		display: none;
	}

	:global(html[data-theme="dark"]) .header__mark--on-dark {
		display: block;
	}

	/* On Home the mint panel sits behind the header; pick the mark that
	   reads against the mint surface rather than the page surface. */
	:global(body[data-is-home]) .header__mark--on-light {
		display: block;
	}

	:global(body[data-is-home]) .header__mark--on-dark {
		display: none;
	}

	:global(body[data-is-home][data-theme="dark"]) .header__mark--on-light {
		display: none;
	}

	:global(body[data-is-home][data-theme="dark"]) .header__mark--on-dark {
		display: block;
	}

	/* Once the pill has formed, the surface is --page again. */
	.site-header.is-scrolled .header__mark--on-light {
		display: block;
	}

	.site-header.is-scrolled .header__mark--on-dark {
		display: none;
	}

	:global(html[data-theme="dark"]) .site-header.is-scrolled .header__mark--on-light {
		display: none;
	}

	:global(html[data-theme="dark"]) .site-header.is-scrolled .header__mark--on-dark {
		display: block;
	}

	.header__name {
		color: var(--ink);
		font-size: var(--type-body-size);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.01em;
	}

	/* Centred desktop nav */
	.header__nav {
		display: none;
		align-items: center;
		justify-content: center;
		gap: var(--space-2xs);
	}

	.header__link {
		display: inline-flex;
		align-items: center;
		height: 36px;
		padding: 0 14px;
		color: var(--ink-muted);
		font-size: var(--type-small-size);
		font-weight: 500;
		line-height: 1;
		text-decoration: none;
		border-radius: var(--radius-button);
		transition:
			color var(--transition),
			background-color var(--transition);
	}

	.header__link:hover {
		color: var(--ink);
	}

	.header__link[aria-current] {
		background: var(--mint-100);
		color: var(--ink);
	}

	/* End cluster */
	.header__end {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		justify-self: end;
	}

	.header__cta-wrap {
		display: none;
		align-items: center;
	}

	/* Hamburger */
	.header__toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
		border-radius: var(--radius-button);
		background: transparent;
		color: var(--ink);
	}

	.header__toggle-icon {
		display: grid;
		gap: 5px;
		width: 16px;
	}

	.header__toggle-icon span {
		display: block;
		height: 1.5px;
		background: currentColor;
		border-radius: 1px;
		transition: transform var(--transition);
	}

	.header__toggle[aria-expanded="true"] .header__toggle-icon span:first-child {
		transform: translateY(3.25px) rotate(45deg);
	}

	.header__toggle[aria-expanded="true"] .header__toggle-icon span:last-child {
		transform: translateY(-3.25px) rotate(-45deg);
	}

	/* Mobile slide panel */
	.header__panel {
		display: none;
	}

	.header__panel.is-open {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		width: min(380px, 86vw);
		padding: calc(var(--header-height) + var(--space-lg)) var(--gutter) var(--space-2xl);
		background: var(--page);
		border-inline-start: 1px solid var(--line);
		z-index: 60;
		overflow-y: auto;
		overscroll-behavior: contain;
		animation: panel-slide 260ms var(--ease-out);
	}

	.header__close {
		position: absolute;
		top: 12px;
		right: 16px;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--page);
		color: var(--ink);
	}

	@keyframes panel-slide {
		from {
			transform: translateX(100%);
		}
		to {
			transform: translateX(0);
		}
	}

	.header__panel-nav {
		display: grid;
		gap: var(--space-2xs);
	}

	.header__mobile-link {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 8px 14px;
		color: var(--ink);
		font-size: var(--type-body-size);
		font-weight: 500;
		text-decoration: none;
		border-radius: var(--radius-button);
	}

	.header__mobile-link[aria-current] {
		background: var(--mint-100);
	}

	.header__panel-end {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm);
		margin-top: auto;
		padding-top: var(--space-md);
		border-top: 1px solid var(--line);
	}

	.header__scrim {
		position: fixed;
		inset: 0;
		background: color-mix(in srgb, var(--ink) 30%, transparent);
		z-index: 55;
	}

	.header__scrim[hidden] {
		display: none;
	}

	:global(body[data-menu-open]) {
		overflow: hidden;
	}

	/* ---- Breakpoints ------------------------------------------------ */
	@media (max-width: 560px) {
		.header__inner {
			gap: var(--space-sm);
			padding-inline: var(--space-md);
		}

		.header__name {
			font-size: var(--type-small-size);
		}

		.header__end {
			gap: var(--space-xs);
		}
	}

	@media (min-width: 1024px) {
		.header__nav {
			display: flex;
		}

		.header__cta-wrap {
			display: flex;
		}

		.header__toggle {
			display: none;
		}

		/* The slide panel and scrim are desktop-hidden regardless of state. */
		.header__panel,
		.header__panel.is-open {
			display: none;
		}

		.header__scrim,
		.header__scrim[hidden] {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			transition: none;
		}

		.header__panel.is-open {
			animation: none;
		}
	}
</style>
