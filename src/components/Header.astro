---
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { site, type NavItem } from "../config/site";
import { Image } from "emdash/ui";
import type { ImageValue } from "emdash";
import { localizedNav, localizedCta } from "../i18n/nav";
import { localizePath, stripLocalePrefix, useUi, type Locale } from "../i18n";

interface Props {
	items?: NavItem[];
	cta?: NavItem;
	tone?: "dark" | "light";
	currentPath?: string;
	siteName?: string;
	headerMarkLight?: ImageValue | null;
	headerMarkDark?: ImageValue | null;
	languagePaths?: Partial<Record<Locale, string>>;
}

const { locale, t } = useUi(Astro);
const {
	items = localizedNav([...site.nav], t, locale),
	cta = localizedCta(site.cta, t, locale),
	tone = "light",
	currentPath = Astro.url.pathname,
	siteName = site.name,
	headerMarkLight,
	headerMarkDark,
	languagePaths,
} = Astro.props;

const rawPath = stripLocalePrefix(currentPath).path;
const path = rawPath.length > 1 ? rawPath.replace(/\/+$/, "") : "/";
const isLinkCurrent = (item: NavItem) => {
	if (item.href.startsWith("#")) return false;
	const target = stripLocalePrefix(item.href.split("#")[0] ?? "/").path;
	return target === "/" ? path === "/" : path === target;
};
const homeHref = localizePath("/", locale);
---

<header class="site-header" data-header>
	<div class="header__inner">
		<a href={homeHref} class="header__brand" aria-label={`${siteName}, ${t.a11y.home}`}>
			{headerMarkLight ? (
				<Image
					image={headerMarkLight}
					alt=""
					class="header__mark header__mark--on-light"
					width={44}
					height={44}
				/>
			) : (
				<img
					class="header__mark header__mark--on-light"
					src="/images/kanwal-mark-on-light.png"
					alt=""
					width="592"
					height="688"
				/>
			)}
			{headerMarkDark ? (
				<Image
					image={headerMarkDark}
					alt=""
					class="header__mark header__mark--on-dark"
					width={44}
					height={44}
				/>
			) : (
				<img
					class="header__mark header__mark--on-dark"
					src="/images/kanwal-mark-on-dark.png"
					alt=""
					width="592"
					height="688"
				/>
			)}
			<span class="header__name">{siteName}</span>
		</a>

		<nav class="header__nav" aria-label={t.a11y.primaryNav}>
			{
				items.map((item) => (
					<a
						href={item.href}
						class="header__link"
						data-nav-link
						data-nav-anchor={item.anchor}
						aria-current={isLinkCurrent(item) ? "page" : undefined}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="header__end">
			<div class="header__language header__language--header">
				<LanguageSwitcher paths={languagePaths} />
			</div>
			<ThemeToggle />
			<div class="header__cta-wrap">
				<button type="button" class="header__cta-btn btn-primary" data-book-cta>
					{cta.label}
				</button>
			</div>

			<button
				type="button"
				class="header__toggle"
				data-menu-toggle
				aria-expanded="false"
				aria-controls="site-menu"
				aria-label={t.a11y.openMenu}
				data-label-open={t.a11y.openMenu}
				data-label-close={t.a11y.closeMenu}
			>
				<span class="header__toggle-icon" aria-hidden="true">
					<span></span>
					<span></span>
				</span>
			</button>
		</div>
	</div>

	<div class="header__panel" id="site-menu" data-menu-panel>
		<button
			type="button"
			class="header__close"
			data-menu-close
			aria-label={t.a11y.closeMenu}
		>
			<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
				<path
					d="m6 6 12 12M18 6 6 18"
					fill="none"
					stroke="currentColor"
					stroke-width="1.7"
					stroke-linecap="round"
				/>
			</svg>
		</button>
		<nav class="header__panel-nav" aria-label={t.a11y.primaryNav}>
			{
				items.map((item) => (
					<a
						href={item.href}
						class="header__mobile-link"
						data-nav-link
						data-nav-anchor={item.anchor}
						aria-current={isLinkCurrent(item) ? "page" : undefined}
					>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="header__panel-end">
			<div class="header__language header__language--panel">
				<LanguageSwitcher paths={languagePaths} />
			</div>
			<ThemeToggle />
			<button type="button" class="header__cta-btn btn-primary" data-book-cta>
				{cta.label}
			</button>
		</div>
	</div>
	<div class="header__scrim" data-menu-scrim hidden></div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]");
	const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
	const scrim = document.querySelector<HTMLElement>("[data-menu-scrim]");
	const header = document.querySelector<HTMLElement>("[data-header]");

	if (toggle && panel) {
		const setOpen = (open: boolean) => {
			panel.classList.toggle("is-open", open);
			scrim?.toggleAttribute("hidden", !open);
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute(
				"aria-label",
				open
					? (toggle.dataset.labelClose ?? "Close menu")
					: (toggle.dataset.labelOpen ?? "Open menu"),
			);
			document.body.toggleAttribute("data-menu-open", open);
		};

		const close = () => setOpen(false);

		toggle.addEventListener("click", () => {
			setOpen(toggle.getAttribute("aria-expanded") !== "true");
		});

		closeButton?.addEventListener("click", close);
		scrim?.addEventListener("click", close);

		panel.addEventListener("click", (event) => {
			if (event.target instanceof Element && event.target.closest("a")) close();
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && panel.classList.contains("is-open")) {
				close();
				toggle.focus();
			}
		});

		const desktop = window.matchMedia("(min-width: 1024px)");
		desktop.addEventListener("change", (event) => {
			if (event.matches) close();
		});
	}

	if (header) {
		const onScroll = () => {
			header.classList.toggle("is-scrolled", window.scrollY > 8);
		};
		window.addEventListener("scroll", onScroll, { passive: true });
		onScroll();
		document.addEventListener("astro:after-swap", onScroll);
	}
</script>

<script>
	// In-page navigation: smooth scroll, hash without a jump, and an active
	// link that follows the section in view. Reduced motion means instant.
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
	const navLinks = Array.from(
		document.querySelectorAll<HTMLAnchorElement>("[data-nav-link][data-nav-anchor]"),
	);
	const header = document.querySelector<HTMLElement>("[data-header]");
	const headerHeight = () => header?.offsetHeight ?? 0;

	const targetFrom = (href: string) => {
		const url = new URL(href, window.location.href);
		if (url.pathname !== window.location.pathname || !url.hash) return null;
		return document.getElementById(decodeURIComponent(url.hash.slice(1)));
	};

	for (const link of document.querySelectorAll<HTMLAnchorElement>("a[href*='#']")) {
		const target = targetFrom(link.href);
		if (!target) continue;
		link.addEventListener("click", (event) => {
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			event.preventDefault();
			target.scrollIntoView({
				behavior: reduceMotion.matches ? "auto" : "smooth",
				block: "start",
			});
			const url = new URL(link.href);
			history.pushState(null, "", `${url.pathname}${url.search}${url.hash}`);
			if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
			target.focus({ preventScroll: true });
		});
	}

	if (navLinks.length > 0) {
		const sections = navLinks
			.map((link) => document.getElementById(link.dataset.navAnchor ?? ""))
			.filter((section): section is HTMLElement => section !== null);

		const setActive = (id: string) => {
			for (const link of navLinks) {
				const active = link.dataset.navAnchor === id;
				if (active) link.setAttribute("aria-current", "location");
				else if (link.getAttribute("aria-current") === "location") {
					link.removeAttribute("aria-current");
				}
			}
		};

		if (sections.length > 0 && "IntersectionObserver" in window) {
			const visible = new Set<string>();
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) visible.add(entry.target.id);
						else visible.delete(entry.target.id);
					}
					const first = sections.find((section) => visible.has(section.id));
					if (first) setActive(first.id);
				},
				{
					rootMargin: `-${headerHeight() + 1}px 0px -55% 0px`,
					threshold: 0,
				},
			);
			for (const section of sections) observer.observe(section);
		}
	}
</script>

<style>
	/* Floating white pill header — always visible, 12px from viewport top. */
	.site-header {
		position: sticky;
		top: 12px;
		z-index: 50;
		background: var(--surface);
		border-radius: 999px;
		margin-inline: 12px;
		box-shadow:
			0 1px 3px rgba(11, 26, 20, 0.06),
			0 4px 12px rgba(11, 26, 20, 0.08);
		transition: box-shadow 220ms var(--ease-out);
	}

	.site-header.is-scrolled {
		box-shadow:
			0 2px 6px rgba(11, 26, 20, 0.1),
			0 8px 24px rgba(11, 26, 20, 0.12);
	}

	/* On Home the pill floats over the hero: cancel the pill's flow height so
	   the hero background starts at y=0 and runs behind it. */
	:global(body[data-is-home]) .site-header {
		margin-top: 12px;
		margin-bottom: calc(-1 * (var(--header-height) + 12px));
	}

	.header__inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: var(--space-lg);
		width: 100%;
		max-width: calc(var(--container) + var(--gutter) * 2);
		margin-inline: auto;
		padding: 8px 12px 8px 16px;
		min-height: var(--header-height);
	}

	/* Brand */
	.header__brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--ink);
		text-decoration: none;
	}

	.header__mark {
		display: block;
		height: 44px;
		width: auto;
		object-fit: contain;
	}

	/* Theme-based logo visibility only — the pill always has a solid surface. */
	.header__mark--on-dark {
		display: none;
	}

	:global(html[data-theme="dark"]) .header__mark--on-light {
		display: none;
	}

	:global(html[data-theme="dark"]) .header__mark--on-dark {
		display: block;
	}

	.header__name {
		color: var(--ink);
		font-size: var(--type-body-size);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.01em;
	}

	/* Centred desktop nav */
	.header__nav {
		display: none;
		align-items: center;
		justify-content: center;
		gap: var(--space-2xs);
	}

	.header__link {
		display: inline-flex;
		align-items: center;
		height: 36px;
		padding: 0 14px;
		color: var(--type-copy-color);
		font-size: var(--type-small-size);
		font-weight: var(--type-nav-weight);
		line-height: 1;
		text-decoration: none;
		border-radius: var(--radius-button);
		transition:
			color var(--transition),
			background-color var(--transition);
	}

	.header__link:hover {
		color: var(--ink);
	}

	.header__link[aria-current] {
		color: var(--green-deep);
	}

	/* End cluster */
	.header__end {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		justify-self: end;
	}

	.header__cta-wrap {
		display: none;
		align-items: center;
	}

	/* Hamburger */
	.header__toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
		border-radius: var(--radius-button);
		background: transparent;
		color: var(--ink);
	}

	.header__toggle-icon {
		display: grid;
		gap: 5px;
		width: 16px;
	}

	.header__toggle-icon span {
		display: block;
		height: 1.5px;
		background: currentColor;
		border-radius: 1px;
		transition: transform var(--transition);
	}

	.header__toggle[aria-expanded="true"] .header__toggle-icon span:first-child {
		transform: translateY(3.25px) rotate(45deg);
	}

	.header__toggle[aria-expanded="true"] .header__toggle-icon span:last-child {
		transform: translateY(-3.25px) rotate(-45deg);
	}

	/* Mobile slide panel */
	.header__panel {
		display: none;
	}

	.header__panel.is-open {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
		position: fixed;
		top: 0;
		inset-inline-end: 0;
		bottom: 0;
		width: min(380px, 86vw);
		padding: calc(var(--header-height) + var(--space-lg)) var(--gutter) var(--space-2xl);
		background: var(--page);
		border-inline-start: 1px solid var(--line);
		z-index: 60;
		overflow-y: auto;
		overscroll-behavior: contain;
		animation: panel-slide 260ms var(--ease-out);
	}

	.header__close {
		position: absolute;
		top: 12px;
		inset-inline-end: 16px;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--page);
		color: var(--ink);
	}

	@keyframes panel-slide {
		from {
			transform: translateX(100%);
		}
		to {
			transform: translateX(0);
		}
	}

	@keyframes panel-slide-rtl {
		from {
			transform: translateX(-100%);
		}
		to {
			transform: translateX(0);
		}
	}

	:global(html[dir="rtl"]) .header__panel.is-open {
		animation-name: panel-slide-rtl;
	}

	.header__panel-nav {
		display: grid;
		gap: var(--space-2xs);
	}

	.header__mobile-link {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 8px 14px;
		color: var(--ink);
		font-size: var(--type-body-size);
		font-weight: var(--type-nav-weight);
		text-decoration: none;
		border-radius: var(--radius-button);
	}

	.header__mobile-link[aria-current] {
		background: var(--mint-100);
	}

	.header__panel-end {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm);
		margin-top: auto;
		padding-top: var(--space-md);
		border-top: 1px solid var(--line);
	}

	.header__language--panel {
		display: none;
	}

	.header__scrim {
		position: fixed;
		inset: 0;
		background: color-mix(in srgb, var(--ink) 30%, transparent);
		z-index: 55;
	}

	.header__scrim[hidden] {
		display: none;
	}

	:global(body[data-menu-open]) {
		overflow: hidden;
	}

	/* ---- Breakpoints ------------------------------------------------ */
	@media (max-width: 560px) {
		.header__inner {
			gap: var(--space-sm);
			padding-inline: var(--space-sm);
		}

		.header__name {
			font-size: var(--type-small-size);
		}

		.header__end {
			gap: var(--space-xs);
		}
	}

	@media (max-width: 1023px) {
		.header__language--header {
			display: none;
		}

		.header__language--panel {
			display: inline-flex;
		}
	}

	@media (min-width: 1024px) {
		.header__nav {
			display: flex;
		}

		.header__cta-wrap {
			display: flex;
		}

		.header__toggle {
			display: none;
		}

		.header__panel,
		.header__panel.is-open {
			display: none;
		}

		.header__language--panel {
			display: none;
		}

		.header__scrim,
		.header__scrim[hidden] {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			transition: none;
		}

		.header__panel.is-open {
			animation: none;
		}
	}

	/* Modal trigger button styled as primary */
	.header__cta-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 44px;
		padding: 0 20px;
		border: 1px solid var(--green);
		border-radius: var(--radius-button);
		background: var(--green);
		color: var(--on-accent);
		font: inherit;
		font-size: var(--type-header-button-size);
		font-weight: var(--type-button-weight);
		cursor: pointer;
		transition: background-color var(--transition), border-color var(--transition);
		white-space: nowrap;
	}

	.header__cta-btn:hover { background: var(--green-deep); border-color: var(--green-deep); }
	.header__cta-btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
</style>
