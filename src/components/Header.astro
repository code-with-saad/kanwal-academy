---
import Button from "./Button.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site, type NavItem } from "../config/site";

interface Props {
	items?: NavItem[];
	cta?: NavItem;
	tone?: "dark" | "light";
	currentPath?: string;
	siteName?: string;
}

const {
	items = [...site.nav],
	cta = site.cta,
	tone = "light",
	currentPath = Astro.url.pathname,
	siteName = site.name,
} = Astro.props;

const path = currentPath.length > 1 ? currentPath.replace(/\/+$/, "") : "/";
const isCurrent = (url: string) => {
	const target = url.length > 1 ? url.replace(/\/+$/, "") : url;
	return target === "/" ? path === "/" : path === target || path.startsWith(`${target}/`);
};
---

<header class:list={["site-header", tone === "dark" && "site-header--dark tone-dark"]}>
	<!-- Plain div, not Container: scoped styles must reach this element. -->
	<div class="container header__inner">
		<a href="/" class="header__brand" aria-label={`${siteName}, home`}>
			<img
				class="header__mark header__mark--on-light"
				src="/images/kanwal-mark-on-light.png"
				alt=""
				width="592"
				height="688"
			/>
			<img
				class="header__mark header__mark--on-dark"
				src="/images/kanwal-mark-on-dark.png"
				alt=""
				width="592"
				height="688"
			/>
			<span class="header__name">{siteName}</span>
		</a>

		<div class="header__panel" id="site-menu" data-menu-panel>
			<nav aria-label="Primary">
				<ul class="header__nav">
					{
						items.map((item) => (
							<li>
								<a
									href={item.url}
									class="header__link"
									aria-current={isCurrent(item.url) ? "page" : undefined}
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<div class="header__cta-mobile">
				<ThemeToggle />
				<Button href={cta.url} variant="primary">
					{cta.label}
				</Button>
			</div>
		</div>

		<div class="header__end">
			<ThemeToggle />
			<div class="header__cta-wrap">
				<Button href={cta.url} variant="primary">
					{cta.label}
				</Button>
			</div>

			<button
				type="button"
				class="header__toggle"
				data-menu-toggle
				aria-expanded="false"
				aria-controls="site-menu"
			>
				<span class="header__toggle-label" data-menu-label>Menu</span>
				<span class="header__toggle-icon" aria-hidden="true">
					<span></span>
					<span></span>
				</span>
			</button>
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
	const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
	const label = document.querySelector<HTMLElement>("[data-menu-label]");

	if (toggle && panel) {
		const setOpen = (open: boolean) => {
			panel.classList.toggle("is-open", open);
			toggle.setAttribute("aria-expanded", String(open));
			if (label) label.textContent = open ? "Close" : "Menu";
		};

		const close = () => setOpen(false);

		toggle.addEventListener("click", () => {
			setOpen(toggle.getAttribute("aria-expanded") !== "true");
		});

		panel.addEventListener("click", (event) => {
			if (event.target instanceof Element && event.target.closest("a")) close();
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && panel.classList.contains("is-open")) {
				close();
				toggle.focus();
			}
		});

		const desktop = window.matchMedia("(min-width: 1024px)");
		desktop.addEventListener("change", (event) => {
			if (event.matches) close();
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--page);
		border-bottom: 1px solid var(--line);
	}

	.site-header--dark {
		background: var(--bg-dark);
	}

	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-lg);
		width: 100%;
		max-width: calc(var(--container) + var(--gutter) * 2);
		margin-inline: auto;
		padding-inline: var(--gutter);
		min-height: var(--header-height);
		position: relative;
	}

	.header__end {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.header__brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--ink);
		text-decoration: none;
		transition: color var(--transition);
	}

	.header__mark {
		display: block;
		height: 44px;
		width: auto;
		object-fit: contain;
	}

	.header__mark--on-dark {
		display: none;
	}

	/* Show the mark that matches the surface behind the header. */
	.site-header--dark .header__mark--on-light {
		display: none;
	}

	.site-header--dark .header__mark--on-dark {
		display: block;
	}

	:global(html[data-theme="dark"]) .header__mark--on-light {
		display: none;
	}

	:global(html[data-theme="dark"]) .header__mark--on-dark {
		display: block;
	}

	.header__name {
		color: var(--ink);
		font-family: var(--font-heading, Georgia, serif);
		font-size: 20px;
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.01em;
	}

	.header__brand:hover .header__name {
		color: var(--accent);
	}

	.header__panel {
		display: none;
	}

	.header__panel.is-open {
		display: block;
		position: fixed;
		inset: var(--header-height) 0 0;
		overflow-y: auto;
		padding: var(--space-lg) var(--gutter) var(--space-2xl);
		background: var(--surface);
		border-bottom: 1px solid var(--line);
		overscroll-behavior: contain;
	}

	.header__nav {
		display: grid;
		gap: var(--space-2xs);
	}

	.header__link {
		display: block;
		padding: 10px 0;
		color: var(--ink-muted);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
		transition: color var(--transition);
	}

	.header__link:hover,
	.header__link[aria-current="page"] {
		color: var(--ink);
	}

	.header__link[aria-current="page"] {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 6px;
	}

	.header__cta-mobile {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm);
		margin-top: var(--space-md);
	}

	.header__cta-wrap {
		display: none;
		align-items: center;
		gap: var(--space-sm);
	}

	.header__toggle {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 9px 12px;
		border: 1px solid var(--line);
		border-radius: var(--radius-button);
		background: transparent;
		color: var(--ink);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.header__toggle-icon {
		display: grid;
		gap: 4px;
		width: 14px;
	}

	.header__toggle-icon span {
		display: block;
		height: 1px;
		background: currentColor;
		transition: transform var(--transition);
	}

	.header__toggle[aria-expanded="true"] .header__toggle-icon span:first-child {
		transform: translateY(2.5px) rotate(45deg);
	}

	.header__toggle[aria-expanded="true"] .header__toggle-icon span:last-child {
		transform: translateY(-2.5px) rotate(-45deg);
	}

	@media (max-width: 560px) {
		.header__inner {
			gap: var(--space-md);
		}

		.header__end {
			gap: var(--space-xs);
		}

		/* Keep the label for screen readers but free up room for the brand name. */
		.header__toggle-label {
			position: absolute;
			width: 1px;
			height: 1px;
			margin: -1px;
			padding: 0;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
			border: 0;
		}

		.header__toggle {
			padding: 9px 12px;
		}
	}

	@media (min-width: 1024px) {
		.header__panel {
			display: block;
			position: static;
			inset: auto;
			overflow: visible;
			margin-inline-start: auto;
			padding: 0;
			background: transparent;
			border: 0;
		}

		.header__nav {
			display: flex;
			align-items: center;
			gap: clamp(14px, 2vw, 28px);
		}

		.header__link {
			padding: 8px 0;
		}

		.header__cta-wrap {
			display: flex;
		}

		.header__cta-mobile {
			display: none;
		}

		.header__toggle {
			display: none;
		}
	}
</style>
