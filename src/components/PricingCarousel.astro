---
/**
 * Pricing carousel for mobile. Native CSS scroll-snap so swipe works
 * without JS. JS enhances with dots, buttons and a11y live region.
 * Plan order: I, II, III, IV. Scrolls to Plan II (index 1) on load.
 */
import type { PlanCardData } from "./PlanCard.astro";
import PlanCard from "./PlanCard.astro";

import { useUi } from "../i18n";

const { t } = useUi(Astro);

interface Props {
	plans: PlanCardData[];
	periodLabel?: string;
	classesWeekLabel?: string;
	classesMonthLabel?: string;
	hoursLabel?: string;
	popularLabel?: string;
	selectCta?: string;
}

const {
	plans,
	periodLabel,
	classesWeekLabel,
	classesMonthLabel,
	hoursLabel,
	popularLabel,
	selectCta,
} = Astro.props;
const initialIndex = 1; // Plan II (most popular) is the default
---

<div
	class="pricing-carousel"
	data-carousel
	data-start={initialIndex}
	data-status-template={t.a11y.planStatus}
	role="region"
	aria-roledescription="carousel"
	aria-label={t.a11y.monthlyPlans}
>
	<div class="pricing-carousel__track">
		{
			plans.map((plan) => (
				<div class="pricing-carousel__slide" data-slide>
					<PlanCard
						plan={plan}
						revealDelay={0}
						periodLabel={periodLabel}
						classesWeekLabel={classesWeekLabel}
						classesMonthLabel={classesMonthLabel}
						hoursLabel={hoursLabel}
						popularLabel={popularLabel}
						selectCta={selectCta}
					/>
				</div>
			))
		}
	</div>

	<div class="pricing-carousel__controls">
		<button type="button" class="pricing-carousel__btn pricing-carousel__btn--prev" data-prev aria-label={t.a11y.previousPlan}>
			<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12.5 4.5 7 10l5.5 5.5" />
			</svg>
		</button>

		<div class="pricing-carousel__dots" data-dots role="tablist" aria-label={t.a11y.planSelector}>
			{
				plans.map((plan, i) => (
					<button
						type="button"
						class="pricing-carousel__dot"
						class:list={[i === initialIndex && "pricing-carousel__dot--active"]}
						data-dot={i}
						role="tab"
						aria-selected={i === initialIndex}
						aria-label={plan.name}
					></button>
				))
			}
		</div>

		<button type="button" class="pricing-carousel__btn pricing-carousel__btn--next" data-next aria-label={t.a11y.nextPlan}>
			<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M7.5 4.5 13 10l-5.5 5.5" />
			</svg>
		</button>
	</div>

	<p class="pricing-carousel__sr-status" role="status" aria-live="polite" data-status></p>
</div>

<script>
	document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
		let loaded = false;
		const load = () => {
			if (loaded) return;
			loaded = true;
			void import("../scripts/pricing-carousel")
				.then(({ initPricingCarousel }) => initPricingCarousel(root))
				.catch((error: unknown) => console.error("Could not initialize the pricing carousel", error));
			observer?.disconnect();
		};
		let observer: IntersectionObserver | undefined;
		root.addEventListener("focusin", load, { once: true });
		if (typeof IntersectionObserver === "undefined") load();
		else {
			observer = new IntersectionObserver(
				([entry]) => {
					if (entry?.isIntersecting) load();
				},
				{ rootMargin: "200px" },
			);
			observer.observe(root);
		}
	});
</script>

<style>
	.pricing-carousel {
		position: relative;
	}

	.pricing-carousel__track {
		display: flex;
		gap: 16px;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		overscroll-behavior-x: contain;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.pricing-carousel__track::-webkit-scrollbar {
		display: none;
	}

	.pricing-carousel__slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
		min-width: 0;
	}

	.pricing-carousel__controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		margin-top: 24px;
	}

	.pricing-carousel__btn {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid var(--line);
		background: var(--surface);
		color: var(--ink);
		transition:
			background-color var(--transition),
			border-color var(--transition),
			color var(--transition);
	}

	.pricing-carousel__btn:hover:not(:disabled) {
		background: var(--green);
		border-color: var(--green);
		color: #ffffff;
	}

	.pricing-carousel__btn:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}

	/* The row reverses in RTL; mirror the chevrons so each still points the
	 * way the carousel moves. */
	:global(html[dir="rtl"]) .pricing-carousel__btn svg {
		transform: scaleX(-1);
	}

	.pricing-carousel__dots {
		display: flex;
		gap: 8px;
	}

	.pricing-carousel__dot {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		border: none;
		background: transparent;
		padding: 0;
		cursor: pointer;
		transition:
			transform var(--transition);
	}

	.pricing-carousel__dot::before {
		content: "";
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--line);
		transition:
			background-color var(--transition),
			transform var(--transition);
	}

	.pricing-carousel__dot--active::before {
		background: var(--green);
		transform: scale(1.2);
	}

	.pricing-carousel__sr-status {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* Hide carousel controls on desktop */
	@media (min-width: 769px) {
		.pricing-carousel__controls {
			display: none;
		}

		.pricing-carousel__track {
			overflow: visible;
			scroll-snap-type: none;
		}

		.pricing-carousel__slide {
			flex: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pricing-carousel__btn,
		.pricing-carousel__dot {
			transition: none;
		}
	}
</style>
