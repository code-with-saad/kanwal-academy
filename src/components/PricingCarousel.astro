---
/**
 * Pricing carousel for mobile. Native CSS scroll-snap so swipe works
 * without JS. JS enhances with dots, buttons and a11y live region.
 * Plan order: I, II, III, IV. Scrolls to Plan II (index 1) on load.
 */
import type { PlanCardData } from "./PlanCard.astro";
import PlanCard from "./PlanCard.astro";

interface Props {
	plans: PlanCardData[];
	periodLabel?: string;
	classesWeekLabel?: string;
	classesMonthLabel?: string;
	hoursLabel?: string;
	popularLabel?: string;
	selectCta?: string;
}

const {
	plans,
	periodLabel,
	classesWeekLabel,
	classesMonthLabel,
	hoursLabel,
	popularLabel,
	selectCta,
} = Astro.props;
const initialIndex = 1; // Plan II (most popular) is the default
---

<div
	class="pricing-carousel"
	data-carousel
	data-start={initialIndex}
	role="region"
	aria-roledescription="carousel"
	aria-label="Monthly plans"
>
	<div class="pricing-carousel__track">
		{
			plans.map((plan) => (
				<div class="pricing-carousel__slide" data-slide>
					<PlanCard
						plan={plan}
						revealDelay={0}
						periodLabel={periodLabel}
						classesWeekLabel={classesWeekLabel}
						classesMonthLabel={classesMonthLabel}
						hoursLabel={hoursLabel}
						popularLabel={popularLabel}
						selectCta={selectCta}
					/>
				</div>
			))
		}
	</div>

	<div class="pricing-carousel__controls">
		<button type="button" class="pricing-carousel__btn pricing-carousel__btn--prev" data-prev aria-label="Previous plan">
			<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12.5 4.5 7 10l5.5 5.5" />
			</svg>
		</button>

		<div class="pricing-carousel__dots" data-dots role="tablist" aria-label="Plan selector">
			{
				plans.map((plan, i) => (
					<button
						type="button"
						class="pricing-carousel__dot"
						class:list={[i === initialIndex && "pricing-carousel__dot--active"]}
						data-dot={i}
						role="tab"
						aria-selected={i === initialIndex}
						aria-label={plan.name}
					></button>
				))
			}
		</div>

		<button type="button" class="pricing-carousel__btn pricing-carousel__btn--next" data-next aria-label="Next plan">
			<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M7.5 4.5 13 10l-5.5 5.5" />
			</svg>
		</button>
	</div>

	<p class="pricing-carousel__sr-status" role="status" aria-live="polite" data-status></p>
</div>

<script>
	const root = document.querySelector<HTMLElement>("[data-carousel]");
	if (!root) throw new Error("Carousel root not found");

	const track = root.querySelector<HTMLElement>(".pricing-carousel__track")!;
	const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
	const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
	const prevBtn = root.querySelector<HTMLButtonElement>("[data-prev]")!;
	const nextBtn = root.querySelector<HTMLButtonElement>("[data-next]")!;
	const statusEl = root.querySelector<HTMLElement>("[data-status]")!;
	const total = slides.length;

	const start = Number(root.dataset.start ?? 1);
	let current = start;

	// Scroll to Plan II on load (no animation, no layout shift)
	const scrollToStart = () => {
		if (slides[start]) {
			track.scrollLeft = slides[start].offsetLeft - slides[0].offsetLeft;
		}
	};
	// Try immediately, fallback to rAF if layout not ready
	if (slides[start]?.offsetLeft) {
		scrollToStart();
	} else {
		requestAnimationFrame(scrollToStart);
	}

	const scrollTo = (index: number) => {
		if (index < 0 || index >= total) return;
		current = index;
		track.scrollTo({
			left: slides[index].offsetLeft - slides[0].offsetLeft,
			behavior: "smooth",
		});
	};

	const updateUI = () => {
		const trackRect = track.getBoundingClientRect();
		const center = trackRect.left + trackRect.width / 2;

		let closest = 0;
		let closestDist = Infinity;
		slides.forEach((slide, i) => {
			const rect = slide.getBoundingClientRect();
			const slideCenter = rect.left + rect.width / 2;
			const dist = Math.abs(slideCenter - center);
			if (dist < closestDist) {
				closestDist = dist;
				closest = i;
			}
		});

		if (closest !== current) {
			current = closest;
		}

		dots.forEach((dot, i) => {
			const active = i === current;
			dot.classList.toggle("pricing-carousel__dot--active", active);
			dot.setAttribute("aria-selected", String(active));
		});

		prevBtn.disabled = current === 0;
		nextBtn.disabled = current === total - 1;

		const planName = slides[current]?.querySelector(".plan-card__name")?.textContent?.trim() ?? "";
		statusEl.textContent = `${planName}, plan ${current + 1} of ${total}`;
	};

	prevBtn.addEventListener("click", () => scrollTo(current - 1));
	nextBtn.addEventListener("click", () => scrollTo(current + 1));

	dots.forEach((dot, i) => {
		dot.addEventListener("click", () => scrollTo(i));
	});

	let scrollTimer: ReturnType<typeof setTimeout>;
	track.addEventListener("scroll", () => {
		clearTimeout(scrollTimer);
		scrollTimer = setTimeout(updateUI, 80);
	}, { passive: true });

	root.addEventListener("keydown", (e: KeyboardEvent) => {
		if (e.key === "ArrowLeft") { e.preventDefault(); scrollTo(current - 1); }
		if (e.key === "ArrowRight") { e.preventDefault(); scrollTo(current + 1); }
	});

	updateUI();
</script>

<style>
	.pricing-carousel {
		position: relative;
	}

	.pricing-carousel__track {
		display: flex;
		gap: 16px;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		overscroll-behavior-x: contain;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.pricing-carousel__track::-webkit-scrollbar {
		display: none;
	}

	.pricing-carousel__slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
		min-width: 0;
	}

	.pricing-carousel__controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		margin-top: 24px;
	}

	.pricing-carousel__btn {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid var(--line);
		background: var(--surface);
		color: var(--ink);
		transition:
			background-color var(--transition),
			border-color var(--transition),
			color var(--transition);
	}

	.pricing-carousel__btn:hover:not(:disabled) {
		background: var(--green);
		border-color: var(--green);
		color: #ffffff;
	}

	.pricing-carousel__btn:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}

	.pricing-carousel__dots {
		display: flex;
		gap: 8px;
	}

	.pricing-carousel__dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		border: none;
		background: var(--line);
		padding: 0;
		cursor: pointer;
		transition:
			background-color var(--transition),
			transform var(--transition);
	}

	.pricing-carousel__dot--active {
		background: var(--green);
		transform: scale(1.2);
	}

	.pricing-carousel__sr-status {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* Hide carousel controls on desktop */
	@media (min-width: 769px) {
		.pricing-carousel__controls {
			display: none;
		}

		.pricing-carousel__track {
			overflow: visible;
			scroll-snap-type: none;
		}

		.pricing-carousel__slide {
			flex: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pricing-carousel__btn,
		.pricing-carousel__dot {
			transition: none;
		}
	}
</style>
