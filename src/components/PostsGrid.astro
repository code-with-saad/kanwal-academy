---
import type { ContentEntry } from "emdash";
import type { Post } from "../../emdash-env";
import { Image } from "emdash/ui";
import Button from "./Button.astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";

import { localizePath, useUi } from "../i18n";

const { locale, t } = useUi(Astro);

interface Props {
	posts: ContentEntry<Post>[];
}

const { posts } = Astro.props;
const latest = posts.slice(0, 3);
---

<ul class="posts-grid">
	{
		latest.map((post, index) => (
			<li class="post-card lift" data-reveal="up" data-reveal-delay={index * 80}>
				<a class="post-card__image" href={localizePath(`/blog/${post.id}`, locale)} tabindex="-1" aria-hidden="true" data-reveal="image">
					{post.data.featured_image ? (
						<Image
							image={post.data.featured_image}
							alt={post.data.featured_image.alt || post.data.title}
							width={post.data.featured_image.width ?? 800}
							height={post.data.featured_image.height ?? 500}
							sizes="(max-width: 560px) calc(100vw - 32px), (max-width: 860px) 45vw, 30vw"
							loading="lazy"
						/>
					) : (
						<ImagePlaceholder
							label="Article image"
							ratio="16 / 10"
							sizes="(max-width: 560px) calc(100vw - 32px), (max-width: 860px) 45vw, 30vw"
						/>
					)}
				</a>
				<div class="post-card__body">
					<h3 class="post-card__title">
						<a href={localizePath(`/blog/${post.id}`, locale)}>{post.data.title}</a>
					</h3>
					{post.data.excerpt && <p class="post-card__excerpt">{post.data.excerpt}</p>}
					<a class="post-card__more" href={localizePath(`/blog/${post.id}`, locale)}>
						Read more
						<svg
							viewBox="0 0 16 16"
							width="14"
							height="14"
							aria-hidden="true"
							focusable="false"
						>
							<path
								d="M3 8h9m-4-4 4 4-4 4"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</a>
				</div>
			</li>
		))
	}
	<li class="posts-grid__action">
		<Button href={localizePath("/blog", locale)} variant="primary">{t.actions.readAllArticles}</Button>
	</li>
</ul>

<style>
	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-lg);
	}

	.post-card {
		display: grid;
		align-content: start;
		gap: var(--space-md);
	}

	.post-card__image {
		display: block;
		overflow: clip;
		border-radius: var(--radius-card);
		background: var(--mint-50);
	}

	.post-card__image :global(.img-ph) {
		border-radius: var(--radius-card);
	}

	.post-card__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.post-card__body {
		display: grid;
		gap: var(--space-xs);
	}

	.post-card__title {
		font-size: var(--type-h3-size);
		font-weight: 500;
		line-height: 1.3;
	}

	.post-card__title a {
		color: var(--ink);
		text-decoration: none;
	}

	.post-card__title a:hover {
		color: var(--green-deep);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.post-card__excerpt {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		color: var(--ink-muted);
		font-size: var(--type-small-size);
		line-height: 1.55;
	}

	.post-card__more {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: var(--space-2xs);
		color: var(--green-deep);
		font-size: var(--type-small-size);
		font-weight: 600;
		text-decoration: none;
	}

	.post-card__more svg {
		transition: transform var(--transition);
	}

	.post-card__more:hover svg,
	.post-card__more:focus-visible svg {
		transform: translateX(2px);
	}

	:global(html[dir="rtl"]) .post-card__more svg {
		transform: scaleX(-1);
	}

	:global(html[dir="rtl"]) .post-card__more:hover svg,
	:global(html[dir="rtl"]) .post-card__more:focus-visible svg {
		transform: scaleX(-1) translateX(2px);
	}

	.posts-grid__action {
		grid-column: 1 / -1;
		justify-self: center;
		margin-top: var(--space-md);
	}

	@media (max-width: 860px) {
		.posts-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}

		.posts-grid__action {
			justify-self: start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card__more svg {
			transition: none;
		}
	}
</style>
