---
import type { FieldAnnotation } from "emdash";

interface Props {
	class?: string;
	edit?: Partial<FieldAnnotation>;
}

const { class: className, edit } = Astro.props;
---

<span class:list={["eyebrow", className]} {...edit}>
	<span class="eyebrow__rule" aria-hidden="true"></span>
	<slot />
</span>

<style>
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		color: var(--green-deep);
		font-size: var(--type-eyebrow-size);
		font-weight: 600;
		letter-spacing: var(--type-eyebrow-tracking);
		line-height: var(--type-eyebrow-line);
		text-transform: uppercase;
	}

	.eyebrow__rule {
		width: 22px;
		height: 1px;
		background: currentColor;
	}
</style>
