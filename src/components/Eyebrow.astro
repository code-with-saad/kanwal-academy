---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["eyebrow", className]}>
	<span class="eyebrow__rule" aria-hidden="true"></span>
	<slot />
</span>

<style>
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		color: var(--accent);
		font-family: var(--font-body, "Instrument Sans", Arial, sans-serif);
		font-size: var(--size-eyebrow);
		font-weight: 600;
		letter-spacing: var(--tracking-eyebrow);
		line-height: 1.2;
		text-transform: uppercase;
	}

	.eyebrow__rule {
		width: 22px;
		height: 1px;
		background: currentColor;
	}
</style>
