---
import { useUi } from "../i18n";

const { t } = useUi(Astro);

interface FeatureCard {
	title: string;
	text: string;
	href?: string;
	icon: "trial" | "price" | "globe" | "device";
	dark?: boolean;
	isFirst?: boolean;
	chipLabel?: string;
}

interface Props {
	cards: FeatureCard[];
	defaultChipLabel?: string;
}

const { cards, defaultChipLabel = t.home.feature_card_1_chip } = Astro.props;
---

<ul class="feature-grid">
	{
		cards.map((card, index) => {
			const body = (
				<>
					<span class="feature-card__top">
						<span class="feature-card__icon" aria-hidden="true">
							{card.icon === "trial" && (
								<svg
									viewBox="0 0 24 24"
									width="22"
									height="22"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<rect x="4" y="5.5" width="16" height="14" rx="3" />
									<path d="M4 10.5h16M9 3v4m6-4v4" />
									<path d="M9.6 15.2l2 2 3.6-3.6" />
								</svg>
							)}
							{card.icon === "price" && (
								<svg
									viewBox="0 0 24 24"
									width="22"
									height="22"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="12" cy="12" r="8.25" />
									<path d="M12 6.75v10.5M14.4 9.4c-.5-.65-1.35-1.05-2.4-1.05-1.5 0-2.55.75-2.55 1.75s1.05 1.55 2.55 1.55 2.55.55 2.55 1.55-1.05 1.75-2.55 1.75c-1.05 0-1.9-.4-2.4-1.05" />
								</svg>
							)}
							{card.icon === "globe" && (
								<svg
									viewBox="0 0 24 24"
									width="22"
									height="22"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
								>
									<circle cx="12" cy="12" r="8.5" />
									<ellipse cx="12" cy="12" rx="4" ry="8.5" />
									<path d="M3.5 12h17" />
								</svg>
							)}
							{card.icon === "device" && (
								<svg
									viewBox="0 0 24 24"
									width="22"
									height="22"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<rect x="4.75" y="3.5" width="14.5" height="17" rx="2.5" />
									<circle cx="12" cy="7.75" r="1" />
									<path d="M9.5 17.25h5" />
								</svg>
							)}
						</span>
						{card.isFirst && <span class="feature-card__chip">{card.chipLabel ?? defaultChipLabel}</span>}
						<span class="feature-card__arrow" aria-hidden="true">
							<svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 10h12m-5-5 5 5-5 5" />
							</svg>
						</span>
					</span>
					<span class="feature-card__body">
						<span class="feature-card__title">{card.title}</span>
						<span class="feature-card__text">{card.text}</span>
					</span>
				</>
			);

			return (
				<li class="feature-cell" style={`--card-index: ${index}`}>
					{card.href ? (
						<a class="feature-card" href={card.href}>
							{body}
						</a>
					) : (
						<div class="feature-card">{body}</div>
					)}
				</li>
			);
		})
	}
</ul>

<style>
	.feature-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-md);
	}

	.feature-card {
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr;
		gap: 12px;
		align-items: start;
		height: 100%;
		padding: 24px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 24px;
		color: inherit;
		text-decoration: none;
		box-shadow: 0 8px 28px -12px rgba(11, 26, 20, 0.18);
		transition: transform var(--dur-base) var(--ease);
		animation: feature-card-in 520ms var(--ease-out) backwards;
		animation-delay: calc(600ms + var(--card-index, 0) * 120ms);
	}

	.feature-card:hover,
	.feature-card:focus-visible {
		transform: translateY(-4px);
	}

	:global(html[dir="rtl"]) .feature-card__arrow svg {
		transform: scaleX(-1);
	}

	/* Top row: icon, optional chip, then arrow. The chip sits beside the icon
	 * so every card's title row starts at the same offset. */
	.feature-card__top {
		grid-row: 1;
		display: flex;
		align-items: center;
		gap: 10px;
		width: 100%;
	}

	.feature-card__icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		flex: none;
		border-radius: 50%;
		background: var(--mint-100);
		color: var(--green-deep);
	}

	/* Free Trial chip inside the top row. */
	.feature-card__chip {
		display: inline-flex;
		align-items: center;
		height: 26px;
		padding: 0 10px;
		border-radius: 999px;
		background: var(--mint-100);
		color: var(--green-deep);
		font-size: 12px;
		font-weight: 600;
		line-height: 1;
		white-space: nowrap;
	}

	.feature-card__title {
		font-weight: 600;
		font-size: var(--type-body-size);
		line-height: 1.3;
		color: var(--ink);
	}

	.feature-card__text {
		color: var(--ink-muted);
		font-size: var(--type-small-size);
		line-height: 1.5;
	}

	/* Arrow cue in the top row, pushed to the right so the chip and arrow
	 * share the row with the icon. */
	.feature-card__arrow {
		margin-inline-start: auto;
		flex: none;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--mint-100);
		color: var(--green-deep);
		transition:
			background-color var(--transition),
			color var(--transition),
			transform var(--transition);
	}

	/* Body: title + text. Always starts below the icon/chip/arrow row, so
	 * every card's title is vertically aligned regardless of chip presence. */
	.feature-card__body {
		grid-row: 2;
		display: grid;
		gap: 4px;
		align-content: start;
	}

	.feature-card:hover .feature-card__arrow,
	.feature-card:focus-visible .feature-card__arrow {
		background: var(--green);
		color: var(--on-accent);
		transform: translateX(2px);
	}

	:global(html[dir="rtl"]) .feature-card:hover .feature-card__arrow,
	:global(html[dir="rtl"]) .feature-card:focus-visible .feature-card__arrow {
		transform: translateX(-2px);
	}

	@keyframes feature-card-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 900px) {
		.feature-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.feature-card__top {
			flex-wrap: wrap;
		}

		.feature-card__arrow {
			position: absolute;
			inset-inline-end: 14px;
			bottom: 14px;
			margin-inline-start: 0;
		}

		.feature-card__body {
			padding-bottom: 42px;
		}
	}

	@media (max-width: 420px) {
		.feature-grid {
			gap: var(--space-sm);
		}

		.feature-card {
			gap: 8px 10px;
			padding: 18px;
		}

		.feature-card__icon {
			width: 38px;
			height: 38px;
		}

		.feature-card__icon svg {
			width: 18px;
			height: 18px;
		}

		.feature-card__title {
			font-size: var(--type-body-size);
		}

		.feature-card__text {
			font-size: var(--type-small-size);
		}

		.feature-card__arrow svg {
			width: 16px;
			height: 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.feature-card {
			animation: none;
			opacity: 1;
		}
	}
</style>
