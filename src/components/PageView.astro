---
import type { ContentEntry } from "emdash";
import { PortableText } from "emdash/ui";
import type { Page } from "../../emdash-env";
import Container from "./Container.astro";
import Section from "./Section.astro";

interface Props {
	page: ContentEntry<Page>;
	/** The heading shown above the page content. Defaults to the page title. */
	heading?: string;
}

const { page, heading } = Astro.props;
const title = heading ?? page.data.title;
const titleEdit = heading === undefined ? page.edit.title : {};
const blocks = page.data.content ?? [];
---

<Section space="tight">
	<Container size="narrow">
		<header class="page-header">
			<h1 {...titleEdit}>{title}</h1>
		</header>

		{
			blocks.length > 0 ? (
				<div class="prose" {...page.edit.content}>
					<PortableText value={blocks} />
				</div>
			) : (
				Astro.locals.user && (
					<p class="page-empty">
						This page has no content yet. Add some in the editor, then publish.
					</p>
				)
			)
		}
	</Container>
</Section>

<style>
	.page-header {
		margin-bottom: var(--space-xl);
	}

	.page-header h1 {
		max-width: 20ch;
		font-size: var(--type-h2-size);
	}

	.page-empty {
		color: var(--ink-muted);
	}
</style>
