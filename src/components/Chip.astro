---
import type { FieldAnnotation } from "emdash";

interface Props {
	href?: string;
	selected?: boolean;
	class?: string;
	edit?: Partial<FieldAnnotation>;
}

const { href, selected = false, class: className, edit } = Astro.props;
---

{
	href ? (
		<a
			{href}
			class:list={["chip", selected && "chip--selected", className]}
			{...edit}
		>
			<slot />
		</a>
	) : (
		<span class:list={["chip", selected && "chip--selected", className]} {...edit}>
			<slot />
		</span>
	)
}

<style>
	.chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 36px;
		padding: 0 16px;
		border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
		border-radius: var(--radius-chip);
		background: transparent;
		color: var(--ink);
		font-size: var(--type-chip-size);
		font-weight: var(--type-chip-weight);
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color var(--transition),
			border-color var(--transition),
			color var(--transition);
	}

	a.chip:hover,
	.chip--selected {
		background: var(--green);
		border-color: var(--green);
		color: var(--on-accent);
	}
</style>
