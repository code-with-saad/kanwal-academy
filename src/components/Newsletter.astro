---
/**
 * Newsletter
 *
 * Footer-only capture: one email field, Subscribe button and a consent line
 * with a Privacy Policy link. Addresses are STORED ONLY in the EmDash
 * `subscribers` collection through the shared /api/enrol route
 * ({ type: "newsletter" }). No email is ever sent to subscribers.
 *
 * States: idle, invalid (message under the field), submitting (spinner),
 * success, error. Duplicates are accepted silently.
 */
import { env as hostEnv } from "virtual:emdash/env";

const runtimeEnv = hostEnv as Record<string, unknown> | undefined;
const buildEnv = import.meta.env as unknown as Record<string, string | undefined>;
const turnstileSiteKey = String(
	runtimeEnv?.PUBLIC_TURNSTILE_SITE_KEY ?? buildEnv.PUBLIC_TURNSTILE_SITE_KEY ?? "",
).trim();
---

<form class="newsletter" data-newsletter novalidate aria-labelledby="newsletter-heading">
	<h2 class="newsletter__heading" id="newsletter-heading">Stay in touch</h2>

	<div class="newsletter__row">
		<label class="visually-hidden" for="newsletter-email">Email address</label>
		<input
			class="newsletter__input"
			id="newsletter-email"
			name="email"
			type="email"
			inputmode="email"
			autocomplete="email"
			placeholder="you@example.com"
			maxlength="254"
			required
			aria-describedby="newsletter-status"
		/>
		<button class="newsletter__submit" type="submit" data-submit>
			<span class="newsletter__spinner" aria-hidden="true"></span>
			<span class="newsletter__label" data-label>Subscribe</span>
		</button>
	</div>

	<div class="newsletter__honeypot" aria-hidden="true">
		<label for="newsletter-website">Website</label>
		<input
			id="newsletter-website"
			name="website"
			type="text"
			tabindex="-1"
			autocomplete="off"
		/>
	</div>

	{
		turnstileSiteKey && (
			<div
				class="cf-turnstile newsletter__turnstile"
				data-sitekey={turnstileSiteKey}
				data-theme="auto"
			/>
		)
	}

	<p class="newsletter__status" id="newsletter-status" role="status" aria-live="polite" data-status></p>

	<p class="newsletter__consent">
		We only use your email to send occasional learning notes. Read our
		<a href="/privacy-policy">Privacy Policy</a>.
	</p>
</form>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-newsletter]");
	if (form) {
		const input = form.querySelector<HTMLInputElement>("#newsletter-email")!;
		const honeypot = form.querySelector<HTMLInputElement>("#newsletter-website")!;
		const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
		const label = form.querySelector<HTMLElement>("[data-label]")!;
		const status = form.querySelector<HTMLElement>("[data-status]")!;
		const turnstile = form.querySelector<HTMLElement>(".cf-turnstile");

		// Load the Turnstile widget only when a site key is configured.
		if (turnstile && !document.getElementById("cf-turnstile-newsletter")) {
			const script = document.createElement("script");
			script.id = "cf-turnstile-newsletter";
			script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
			script.async = true;
			script.defer = true;
			document.head.appendChild(script);
		}

		const setStatus = (message: string, tone: "" | "success" | "error") => {
			status.textContent = message;
			status.classList.toggle("is-success", tone === "success");
			status.classList.toggle("is-error", tone === "error");
			input.setAttribute("aria-invalid", tone === "error" && message ? "true" : "false");
		};

		const setBusy = (busy: boolean) => {
			submit.disabled = busy;
			submit.classList.toggle("is-loading", busy);
			submit.setAttribute("aria-busy", String(busy));
			label.textContent = busy ? "Subscribing" : "Subscribe";
		};

		const turnstileToken = () => {
			const api = (window as unknown as {
				turnstile?: { getResponse?: (element?: HTMLElement) => string | undefined };
			}).turnstile;
			return api?.getResponse?.(turnstile ?? undefined) ?? "";
		};

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (submit.disabled) return;

			const email = input.value.trim();
			const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
			if (!email || !emailRe.test(email)) {
				setStatus("Enter a valid email address.", "error");
				input.focus();
				return;
			}

			setStatus("", "");
			setBusy(true);
			try {
				const response = await fetch("/api/enrol", {
					method: "POST",
					headers: { "Content-Type": "application/json", Accept: "application/json" },
					body: JSON.stringify({
						type: "newsletter",
						email,
						website: honeypot.value,
						turnstileToken: turnstileToken(),
					}),
				});
				const data = (await response.json().catch(() => ({}))) as {
					ok?: boolean;
					message?: string;
				};

				if (response.ok && data.ok) {
					setStatus(data.message ?? "You are on the list. JazakAllah khair.", "success");
					form.reset();
					(
						window as unknown as {
							turnstile?: { reset?: (element?: HTMLElement) => void };
						}
					).turnstile?.reset?.(turnstile ?? undefined);
				} else {
					setStatus(
						data.message ?? "Something went wrong. Please try again.",
						"error",
					);
				}
			} catch {
				setStatus("We could not reach the server. Check your connection and try again.", "error");
			} finally {
				setBusy(false);
			}
		});
	}
</script>

<style>
	.newsletter {
		display: grid;
		gap: var(--space-sm);
		justify-items: start;
		width: 100%;
	}

	.newsletter__heading {
		margin: 0;
		color: var(--ink);
		font-size: var(--type-small-size);
		font-weight: 600;
		line-height: 1.2;
	}

	.newsletter__row {
		display: flex;
		gap: var(--space-xs);
		width: 100%;
	}

	.newsletter__input {
		flex: 1 1 auto;
		min-width: 0;
		height: 44px;
		padding: 0 14px;
		border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
		border-radius: var(--radius-input);
		background: var(--page);
		color: var(--ink);
		font: inherit;
		font-size: var(--type-small-size);
	}

	.newsletter__input[aria-invalid="true"] {
		border-color: #b3261e;
	}

	.newsletter__input:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.newsletter__submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-xs);
		flex: none;
		height: 44px;
		padding: 0 20px;
		border: 1px solid var(--green);
		border-radius: var(--radius-button);
		background: var(--green);
		color: var(--on-accent);
		font: inherit;
		font-size: var(--type-small-size);
		font-weight: 500;
		cursor: pointer;
		transition:
			background-color var(--transition),
			border-color var(--transition);
	}

	.newsletter__submit:hover,
	.newsletter__submit:focus-visible {
		background: var(--green-deep);
		border-color: var(--green-deep);
	}

	.newsletter__submit:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.newsletter__submit:disabled {
		cursor: progress;
		opacity: 0.72;
	}

	/* Spinner, never a skeleton loader. */
	.newsletter__spinner {
		display: none;
		width: 14px;
		height: 14px;
		border: 2px solid color-mix(in srgb, var(--on-accent) 40%, transparent);
		border-top-color: var(--on-accent);
		border-radius: 50%;
		animation: newsletter-spin 700ms linear infinite;
	}

	.newsletter__submit.is-loading .newsletter__spinner {
		display: inline-block;
	}

	@keyframes newsletter-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.newsletter__turnstile {
		margin-top: var(--space-xs);
	}

	.newsletter__status {
		min-height: 1.25em;
		margin: 0;
		color: var(--ink-muted);
		font-size: var(--type-small-size);
		line-height: 1.4;
	}

	.newsletter__status.is-success {
		color: var(--green-deep);
		font-weight: 500;
	}

	.newsletter__status.is-error {
		color: #a3341f;
		font-weight: 500;
	}

	:global(html[data-theme="dark"]) .newsletter__status.is-error {
		color: #ff9b8a;
	}

	.newsletter__consent {
		margin: 0;
		color: var(--ink-muted);
		font-size: var(--type-small-size);
		line-height: 1.5;
	}

	.newsletter__consent a {
		color: var(--green-deep);
	}

	.newsletter__honeypot {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	@media (max-width: 420px) {
		.newsletter__row {
			flex-direction: column;
		}

		.newsletter__submit {
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.newsletter__spinner {
			animation: none;
			border-top-color: transparent;
		}
	}
</style>
