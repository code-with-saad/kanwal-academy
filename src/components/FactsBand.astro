---
interface Fact {
	label: string;
	icon: "device" | "trial" | "price" | "globe";
}

interface Props {
	facts: Fact[];
}

const { facts } = Astro.props;
---

<ul class="facts">
	{
		facts.map((fact) => (
			<li class="fact">
				<span class="fact__icon" aria-hidden="true">
					<svg
						viewBox="0 0 32 32"
						width="32"
						height="32"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						{fact.icon === "device" && (
							<>
								<rect x="7" y="4.5" width="18" height="23" rx="3.5" />
								<circle cx="16" cy="9.5" r="2" />
								<path d="M11.5 23.5h9" />
							</>
						)}
						{fact.icon === "trial" && (
							<>
								<rect x="5" y="7" width="22" height="20" rx="4" />
								<path d="M5 13h22M11 4v5m10-5v5" />
								<path d="M12.5 20.5l2.5 2.5 4.5-4.5" />
							</>
						)}
						{fact.icon === "price" && (
							<>
								<circle cx="16" cy="16" r="11.5" />
								<path d="M16 8.5v15M19.4 12c-.7-.9-1.9-1.4-3.4-1.4-2.1 0-3.6 1-3.6 2.4s1.5 2.1 3.6 2.1 3.6.7 3.6 2.1-1.5 2.4-3.6 2.4c-1.5 0-2.7-.5-3.4-1.4" />
							</>
						)}
						{fact.icon === "globe" && (
							<>
								<circle cx="16" cy="16" r="11.5" />
								<ellipse cx="16" cy="16" rx="5" ry="11.5" />
								<path d="M4.5 16h23" />
							</>
						)}
					</svg>
				</span>
				<span class="fact__label">{fact.label}</span>
			</li>
		))
	}
</ul>

<style>
	.facts {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-lg);
		padding: clamp(24px, 3.4vw, 40px);
		border-radius: var(--radius-panel);
		background: var(--green);
		color: var(--on-accent);
	}

	.fact {
		display: grid;
		align-content: start;
		gap: var(--space-sm);
		padding-inline: clamp(0px, 1.6vw, 20px);
	}

	.fact + .fact {
		border-inline-start: 1px solid color-mix(in srgb, var(--on-accent) 26%, transparent);
	}

	.fact:first-child {
		padding-inline-start: 0;
	}

	.fact:last-child {
		padding-inline-end: 0;
	}

	.fact__icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		color: var(--on-accent);
	}

	.fact__label {
		font-size: var(--size-body);
		font-weight: 500;
		line-height: 1.35;
	}

	@media (max-width: 860px) {
		.facts {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-lg) var(--space-md);
		}

		.fact + .fact {
			border-inline-start: 0;
		}

		.fact {
			padding-inline: 0;
		}

		.fact:nth-child(even) {
			padding-inline-start: var(--space-md);
			border-inline-start: 1px solid color-mix(in srgb, var(--on-accent) 26%, transparent);
		}
	}

	@media (max-width: 460px) {
		.facts {
			gap: var(--space-md);
		}

		.fact__label {
			font-size: var(--size-small);
		}

		.fact__icon {
			width: 32px;
			height: 32px;
		}

		.fact__icon svg {
			width: 26px;
			height: 26px;
		}
	}
</style>
