---
import ResponsiveImage from "./ResponsiveImage.astro";

interface Props {
	src?: string;
	label: string;
	alt?: string;
	ratio?: string;
	eager?: boolean;
	sizes?: string;
	class?: string;
}

const {
	src,
	label,
	alt = "",
	ratio = "16 / 10",
	eager = false,
	sizes = "(max-width: 560px) calc(100vw - 32px), 480px",
	class: className,
} = Astro.props;

const altText = alt || label;
---

<figure class:list={["img-ph", className]} style={`--img-ph-ratio: ${ratio}`}>
	{
		src && (
			<ResponsiveImage
				src={src}
				alt={altText}
				class="img-ph__img"
				loading={eager ? "eager" : "lazy"}
				priority={eager}
				sizes={sizes}
			/>
		)
	}
	<div class="img-ph__box" data-img-ph-box hidden={Boolean(src)}>
		<svg
			class="img-ph__icon"
			viewBox="0 0 40 30"
			fill="none"
			aria-hidden="true"
			focusable="false"
		>
			<path
				d="M20 8.5C16.6 5.9 12 4.8 6 4.8v17.4c6 0 10.6 1.1 14 3.7 3.4-2.6 8-3.7 14-3.7V4.8c-6 0-10.6 1.1-14 3.7Z"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linejoin="round"
			/>
			<path d="M20 8.5v17.4" stroke="currentColor" stroke-width="1.4" />
			<path
				d="M12.5 28.5 20 25l7.5 3.5"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		</svg>
		<span class="img-ph__label">{label}</span>
	</div>
</figure>

<noscript>
	<style>
		.img-ph img {
			display: none;
		}
		.img-ph [data-img-ph-box][hidden] {
			display: grid;
		}
	</style>
</noscript>

<script>
	const images = document.querySelectorAll<HTMLImageElement>(".img-ph img");
	for (const img of images) {
		const box = img.closest(".img-ph")?.querySelector<HTMLElement>("[data-img-ph-box]");
		if (!box) continue;
		const swap = () => {
			img.hidden = true;
			box.hidden = false;
		};
		if (img.complete && img.naturalWidth === 0) swap();
		else img.addEventListener("error", swap, { once: true });
	}
</script>

<style>
	.img-ph {
		position: relative;
		margin: 0;
		aspect-ratio: var(--img-ph-ratio, 16 / 10);
		border-radius: var(--radius-card);
		overflow: clip;
	}

	:global(.img-ph__img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.img-ph__box {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: var(--space-sm);
		padding: var(--space-md);
		background: var(--mint-50);
		color: var(--ink-muted);
		text-align: center;
	}

	.img-ph__box[hidden] {
		display: none;
	}

	.img-ph__icon {
		width: 40px;
		height: auto;
		color: color-mix(in srgb, currentColor 55%, transparent);
	}

	.img-ph__label {
		max-width: 26ch;
		color: var(--ink-muted);
		font-size: var(--type-eyebrow-size);
		font-weight: 600;
		letter-spacing: var(--type-eyebrow-tracking);
		line-height: 1.5;
		text-transform: uppercase;
	}
</style>
