---
/**
 * A fixed-ratio image slot with a clearly labelled placeholder.
 *
 * Pass `src` when the file is expected in /public (for example
 * /images/hero-quran.png). While the file is missing, or if it ever fails to
 * load, a labelled placeholder box is shown instead of a broken image. Once
 * the real file is added to public/ and the site is redeployed, the image
 * appears without any code change.
 */
interface Props {
	src?: string;
	/** Short label shown inside the placeholder box. */
	label: string;
	/** Alt text for the real image. Falls back to the label. */
	alt?: string;
	/** CSS aspect-ratio value, for example "16 / 10". */
	ratio?: string;
	/** Load eagerly for above-the-fold images. */
	eager?: boolean;
	class?: string;
}

const {
	src,
	label,
	alt = "",
	ratio = "16 / 10",
	eager = false,
	class: className,
} = Astro.props;

const altText = alt || label;
---

<figure class:list={["img-ph", className]} style={`--img-ph-ratio: ${ratio}`}>
	{
		src && (
			<img
				class="img-ph__img"
				data-img-ph-img
				src={src}
				alt={altText}
				loading={eager ? "eager" : "lazy"}
				decoding="async"
			/>
		)
	}
	<div class="img-ph__box" data-img-ph-box hidden={Boolean(src)}>
		<svg
			class="img-ph__icon"
			viewBox="0 0 40 30"
			fill="none"
			aria-hidden="true"
			focusable="false"
		>
			<path
				d="M20 8.5C16.6 5.9 12 4.8 6 4.8v17.4c6 0 10.6 1.1 14 3.7 3.4-2.6 8-3.7 14-3.7V4.8c-6 0-10.6 1.1-14 3.7Z"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linejoin="round"
			/>
			<path d="M20 8.5v17.4" stroke="currentColor" stroke-width="1.4" />
			<path
				d="M12.5 28.5 20 25l7.5 3.5"
				stroke="currentColor"
				stroke-width="1.4"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		</svg>
		<span class="img-ph__label">{label}</span>
	</div>
</figure>

<noscript>
	<style>
		.img-ph [data-img-ph-img] {
			display: none;
		}
		.img-ph [data-img-ph-box][hidden] {
			display: grid;
		}
	</style>
</noscript>

<script>
	// Swap to the labelled placeholder when the image file is missing or fails.
	const images = document.querySelectorAll<HTMLImageElement>("[data-img-ph-img]");
	for (const img of images) {
		const box = img.closest(".img-ph")?.querySelector<HTMLElement>("[data-img-ph-box]");
		if (!box) continue;
		const swap = () => {
			img.hidden = true;
			box.hidden = false;
		};
		if (img.complete && img.naturalWidth === 0) swap();
		else img.addEventListener("error", swap, { once: true });
	}
</script>

<style>
	.img-ph {
		position: relative;
		margin: 0;
		aspect-ratio: var(--img-ph-ratio, 16 / 10);
	}

	.img-ph__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.img-ph__box {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: var(--space-sm);
		padding: var(--space-md);
		background: color-mix(in srgb, currentColor 7%, transparent);
		text-align: center;
	}

	.img-ph__box[hidden] {
		display: none;
	}

	.img-ph__icon {
		width: 40px;
		height: auto;
		color: color-mix(in srgb, currentColor 55%, transparent);
	}

	.img-ph__label {
		max-width: 26ch;
		color: color-mix(in srgb, currentColor 78%, transparent);
		font-size: var(--size-eyebrow);
		font-weight: 600;
		letter-spacing: var(--tracking-eyebrow);
		line-height: 1.5;
		text-transform: uppercase;
	}
</style>
