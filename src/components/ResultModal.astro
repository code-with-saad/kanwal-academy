---
/**
 * ResultModal
 *
 * The form itself lives inline in the #book section. This dialog is only for
 * the RESULT of a submission:
 *
 *   success       thank you + close
 *   error         message + retry + WhatsApp link
 *   rate limited  message + close + WhatsApp link
 *
 * Any script on the page opens it with:
 *
 *   document.dispatchEvent(new CustomEvent("show-result", {
 *     detail: { state: "success" | "error" | "rate", message?: string },
 *   }));
 *
 * "Retry" fires a `book-retry` event (the inline form listens and resubmits).
 * Escape closes. Focus is trapped while open and restored to the trigger on
 * close.
 */

interface Props {
	whatsappPhone?: string;
}

import { useUi } from "../i18n";

const { t } = useUi(Astro);
const { whatsappPhone = "" } = Astro.props;

const waHref = whatsappPhone
	? `https://wa.me/${whatsappPhone.replace(/[^0-9]/g, "")}`
	: "";
---

<dialog id="result-modal" class="rm" aria-labelledby="rm-title" aria-modal="true">
	<div class="rm__inner">
		<button type="button" class="rm__close" data-rm-close aria-label={t.actions.close}>
			<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
				<path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
			</svg>
		</button>

		<!-- Success -->
		<div class="rm__panel" data-rm-panel="success" hidden>
			<svg class="rm__icon" viewBox="0 0 48 48" width="52" height="52" fill="none" aria-hidden="true">
				<circle cx="24" cy="24" r="22" stroke="var(--green)" stroke-width="2"/>
				<path d="M14 24l7 7 13-14" stroke="var(--green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
			<h2 class="rm__title" id="rm-title">{t.modal.successTitle}</h2>
			<p class="rm__body" data-rm-success-text>
				{t.modal.successBody}
			</p>
			<button type="button" class="rm__btn rm__btn--primary" data-rm-close>{t.actions.close}</button>
		</div>

		<!-- Error -->
		<div class="rm__panel" data-rm-panel="error" hidden>
			<svg class="rm__icon" viewBox="0 0 48 48" width="52" height="52" fill="none" aria-hidden="true">
				<circle cx="24" cy="24" r="22" stroke="#b3261e" stroke-width="2"/>
				<path d="M24 14v14m0 6v.5" stroke="#b3261e" stroke-width="2.5" stroke-linecap="round"/>
			</svg>
			<h2 class="rm__title">{t.modal.errorTitle}</h2>
			<p class="rm__body" data-rm-error-text>{t.modal.errorBody}</p>
			<div class="rm__actions">
				<button type="button" class="rm__btn rm__btn--primary" data-rm-retry>{t.actions.tryAgain}</button>
				{
					waHref && (
						<a href={waHref} class="rm__btn rm__btn--outline" target="_blank" rel="noopener noreferrer">
							{t.modal.whatsapp}
						</a>
					)
				}
			</div>
		</div>

		<!-- Rate limited -->
		<div class="rm__panel" data-rm-panel="rate" hidden>
			<svg class="rm__icon" viewBox="0 0 48 48" width="52" height="52" fill="none" aria-hidden="true">
				<circle cx="24" cy="24" r="22" stroke="var(--green-deep)" stroke-width="2"/>
				<path d="M24 14v11l7 4" stroke="var(--green-deep)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
			<h2 class="rm__title">{t.modal.rateTitle}</h2>
			<p class="rm__body" data-rm-rate-text>
				{t.modal.rateBody}
			</p>
			<div class="rm__actions">
				<button type="button" class="rm__btn rm__btn--primary" data-rm-close>{t.actions.close}</button>
				{
					waHref && (
						<a href={waHref} class="rm__btn rm__btn--outline" target="_blank" rel="noopener noreferrer">
							{t.modal.whatsapp}
						</a>
					)
				}
			</div>
		</div>
	</div>
</dialog>

<script>
	type ResultState = "success" | "error" | "rate";
	document.addEventListener("show-result", (event) => {
		const { state, message } =
			(event as CustomEvent<{ state?: ResultState; message?: string }>).detail ?? {};
		if (state !== "success" && state !== "error" && state !== "rate") return;
		void import("../scripts/result-modal")
			.then(({ showResultModal }) => showResultModal(state, message))
			.catch((error: unknown) => console.error("Could not load the result dialog", error));
	});
</script>

<style>
	/* ---- Dialog shell --------------------------------------------------- */
	.rm {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: none;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: 100%;
		height: 100%;
		max-height: 100%;
		margin: 0;
		padding: 0;
		border: none;
		background: transparent;
		overflow: hidden;
	}

	.rm[open] {
		display: flex;
	}

	.rm::backdrop {
		background: color-mix(in srgb, var(--ink) 48%, transparent);
	}

	.rm__inner {
		position: relative;
		width: min(480px, calc(100vw - 24px));
		max-height: calc(100dvh - 24px);
		overflow-y: auto;
		overscroll-behavior: contain;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-panel);
		box-shadow: 0 24px 64px -16px rgba(11, 26, 20, 0.28);
	}

	.rm__close {
		position: absolute;
		top: 16px;
		inset-inline-end: 16px;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
		transition:
			background-color var(--transition),
			border-color var(--transition);
	}

	.rm__close:hover {
		background: var(--mint-50);
		border-color: var(--green);
	}

	.rm__close:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	/* ---- Panels ---------------------------------------------------------- */
	.rm__panel {
		display: grid;
		justify-items: center;
		gap: var(--space-md);
		padding: clamp(28px, 6vw, 40px);
		text-align: center;
	}

	.rm__panel[hidden] {
		display: none;
	}

	.rm__icon {
		margin-bottom: var(--space-2xs);
	}

	.rm__title {
		margin: 0;
		font-size: var(--type-h3-size);
		font-weight: var(--type-card-title-weight);
		line-height: var(--type-card-title-line);
	}

	.rm__body {
		max-width: 38ch;
		margin: 0;
		color: var(--type-copy-color);
		line-height: var(--type-body-line);
	}

	.rm__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-sm);
		width: 100%;
	}

	/* ---- Buttons ---------------------------------------------------------- */
	.rm__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 48px;
		padding: 0 28px;
		border: 1px solid var(--green);
		border-radius: var(--radius-button);
		background: var(--green);
		color: var(--on-accent);
		font: inherit;
		font-size: var(--type-button-size);
		font-weight: var(--type-button-weight);
		text-decoration: none;
		cursor: pointer;
		transition:
			background-color var(--transition),
			border-color var(--transition);
	}

	.rm__btn:hover {
		background: var(--green-deep);
		border-color: var(--green-deep);
	}

	.rm__btn:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 3px;
	}

	.rm__btn--outline {
		background: transparent;
		border-color: color-mix(in srgb, var(--ink) 20%, transparent);
		color: var(--green-deep);
	}

	.rm__btn--outline:hover {
		background: var(--mint-50);
		border-color: var(--green);
	}

	@media (max-width: 420px) {
		.rm__actions {
			flex-direction: column;
		}

		.rm__btn {
			width: 100%;
		}
	}

	:global(body[data-modal-open]) {
		overflow: hidden;
	}
</style>
