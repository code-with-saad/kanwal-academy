---
interface Props {
	id?: string;
	tone?: "cream" | "sand" | "dark";
	space?: "normal" | "tight" | "flush";
	class?: string;
}

const { id, tone = "cream", space = "normal", class: className } = Astro.props;
---

<section
	id={id}
	class:list={[
		"section",
		`section--${tone}`,
		`section--space-${space}`,
		tone === "dark" && "tone-dark",
		className,
	]}
>
	<slot />
</section>

<style>
	.section {
		background: var(--page);
		color: var(--ink);
	}

	.section--cream {
		background: var(--page);
	}

	.section--sand {
		background: var(--band);
		/* Sage-deep is 3.85:1 on the light sand band; darken it for small labels. */
		--accent: color-mix(in srgb, var(--sage-deep) 80%, var(--ink));
	}

	:global(html[data-theme="dark"]) .section--sand {
		--accent: var(--sage);
	}

	.section--dark {
		background: var(--bg-dark);
	}

	.section--space-normal {
		padding-block: var(--section-space);
	}

	.section--space-tight {
		padding-block: var(--space-3xl);
	}

	.section--space-flush {
		padding-block: 0;
	}
</style>
