---
interface Props {
	id?: string;
	tone?: "cream" | "sand" | "mint" | "dark";
	space?: "normal" | "tight" | "flush";
	class?: string;
}

const { id, tone = "cream", space = "normal", class: className } = Astro.props;
---

<section
	id={id}
	class:list={[
		"section",
		`section--${tone}`,
		`section--space-${space}`,
		tone === "dark" && "tone-dark",
		className,
	]}
>
	<slot />
</section>

<style>
	.section {
		background: var(--page);
		color: var(--ink);
	}

	.section--cream {
		background: var(--page);
	}

	.section--sand {
		background: var(--mint-100);
	}

	.section--mint {
		background: var(--mint-300);
	}

	.section--dark {
		background: var(--deep);
	}

	.section--space-normal {
		padding-block: var(--section-space);
	}

	.section--space-tight {
		padding-block: var(--space-3xl);
	}

	.section--space-flush {
		padding-block: 0;
	}
</style>
