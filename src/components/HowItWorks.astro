---
import { useUi } from "../i18n";

const { t } = useUi(Astro);

interface StepItem {
	title: string;
	text: string;
	icon: "book-trial" | "teacher" | "calendar-check";
}

interface Props {
	eyebrow?: string;
	heading?: string;
	steps?: StepItem[];
}

const defaultSteps: StepItem[] = [
	{
		title: t.home.trial_step_1_title,
		text: t.home.trial_step_1_body,
		icon: "book-trial",
	},
	{
		title: t.home.trial_step_2_title,
		text: t.home.trial_step_2_body,
		icon: "teacher",
	},
	{
		title: t.home.trial_step_3_title,
		text: t.home.trial_step_3_body,
		icon: "calendar-check",
	},
];

const icons: StepItem["icon"][] = ["book-trial", "teacher", "calendar-check"];

const {
	eyebrow = t.home.trial_eyebrow,
	heading = t.home.trial_heading,
	steps = defaultSteps,
} = Astro.props;
---

<div class="trial-steps" data-reveal="fade">
	<span class="trial-steps__eyebrow">
		<span class="trial-steps__eyebrow-rule" aria-hidden="true"></span>
		{eyebrow}
	</span>
	<h2 class="trial-steps__title" data-reveal-words>{heading}</h2>

	<!-- Desktop: horizontal cards with centered numbers and connector line -->
	<ol class="trial-steps__desktop">
		{
			steps.map((step, i) => (
				<li
					class="trial-steps__card"
					style={`--step-index: ${i}`}
					data-reveal="up"
					data-reveal-delay={200 + i * 120}
				>
					<span class="trial-steps__number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>

					<div class="trial-steps__icon" aria-hidden="true">
						{(step.icon ?? icons[i] ?? "book-trial") === "book-trial" && (
							<svg viewBox="0 0 48 48" width="36" height="36" fill="none" stroke="var(--green-deep)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<rect x="8" y="10" width="32" height="26" rx="3" />
								<path d="M8 18h32" />
								<circle cx="30" cy="30" r="8" fill="var(--mint-100)" stroke="var(--green-deep)" />
								<path d="M30 26v4l2.5 2" />
							</svg>
						)}
						{(step.icon ?? icons[i] ?? "book-trial") === "teacher" && (
							<svg viewBox="0 0 48 48" width="36" height="36" fill="none" stroke="var(--green-deep)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<rect x="4" y="8" width="32" height="24" rx="3" />
								<circle cx="20" cy="18" r="4" />
								<path d="M12 32v-3a5 5 0 0 1 10 0v3" />
								<circle cx="36" cy="32" r="8" fill="var(--mint-100)" stroke="var(--green-deep)" />
								<circle cx="36" cy="29" r="2" fill="var(--green-deep)" stroke="none" />
								<path d="M32 35h8" />
							</svg>
						)}
						{(step.icon ?? icons[i] ?? "book-trial") === "calendar-check" && (
							<svg viewBox="0 0 48 48" width="36" height="36" fill="none" stroke="var(--green-deep)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<rect x="8" y="10" width="32" height="26" rx="3" />
								<path d="M8 18h32" />
								<path d="M16 6v6" />
								<path d="M32 6v6" />
								<circle cx="34" cy="32" r="8" fill="var(--mint-100)" stroke="var(--green-deep)" />
								<path d="M31 32l2 2 4-4" />
							</svg>
						)}
					</div>

					<h3 class="trial-steps__card-title">{step.title}</h3>
					<p class="trial-steps__card-text">{step.text}</p>
				</li>
			))
		}
	</ol>

	<!-- Mobile: vertical timeline -->
	<ol class="trial-steps__mobile">
		{
			steps.map((step, i) => (
				<li
					class="trial-steps__mobile-step"
					style={`--step-index: ${i}`}
					data-reveal="up"
					data-reveal-delay={200 + i * 120}
				>
					<div class="trial-steps__mobile-rail">
						<span class="trial-steps__number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
						<span class="trial-steps__connector" aria-hidden="true"></span>
					</div>
					<div class="trial-steps__mobile-card">
						<h3 class="trial-steps__card-title">{step.title}</h3>
						<p class="trial-steps__card-text">{step.text}</p>
					</div>
				</li>
			))
		}
	</ol>
</div>

<style>
	.trial-steps {
		display: grid;
		gap: clamp(32px, 5vw, 56px);
	}

	.trial-steps__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--green-deep);
		font-size: var(--type-eyebrow-size);
		font-weight: 600;
		letter-spacing: var(--type-eyebrow-tracking);
		line-height: 1.2;
		text-transform: uppercase;
	}

	.trial-steps__eyebrow-rule {
		width: 22px;
		height: 1px;
		background: currentColor;
	}

	.trial-steps__title {
		margin-top: var(--space-md);
	}

	/* ========== DESKTOP ========== */
	.trial-steps__desktop {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		--steps-gap: clamp(16px, 3vw, 32px);
		gap: var(--steps-gap);
		align-items: start;
		position: relative;
		width: 100%;
	}

	/* Dotted connectors sit between cards at the number-circle center. */
	.trial-steps__card:not(:last-child)::after {
		content: "";
		position: absolute;
		top: 24px;
		inset-inline-end: 100%;
		width: var(--steps-gap);
		border-top: 2px dotted var(--green);
	}

	.trial-steps__card {
		position: relative;
		display: grid;
		align-content: start;
		gap: var(--space-md);
		padding: 48px 28px 28px;
		border-radius: 24px;
		border: 1px solid var(--line);
		background: var(--surface);
		box-shadow: 0 12px 32px -16px rgba(11, 26, 20, 0.12);
		transition:
			transform var(--transition),
			box-shadow var(--transition);
		z-index: 1;
	}

	.trial-steps__card:hover {
		transform: translateY(-3px);
		box-shadow: 0 16px 40px -16px rgba(11, 26, 20, 0.18);
	}

	/* Numbered circle: centered at top, full circle */
	.trial-steps__number {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: var(--green);
		color: #ffffff;
		font-size: 16px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		line-height: 1;
		z-index: 2;
	}

	/* Icon at top right */
	.trial-steps__icon {
		justify-self: end;
		margin-top: -8px;
	}

	.trial-steps__card-title {
		font-size: var(--type-h3-size);
		font-weight: 500;
		margin-top: 8px;
	}

	.trial-steps__card-text {
		color: var(--ink-muted);
		font-size: var(--type-small-size);
		line-height: 1.6;
		max-width: 38ch;
	}

	/* ========== MOBILE TIMELINE ========== */
	.trial-steps__mobile {
		display: none;
	}

	/* ========== BREAKPOINTS ========== */
	@media (max-width: 768px) {
		.trial-steps__desktop {
			display: none;
		}

		.trial-steps__mobile {
			display: grid;
			gap: 16px;
			width: 100%;
		}

		.trial-steps__mobile-step {
			display: grid;
			grid-template-columns: 48px 1fr;
			gap: 16px;
			position: relative;
		}

		.trial-steps__mobile-rail {
			display: flex;
			flex-direction: column;
			align-items: center;
			margin-inline-end: 4px;
		}

		.trial-steps__mobile-step .trial-steps__number {
			position: relative;
			top: auto;
			left: auto;
			inset-inline-start: auto;
			transform: none;
			width: 48px;
			height: 48px;
			z-index: 2;
		}

		/* Connector line between number circles */
		.trial-steps__connector {
			position: relative;
			width: 0;
			flex: 1;
			margin-top: 8px;
			border-inline-start: 2px dotted var(--green);
			opacity: 0.4;
		}

		.trial-steps__mobile-step:last-child .trial-steps__connector {
			display: none;
		}

		.trial-steps__mobile-card {
			padding: 20px;
			border-radius: 20px;
			border: 1px solid var(--line);
			background: var(--surface);
			box-shadow: 0 8px 24px -12px rgba(11, 26, 20, 0.1);
		}

		.trial-steps__mobile-card .trial-steps__card-title {
			margin-top: 0;
		}
	}

	/* Dark theme */
	:global(html[data-theme="dark"]) .trial-steps__number {
		background: var(--green);
		color: var(--on-accent);
	}

	:global(html[data-theme="dark"]) .trial-steps__icon svg {
		stroke: var(--green);
	}

	:global(html[data-theme="dark"]) .trial-steps__connector {
		border-color: var(--green);
	}

	@media (prefers-reduced-motion: reduce) {
		.trial-steps__card,
		.trial-steps__mobile-card {
			transition: none;
		}

	}
</style>
