---
interface StepItem {
	number: string;
	title: string;
	text: string;
	icon: "book-trial" | "teacher" | "calendar-check";
}

const steps: StepItem[] = [
	{
		number: "01",
		title: "Book your free trial",
		text: "Choose a plan and pick a time that works for you. The trial class is free.",
		icon: "book-trial",
	},
	{
		number: "02",
		title: "Meet your teacher",
		text: "We match you with a teacher for your course and level, then assess where you are.",
		icon: "teacher",
	},
	{
		number: "03",
		title: "Start your plan",
		text: "Your teacher builds a weekly schedule around your goals and keeps you accountable.",
		icon: "calendar-check",
	},
];
---

<div class="trial-steps" data-reveal="fade">
	<span class="trial-steps__eyebrow">
		<span class="trial-steps__eyebrow-rule" aria-hidden="true"></span>
		Free trial
	</span>
	<h2 class="trial-steps__title" data-reveal-words>How the free trial works</h2>

	<!-- Desktop: horizontal cards with connectors -->
	<ol class="trial-steps__desktop">
		<!-- Connector lines between cards -->
		<span class="trial-steps__connectors" aria-hidden="true">
			<span class="trial-steps__connector-line trial-steps__connector-line--dotted"></span>
			<span class="trial-steps__connector-line trial-steps__connector-line--solid"></span>
		</span>
		{
			steps.map((step, i) => (
				<li
					class="trial-steps__card"
					style={`--step-index: ${i}`}
					data-reveal="up"
					data-reveal-delay={200 + i * 120}
				>
					<span class="trial-steps__number" aria-hidden="true">{step.number}</span>

					<div class="trial-steps__icon" aria-hidden="true">
						{step.icon === "book-trial" && (
							<svg viewBox="0 0 48 48" width="36" height="36" fill="none" stroke="var(--green-deep)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<rect x="8" y="10" width="32" height="26" rx="3" />
								<path d="M8 18h32" />
								<circle cx="30" cy="30" r="8" fill="var(--mint-100)" stroke="var(--green-deep)" />
								<path d="M30 26v4l2.5 2" />
							</svg>
						)}
						{step.icon === "teacher" && (
							<svg viewBox="0 0 48 48" width="36" height="36" fill="none" stroke="var(--green-deep)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<rect x="4" y="8" width="32" height="24" rx="3" />
								<circle cx="20" cy="18" r="4" />
								<path d="M12 32v-3a5 5 0 0 1 10 0v3" />
								<circle cx="36" cy="32" r="8" fill="var(--mint-100)" stroke="var(--green-deep)" />
								<circle cx="36" cy="29" r="2" fill="var(--green-deep)" stroke="none" />
								<path d="M32 35h8" />
							</svg>
						)}
						{step.icon === "calendar-check" && (
							<svg viewBox="0 0 48 48" width="36" height="36" fill="none" stroke="var(--green-deep)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<rect x="8" y="10" width="32" height="26" rx="3" />
								<path d="M8 18h32" />
								<path d="M16 6v6" />
								<path d="M32 6v6" />
								<circle cx="34" cy="32" r="8" fill="var(--mint-100)" stroke="var(--green-deep)" />
								<path d="M31 32l2 2 4-4" />
							</svg>
						)}
					</div>

					<h3 class="trial-steps__card-title">{step.title}</h3>
					<p class="trial-steps__card-text">{step.text}</p>
				</li>
			))
		}
	</ol>

	<!-- Mobile: vertical timeline -->
	<ol class="trial-steps__mobile">
		{
			steps.map((step, i) => (
				<li
					class="trial-steps__mobile-step"
					style={`--step-index: ${i}`}
					data-reveal="up"
					data-reveal-delay={200 + i * 120}
				>
					<div class="trial-steps__mobile-rail">
						<span class="trial-steps__number" aria-hidden="true">{step.number}</span>
						<span class="trial-steps__connector" aria-hidden="true"></span>
					</div>
					<div class="trial-steps__mobile-card">
						<h3 class="trial-steps__card-title">{step.title}</h3>
						<p class="trial-steps__card-text">{step.text}</p>
					</div>
				</li>
			))
		}
	</ol>
</div>

<style>
	.trial-steps {
		display: grid;
		gap: clamp(32px, 5vw, 56px);
	}

	.trial-steps__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--green-deep);
		font-size: var(--type-eyebrow-size);
		font-weight: 600;
		letter-spacing: var(--type-eyebrow-tracking);
		line-height: 1.2;
		text-transform: uppercase;
	}

	.trial-steps__eyebrow-rule {
		width: 22px;
		height: 1px;
		background: currentColor;
	}

	.trial-steps__title {
		margin-top: var(--space-md);
	}

	/* ========== DESKTOP ========== */
	.trial-steps__desktop {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(16px, 3vw, 32px);
		align-items: start;
		position: relative;
		width: 100%;
	}

	/* Connector overlay: sits between cards at number-circle height */
	.trial-steps__connectors {
		position: absolute;
		top: 24px; /* center of 48px number circle */
		left: 0;
		right: 0;
		height: 2px;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(16px, 3vw, 32px);
		pointer-events: none;
		z-index: 0;
	}

	.trial-steps__connector-line {
		position: relative;
		height: 2px;
	}

	.trial-steps__connector-line::after {
		content: "";
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
	}

	/* Dotted line from 01 to 02: spans the gap between card 1 and card 2 */
	.trial-steps__connector-line--dotted {
		grid-column: 1;
	}

	.trial-steps__connector-line--dotted::after {
		left: 50%;
		border-top: 2px dotted var(--green);
		opacity: 0.5;
	}

	/* Solid line from 02 to 03: spans the gap between card 2 and card 3 */
	.trial-steps__connector-line--solid {
		grid-column: 2;
	}

	.trial-steps__connector-line--solid::after {
		left: 50%;
		background: var(--green);
	}

	/* Line draw animation */
	.js-motion .trial-steps__connector-line::after {
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform var(--dur-slow) var(--ease);
		transition-delay: 600ms;
	}

	.js-motion .trial-steps.is-revealed .trial-steps__connector-line::after {
		transform: scaleX(1);
	}

	.js-motion .trial-steps__connector-line--solid::after {
		transition-delay: 800ms;
	}

	.trial-steps__card {
		position: relative;
		display: grid;
		align-content: start;
		gap: var(--space-md);
		padding: 40px 28px 28px;
		margin-top: 24px;
		border-radius: 24px;
		border: 1px solid var(--line);
		background: var(--surface);
		box-shadow: 0 12px 32px -16px rgba(11, 26, 20, 0.12);
		transition:
			transform var(--transition),
			box-shadow var(--transition);
	}

	.trial-steps__card:hover {
		transform: translateY(-3px);
		box-shadow: 0 16px 40px -16px rgba(11, 26, 20, 0.18);
	}

	/* Numbered circle overlapping top edge */
	.trial-steps__number {
		position: absolute;
		top: -24px;
		left: 24px;
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: var(--green);
		color: #ffffff;
		font-size: 16px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		line-height: 1;
		z-index: 2;
	}

	/* Icon at top right */
	.trial-steps__icon {
		justify-self: end;
		margin-top: -4px;
	}

	.trial-steps__card-title {
		font-size: var(--type-h3-size);
		font-weight: 500;
		margin-top: 8px;
	}

	.trial-steps__card-text {
		color: var(--ink-muted);
		font-size: var(--type-small-size);
		line-height: 1.6;
		max-width: 38ch;
	}

	/* ========== MOBILE TIMELINE ========== */
	.trial-steps__mobile {
		display: none;
	}

	/* ========== BREAKPOINTS ========== */
	@media (max-width: 768px) {
		.trial-steps__desktop {
			display: none;
		}

		.trial-steps__mobile {
			display: grid;
			gap: 0;
			width: 100%;
		}

		.trial-steps__mobile-step {
			display: grid;
			grid-template-columns: 48px 1fr;
			gap: 16px;
			position: relative;
		}

		.trial-steps__mobile-rail {
			display: grid;
			justify-items: center;
		}

		.trial-steps__mobile-step .trial-steps__number {
			position: relative;
			top: auto;
			left: auto;
			width: 48px;
			height: 48px;
			z-index: 2;
		}

		/* Connector line between number circles */
		.trial-steps__connector {
			position: relative;
			width: 2px;
			flex: 1;
			margin-top: 8px;
		}

		.trial-steps__mobile-step:nth-child(1) .trial-steps__connector {
			border-left: 2px dotted var(--green);
			opacity: 0.5;
		}

		.trial-steps__mobile-step:nth-child(2) .trial-steps__connector {
			border-left: 2px solid var(--green);
		}

		.trial-steps__mobile-step:last-child .trial-steps__connector {
			display: none;
		}

		.trial-steps__mobile-card {
			padding: 20px;
			border-radius: 20px;
			border: 1px solid var(--line);
			background: var(--surface);
			box-shadow: 0 8px 24px -12px rgba(11, 26, 20, 0.1);
		}

		.trial-steps__mobile-card .trial-steps__card-title {
			margin-top: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.trial-steps__card,
		.trial-steps__mobile-card {
			transition: none;
		}

		.js-motion .trial-steps__connector-line::after {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	/* Dark theme */
	:global(html[data-theme="dark"]) .trial-steps__number {
		background: var(--green);
		color: var(--on-accent);
	}

	:global(html[data-theme="dark"]) .trial-steps__icon svg {
		stroke: var(--green);
	}

	:global(html[data-theme="dark"]) .trial-steps__connector-line--dotted::after {
		border-top-color: var(--green);
	}

	:global(html[data-theme="dark"]) .trial-steps__connector-line--solid::after {
		background: var(--green);
	}

	:global(html[data-theme="dark"]) .trial-steps__mobile-step:nth-child(1) .trial-steps__connector {
		border-left-color: var(--green);
	}

	:global(html[data-theme="dark"]) .trial-steps__mobile-step:nth-child(2) .trial-steps__connector {
		border-left-color: var(--green);
	}
</style>
