---
/**
 * Flat mint panel with a checked list: "what every plan includes" and
 * similar assurance blocks. Same panel language as the About sections
 * (radius 28, flat tint, custom check marks, no gradients).
 */
import Eyebrow from "./Eyebrow.astro";

interface Props {
	eyebrow?: string;
	heading: string;
	lead?: string;
	items: string[];
}

const { eyebrow, heading, lead, items } = Astro.props;
---

<div class="includes">
	<div class="includes__head">
		{eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
		<h2>{heading}</h2>
		{lead && <p class="includes__lead">{lead}</p>}
	</div>
	<ul class="includes__list">
		{
			items.map((item, i) => (
				<li class="includes__item" data-reveal="up" data-reveal-delay={i * 80}>
					<span class="includes__check" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="9" />
							<path d="M8.5 12.2l2.4 2.4 4.6-4.8" />
						</svg>
					</span>
					<span>{item}</span>
				</li>
			))
		}
	</ul>
</div>

<style>
	.includes {
		padding: clamp(24px, 4vw, 40px);
		border-radius: var(--radius-panel);
		background: var(--mint-100);
	}

	.includes__head {
		display: grid;
		justify-items: start;
		gap: var(--space-md);
		max-width: 56ch;
		margin-bottom: var(--space-xl);
	}

	.includes__lead {
		color: var(--type-copy-color);
	}

	.includes__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-md) clamp(24px, 4vw, 56px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.includes__item {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		padding-block: 10px;
		border-top: 1px solid var(--line);
		font-size: var(--type-body-size);
		line-height: var(--type-body-line);
	}

	.includes__check {
		flex: none;
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 999px;
		background: var(--surface);
		color: var(--green-deep);
	}

	.includes__check svg {
		width: 18px;
		height: 18px;
	}

	@media (max-width: 760px) {
		.includes__list {
			grid-template-columns: 1fr;
		}
	}
</style>