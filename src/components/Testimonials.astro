---
import Container from "./Container.astro";

interface Review {
	quote: string;
	author: string;
	country?: string | null;
}

interface Props {
	reviews: Review[];
	demo?: boolean;
}

const { reviews, demo = false } = Astro.props;

const placeholder: Review = {
	quote: "Placeholder, replace with a real review",
	author: "Demo placeholder",
	country: "",
};

const items = reviews.length > 0 ? reviews : demo ? [placeholder] : [];
const isDemoCard = reviews.length === 0 && demo;

const initials = (name: string) =>
	name
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part[0]?.toUpperCase() ?? "")
		.join("") || "?";

const reviewsJson = JSON.stringify(items).replace(/</g, "\\u003c");
---

{
	items.length > 0 && (
		<section class="testimonials" aria-labelledby="testimonials-title">
			<Container>
				<div class="testimonials__panel" data-testimonials data-reveal="fade">
					<h2 class="visually-hidden" id="testimonials-title">
						Student reviews
					</h2>
					<span class="testimonials__glyph" aria-hidden="true">
						&ldquo;
					</span>

					<div class="testimonials__main">
						<div class="testimonials__quote-area" data-quote-area>
							<div
								id="testimonial-panel"
								role="tabpanel"
								aria-labelledby="review-tab-0"
							>
								<blockquote class="testimonials__blockquote">
									<p class="testimonials__quote" data-quote>
										{items[0]?.quote}
									</p>
									<footer class="testimonials__author">
										<cite class="testimonials__name" data-author>
											{items[0]?.author}
										</cite>
										<span class="testimonials__country" data-country>
											{items[0]?.country}
										</span>
										{isDemoCard && <span class="testimonials__flag">Demo placeholder</span>}
									</footer>
								</blockquote>
							</div>

							{
								items.length > 1 && (
									<div class="testimonials__progress" aria-hidden="true">
										<span class="testimonials__progress-bar" data-progress />
									</div>
								)
							}
						</div>

						<div class="testimonials__side">
							<div
								class="testimonials__avatars"
								role="tablist"
								aria-label="Choose a review"
								aria-orientation="vertical"
								data-tablist
							>
								{items.length > 1 && (
									<span class="testimonials__indicator" aria-hidden="true" data-indicator />
								)}
								{items.map((item, index) => (
									<button
										type="button"
										role="tab"
										class="testimonials__avatar"
										id={`review-tab-${index}`}
										aria-controls="testimonial-panel"
										aria-selected={index === 0 ? "true" : "false"}
										aria-label={`Review by ${item.author}`}
										tabindex={index === 0 ? 0 : -1}
										data-tab
										data-index={index}
									>
										<span aria-hidden="true">{initials(item.author)}</span>
									</button>
								))}
							</div>

							{
								items.length > 1 && (
									<div class="testimonials__controls">
										<button
											type="button"
											class="testimonials__control"
											data-pause
											aria-label="Pause automatic reviews"
											aria-pressed="false"
										>
											<svg
												viewBox="0 0 16 16"
												width="14"
												height="14"
												aria-hidden="true"
												focusable="false"
											>
												<path
													class="testimonials__icon-pause"
													d="M5 3v10M11 3v10"
													fill="none"
													stroke="currentColor"
													stroke-width="1.8"
													stroke-linecap="round"
												/>
												<path
													class="testimonials__icon-play"
													d="M5.5 3.5 12 8l-6.5 4.5z"
													fill="currentColor"
													stroke="currentColor"
													stroke-width="1"
													stroke-linejoin="round"
												/>
											</svg>
										</button>
										<button
											type="button"
											class="testimonials__control"
											data-prev
											aria-label="Previous review"
										>
											<svg
												viewBox="0 0 16 16"
												width="14"
												height="14"
												aria-hidden="true"
												focusable="false"
											>
												<path
													d="M10 3.5 5.5 8l4.5 4.5"
													fill="none"
													stroke="currentColor"
													stroke-width="1.6"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
										</button>
										<button
											type="button"
											class="testimonials__control"
											data-next
											aria-label="Next review"
										>
											<svg
												viewBox="0 0 16 16"
												width="14"
												height="14"
												aria-hidden="true"
												focusable="false"
											>
												<path
													d="M6 3.5 10.5 8 6 12.5"
													fill="none"
													stroke="currentColor"
													stroke-width="1.6"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
										</button>
									</div>
								)
							}
						</div>
					</div>

					<script type="application/json" data-reviews is:inline set:html={reviewsJson}></script>
				</div>
			</Container>
		</section>
	)
}

<script>
	type Review = { quote: string; author: string; country?: string | null };

	const INITIALS_SELECTOR = "[data-tab]";

	for (const root of document.querySelectorAll<HTMLElement>("[data-testimonials]")) {
		const dataElement = root.querySelector<HTMLScriptElement>("[data-reviews]");
		const quote = root.querySelector<HTMLElement>("[data-quote]");
		const author = root.querySelector<HTMLElement>("[data-author]");
		const country = root.querySelector<HTMLElement>("[data-country]");
		const quoteArea = root.querySelector<HTMLElement>("[data-quote-area]");
		const progress = root.querySelector<HTMLElement>("[data-progress]");
		const indicator = root.querySelector<HTMLElement>("[data-indicator]");
		const pause = root.querySelector<HTMLButtonElement>("[data-pause]");
		const tablist = root.querySelector<HTMLElement>("[data-tablist]");
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(INITIALS_SELECTOR));

		if (!dataElement || !quote || !author || !country || tabs.length === 0) continue;

		let reviews: Review[] = [];
		try {
			reviews = JSON.parse(dataElement.textContent ?? "[]") as Review[];
		} catch {
			continue;
		}
		if (reviews.length === 0) continue;

		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const advanceMs = 8000;
		let active = 0;
		let timer: number | undefined;
		let hovered = false;
		let focused = false;
		let manuallyPaused = false;
		let fadeTimer: number | undefined;

		const restartProgress = () => {
			if (!progress || reduceMotion) return;
			progress.style.animation = "none";
			void progress.offsetWidth;
			progress.style.animation = "";
			progress.classList.toggle("is-paused", manuallyPaused);
		};

		const schedule = () => {
			window.clearTimeout(timer);
			if (reduceMotion || reviews.length < 2 || manuallyPaused || hovered || focused) return;
			timer = window.setTimeout(() => show(active + 1), advanceMs);
		};

		const paint = () => {
			const review = reviews[active];
			if (!review) return;
			quote.textContent = review.quote;
			author.textContent = review.author;
			country.textContent = review.country ?? "";

			for (const [index, tab] of tabs.entries()) {
				const selected = index === active;
				tab.setAttribute("aria-selected", selected ? "true" : "false");
				tab.tabIndex = selected ? 0 : -1;
			}

			const panel = root.querySelector<HTMLElement>("#testimonial-panel");
			if (panel) panel.setAttribute("aria-labelledby", `review-tab-${active}`);
			if (indicator) indicator.style.setProperty("--active-index", String(active));
			restartProgress();
		};

		const show = (index: number, focusTab = false) => {
			if (!reviews.length) return;
			active = (index + reviews.length) % reviews.length;
			window.clearTimeout(timer);
			window.clearTimeout(fadeTimer);
			if (quoteArea && !reduceMotion) {
				quoteArea.classList.add("is-fading");
				fadeTimer = window.setTimeout(() => {
					paint();
					quoteArea.classList.remove("is-fading");
					schedule();
				}, 175);
			} else {
				paint();
				schedule();
			}
			if (focusTab) tabs[active]?.focus();
			else if (document.activeElement && tabs.includes(document.activeElement as HTMLButtonElement)) {
				tabs[active]?.focus();
			}
		};

		for (const tab of tabs) {
			tab.addEventListener("click", () => {
				const index = Number(tab.dataset.index ?? "0");
				if (index === active) return;
				show(index);
			});
		}

		tablist?.addEventListener("keydown", (event) => {
			if (event.key === "ArrowDown" || event.key === "ArrowRight") {
				event.preventDefault();
				show(active + 1, true);
			} else if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
				event.preventDefault();
				show(active - 1, true);
			} else if (event.key === "Home") {
				event.preventDefault();
				show(0, true);
			} else if (event.key === "End") {
				event.preventDefault();
				show(reviews.length - 1, true);
			}
		});

		root.querySelector("[data-prev]")?.addEventListener("click", () => show(active - 1));
		root.querySelector("[data-next]")?.addEventListener("click", () => show(active + 1));

		pause?.addEventListener("click", () => {
			manuallyPaused = !manuallyPaused;
			pause.setAttribute("aria-pressed", manuallyPaused ? "true" : "false");
			pause.setAttribute(
				"aria-label",
				manuallyPaused ? "Play automatic reviews" : "Pause automatic reviews",
			);
			pause.classList.toggle("is-paused", manuallyPaused);
			progress?.classList.toggle("is-paused", manuallyPaused);
			schedule();
		});

		root.addEventListener("pointerenter", () => {
			hovered = true;
			progress?.classList.add("is-paused");
			schedule();
		});
		root.addEventListener("pointerleave", () => {
			hovered = false;
			if (!manuallyPaused) progress?.classList.remove("is-paused");
			schedule();
		});
		root.addEventListener("focusin", () => {
			focused = true;
			progress?.classList.add("is-paused");
			schedule();
		});
		root.addEventListener("focusout", (event) => {
			if (root.contains(event.relatedTarget as Node | null)) return;
			focused = false;
			if (!manuallyPaused) progress?.classList.remove("is-paused");
			schedule();
		});

		paint();
		schedule();
	}
</script>

<style>
	.testimonials {
		padding-block: var(--section-space);
	}

	.testimonials__panel {
		position: relative;
		overflow: clip;
		padding: clamp(28px, 4.4vw, 56px);
		border-radius: var(--radius-panel);
		background: var(--deep);
		color: #eaf4ef;
		--ink: #eaf4ef;
		--ink-muted: #9db3a8;
		--line: color-mix(in srgb, #eaf4ef 22%, transparent);
		--focus: #3fc391;
	}

	.testimonials__glyph {
		position: absolute;
		left: clamp(16px, 3vw, 40px);
		top: clamp(-72px, -6vw, -48px);
		color: #3fc391;
		font-size: calc(var(--type-display-size) * 3.5);
		font-weight: 500;
		line-height: 1;
		opacity: 0.15;
		pointer-events: none;
		user-select: none;
	}

	.testimonials__main {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(20px, 4vw, 56px);
		align-items: start;
	}

	.testimonials__quote-area {
		position: relative;
		z-index: 1;
		display: grid;
		gap: var(--space-lg);
		transition: opacity 175ms var(--ease);
	}

	.testimonials__quote-area.is-fading {
		opacity: 0;
	}

	.testimonials__blockquote {
		margin: 0;
	}

	.testimonials__quote {
		max-width: 34ch;
		font-size: var(--type-h3-size);
		font-weight: 400;
		line-height: 1.3;
		letter-spacing: -0.01em;
		text-wrap: pretty;
	}

	.testimonials__author {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-xs);
		margin-top: var(--space-lg);
		color: var(--ink-muted);
		font-size: var(--type-small-size);
	}

	.testimonials__name {
		color: #eaf4ef;
		font-style: normal;
		font-weight: 600;
	}

	.testimonials__country:not(:empty)::before {
		content: ", ";
	}

	.testimonials__flag {
		padding: 3px 10px;
		border: 1px dashed color-mix(in srgb, #eaf4ef 35%, transparent);
		border-radius: var(--radius-chip);
		color: var(--ink-muted);
		font-size: var(--type-eyebrow-size);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.testimonials__progress {
		height: 2px;
		max-width: 320px;
		overflow: hidden;
		border-radius: 999px;
		background: color-mix(in srgb, #eaf4ef 18%, transparent);
	}

	.testimonials__progress-bar {
		display: block;
		width: 100%;
		height: 100%;
		background: #3fc391;
		transform-origin: left center;
		animation: testimonial-progress 8s linear forwards;
	}

	.testimonials__progress-bar.is-paused {
		animation-play-state: paused;
	}

	@keyframes testimonial-progress {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	.testimonials__side {
		display: grid;
		align-content: start;
		justify-items: end;
		gap: var(--space-lg);
	}

	.testimonials__avatars {
		position: relative;
		display: grid;
		gap: var(--space-sm);
	}

	.testimonials__indicator {
		position: absolute;
		left: -16px;
		top: 0;
		width: 2px;
		height: 56px;
		border-radius: 999px;
		background: #3fc391;
		transform: translateY(calc(var(--active-index, 0) * 68px));
		transition: transform var(--dur-base) var(--ease);
	}

	.testimonials__avatar {
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		padding: 0;
		border: 1px solid #3fc391;
		border-radius: 50%;
		background: transparent;
		color: #eaf4ef;
		font-size: var(--type-small-size);
		font-weight: 600;
		letter-spacing: 0.04em;
		transition:
			background-color var(--dur-fast) var(--ease),
			color var(--dur-fast) var(--ease);
	}

	.testimonials__avatar:hover,
	.testimonials__avatar[aria-selected="true"] {
		background: #3fc391;
		color: #062017;
	}

	.testimonials__controls {
		display: flex;
		gap: var(--space-xs);
	}

	.testimonials__control {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid color-mix(in srgb, #eaf4ef 30%, transparent);
		border-radius: 6px;
		background: transparent;
		color: #eaf4ef;
		transition:
			background-color var(--dur-fast) var(--ease),
			border-color var(--dur-fast) var(--ease);
	}

	.testimonials__control:hover,
	.testimonials__control:focus-visible {
		border-color: #3fc391;
		background: color-mix(in srgb, #3fc391 18%, transparent);
	}

	.testimonials__icon-play {
		display: none;
	}

	.testimonials__control.is-paused .testimonials__icon-pause {
		display: none;
	}

	.testimonials__control.is-paused .testimonials__icon-play {
		display: inline;
	}

	@media (max-width: 760px) {
		.testimonials__main {
			grid-template-columns: 1fr;
		}

		.testimonials__side {
			grid-auto-flow: column;
			align-items: center;
			justify-content: space-between;
			justify-items: start;
		}

		.testimonials__avatars {
			grid-auto-flow: column;
		}

		.testimonials__indicator {
			display: none;
		}

		.testimonials__glyph {
			font-size: calc(var(--type-display-size) * 2.6);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.testimonials__quote-area,
		.testimonials__indicator {
			transition: none;
		}

		.testimonials__progress-bar {
			animation: none;
			transform: none;
		}
	}
</style>
