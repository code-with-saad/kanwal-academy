---
// Edit reviews here. `img` is optional (path to a photo); without it, initials are shown.
// Set sample: false on real reviews to hide the "Sample" note.
interface Review {
  name: string;
  country: string;
  rating: string;
  text: string;
  img?: string;
  sample?: boolean;
}

const defaultReviews: Review[] = [
  {
    name: "Parent name",
    country: "Country",
    rating: "5.0",
    text: "Sample review text. Replace with a real review from a parent or student.",
    sample: true,
  },
  {
    name: "Parent name",
    country: "Country",
    rating: "5.0",
    text: "Sample review text. Replace with a real review from a parent or student.",
    sample: true,
  },
  {
    name: "Parent name",
    country: "Country",
    rating: "5.0",
    text: "Sample review text. Replace with a real review from a parent or student.",
    sample: true,
  },
];

const { reviews = defaultReviews } = Astro.props as { reviews?: Review[] };

const initials = (name: string) =>
  name
    .split(" ")
    .map((w) => w[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
---

<section class="tm" id="reviews" aria-labelledby="tm-title" data-testimonial>
  <div class="tm-wrap">
    <div class="tm-circle" aria-hidden="true"></div>

    <div class="tm-card">
      <div class="tm-left">
        <span class="tm-bar" aria-hidden="true"></span>
        <h2 id="tm-title" class="tm-title">Customer Reviews</h2>

        <div class="tm-list" role="tablist" aria-label="Reviewers">
          {
            reviews.map((r, i) => (
              <button
                type="button"
                class="tm-item"
                role="tab"
                data-i={i}
                aria-selected={i === 0 ? "true" : "false"}
              >
                <span class="tm-avatar">
                  {r.img ? (
                    <img src={r.img} alt="" loading="lazy" />
                  ) : (
                    <span>{initials(r.name)}</span>
                  )}
                </span>
                <span class="tm-meta">
                  <span class="tm-name">{r.name}</span>
                  <span class="tm-rating">
                    <svg viewBox="0 0 20 20" width="12" height="12" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M10 1.5l2.63 5.33 5.87.85-4.25 4.14 1 5.85L10 14.9l-5.25 2.77 1-5.85L1.5 7.68l5.87-.85z"
                      />
                    </svg>
                    <b>{r.rating}</b>
                    <span class="tm-country">{r.country}</span>
                  </span>
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="tm-right" aria-live="polite">
        {
          reviews.map((r, i) => (
            <blockquote class="tm-quote" data-i={i} data-active={i === 0 ? "true" : "false"}>
              <span class="tm-mark" aria-hidden="true">"</span>
              <p>{r.text}</p>
              {r.sample && <small class="tm-sample">Sample review</small>}
            </blockquote>
          ))
        }

        <div class="tm-controls">
          <button type="button" class="tm-btn" data-prev aria-label="Previous review">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="tm-btn" data-next aria-label="Next review">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>

        <div class="tm-progress" aria-hidden="true">
          <span class="tm-progress-bar" data-progress></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tm {
    --tm-accent: #0e8a63;
    --tm-accent-soft: #1f9d6b;
    --tm-accent-deep: #0a6a47;
    --tm-card: #ffffff;
    --tm-text: #1c2421;
    --tm-muted: #8a948f;
    --tm-line: #d9dfdc;
    --tm-shadow: 0 24px 60px -20px rgba(20, 40, 32, 0.28);

    position: relative;
    overflow: hidden;
    padding: 6rem 1.5rem;
  }

  :global(.dark) .tm,
  :global([data-theme="dark"]) .tm {
    --tm-card: #141c19;
    --tm-text: #e8efec;
    --tm-muted: #8fa099;
    --tm-line: #2c3a35;
    --tm-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.6);
  }

  .tm-wrap {
    position: relative;
    max-width: 1040px;
    margin: 0 auto;
  }

  /* Big green circle bleeding off the left, peeking above and below the card */
  .tm-circle {
    position: absolute;
    z-index: 0;
    width: 640px;
    height: 640px;
    left: -440px;
    top: -90px;
    border-radius: 50%;
    background: linear-gradient(120deg, var(--tm-accent-deep), var(--tm-accent-soft));
  }

  .tm-card {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 2.5rem;
    padding: 3rem 3.5rem 3rem 3rem;
    background: var(--tm-card);
    border-radius: 6px;
    box-shadow: var(--tm-shadow);
  }

  /* Left: heading + arc */
  .tm-bar {
    display: block;
    width: 36px;
    height: 3px;
    background: var(--tm-accent);
    margin-bottom: 0.9rem;
  }

  .tm-title {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--tm-text);
  }

  .tm-list {
    position: relative;
    height: 300px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent);
  }

  /* The thin arc the avatars sit on (circle radius 200, bulging to the right) */
  .tm-list::before {
    content: "";
    position: absolute;
    width: 400px;
    height: 400px;
    left: -250px;
    top: -50px;
    border: 1px solid var(--tm-line);
    border-radius: 50%;
  }

  .tm-item {
    --off: 0;
    --dx: 0px;
    position: absolute;
    left: 0;
    top: 50%;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: var(--tm-text);
    transform: translate(calc(122px + var(--dx)), calc(-50% + var(--off) * 90px));
    transition:
      transform 0.55s cubic-bezier(0.22, 0.8, 0.3, 1),
      opacity 0.4s ease;
  }

  .tm-item[data-state="near"] {
    --dx: -21px;
    opacity: 0.85;
  }
  .tm-item[data-state="far"] {
    --dx: -60px;
    opacity: 0;
    pointer-events: none;
  }
  .tm-item:focus-visible {
    outline: 2px solid var(--tm-accent);
    outline-offset: 6px;
    border-radius: 8px;
  }

  .tm-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--tm-accent);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    transform: scale(0.72);
    transition: transform 0.55s cubic-bezier(0.22, 0.8, 0.3, 1);
  }
  .tm-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }
  .tm-item[aria-selected="true"] .tm-avatar {
    transform: scale(1);
  }
  .tm-item[aria-selected="true"] .tm-avatar img {
    filter: none;
  }

  .tm-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    white-space: nowrap;
  }
  .tm-name {
    font-size: 0.78rem;
    font-weight: 600;
    transition: font-size 0.4s ease;
  }
  .tm-item[aria-selected="true"] .tm-name {
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .tm-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    color: var(--tm-muted);
  }
  .tm-rating svg {
    color: var(--tm-accent);
  }
  .tm-rating b {
    color: var(--tm-text);
    font-weight: 700;
  }
  .tm-item[aria-selected="true"] .tm-rating {
    font-size: 0.9rem;
  }
  .tm-item[aria-selected="true"] .tm-rating svg {
    width: 15px;
    height: 15px;
  }

  /* Right: quote */
  .tm-right {
    display: grid;
    align-items: center;
  }

  .tm-quote {
    grid-area: 1 / 1;
    position: relative;
    margin: 0;
    padding-left: 1.6rem;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }
  .tm-quote[data-active="true"] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .tm-mark {
    position: absolute;
    left: 0;
    top: -0.2rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2rem;
    line-height: 1;
    color: var(--tm-text);
  }

  .tm-quote p {
    margin: 0;
    max-width: 34rem;
    font-family: "Noto Serif", Georgia, "Times New Roman", serif;
    font-style: italic;
    font-size: 1.05rem;
    line-height: 2;
    color: var(--tm-text);
  }
  .tm-quote p::first-letter {
    font-size: 1.8em;
    line-height: 1;
  }

  .tm-sample {
    display: block;
    margin-top: 1.2rem;
    font-size: 0.75rem;
    color: var(--tm-muted);
  }

  /* Controls + progress */
  .tm-controls {
    display: flex;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .tm-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--tm-line);
    background: var(--tm-card);
    color: var(--tm-text);
    cursor: pointer;
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .tm-btn:hover,
  .tm-btn:focus-visible {
    border-color: var(--tm-accent);
    background: var(--tm-accent);
    color: #fff;
  }

  .tm-progress {
    height: 3px;
    width: 200px;
    margin-top: 1rem;
    background: var(--tm-line);
    border-radius: 2px;
    overflow: hidden;
  }

  .tm-progress-bar {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--tm-accent);
    transform-origin: left;
    animation: tm-progress 3s linear forwards;
  }
  .tm-progress-bar.is-paused {
  	animation-play-state: paused;
  }

  @keyframes tm-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Tablet / mobile */
  @media (max-width: 860px) {
    .tm {
      padding: 4rem 1rem;
    }
    .tm-circle {
      width: 420px;
      height: 420px;
      left: -260px;
      top: -60px;
    }
    .tm-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem 1.5rem;
    }
    .tm-right {
      order: -1;
    }
    .tm-list {
      height: 270px;
    }
    .tm-item {
      transform: translate(calc(70px + var(--dx)), calc(-50% + var(--off) * 80px));
    }
    .tm-list::before {
      left: -330px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tm-item,
    .tm-avatar,
    .tm-quote {
      transition: none;
    }
	.tm-progress-bar {
	  animation: none;
	  transform: scaleX(1);
    }
  }
</style>


<script>
  document.querySelectorAll<HTMLElement>("[data-testimonial]").forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>(".tm-item"));
    const quotes = Array.from(root.querySelectorAll<HTMLElement>(".tm-quote"));
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const n = items.length;
    if (!n) return;

    let active = 0;

    function restartProgress() {
      if (!progress) return;
      progress.style.animation = "none";
      void progress.offsetWidth;
      progress.style.animation = "";
    }

    function render() {
      items.forEach((el, i) => {
        let off = (((i - active) % n) + n) % n;
        if (off > n / 2) off -= n;
        el.style.setProperty("--off", String(off));
        el.dataset.state = off === 0 ? "active" : Math.abs(off) === 1 ? "near" : "far";
        el.setAttribute("aria-selected", String(off === 0));
        el.tabIndex = off === 0 ? 0 : -1;
      });
      quotes.forEach((q, i) => (q.dataset.active = String(i === active)));
      restartProgress();
    }

    function go(i: number) {
      active = ((i % n) + n) % n;
      render();
    }

    // The progress bar is the timer: when one run ends, show the next review.
    if (progress && n > 1) {
      progress.addEventListener("animationend", () => go(active + 1));
    } else if (progress) {
      progress.parentElement?.setAttribute("hidden", "");
    }

    items.forEach((el, i) => el.addEventListener("click", () => go(i)));

    root.querySelector("[data-prev]")?.addEventListener("click", () => go(active - 1));
    root.querySelector("[data-next]")?.addEventListener("click", () => go(active + 1));

    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowRight") go(active + 1);
      else if (e.key === "ArrowUp" || e.key === "ArrowLeft") go(active - 1);
      else return;
      items[active].focus();
    });

    // Hover pauses the bar, and so pauses autoplay too.
    const card = root.querySelector<HTMLElement>(".tm-card");
	card?.addEventListener("mouseenter", () => progress?.classList.add("is-paused"));
	card?.addEventListener("mouseleave", () => progress?.classList.remove("is-paused"));

    render();
  });
</script>