---
import Container from "./Container.astro";

interface Review {
	quote: string;
	author: string;
	country?: string | null;
}

interface Props {
	reviews: Review[];
	demo?: boolean;
}

const { reviews, demo = false } = Astro.props;

/**
 * Demo mode: three clearly labelled sample cards. Never shown in production.
 * We do not invent names or quotes — every field says "Sample".
 */
const sampleReview: Review = {
	quote: "Sample review text. Replace with a real review from a parent or student.",
	author: "Parent name",
	country: "Country",
};

const items = reviews.length > 0 ? reviews : demo ? [sampleReview, sampleReview, sampleReview] : [];
const isDemoCard = reviews.length === 0 && demo;

const initials = (name: string) =>
	name
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part[0]?.toUpperCase() ?? "")
		.join("") || "?";

const reviewsJson = JSON.stringify(items).replace(/</g, "\\u003c");
---

{
	items.length > 0 && (
		<section id="testimonials" class="reviews">
			<Container>
				<!-- Decorative green circle behind the panel -->
				<span class="reviews__circle" aria-hidden="true"></span>

				<div class="reviews__panel" data-reviews>

					<div class="reviews__inner">
						<!-- Left: heading + reviewer list -->
						<div class="reviews__list-col">
							<span class="reviews__accent" aria-hidden="true"></span>
							<h2 class="reviews__heading">Customer Reviews</h2>

							<ul class="reviews__reviewers" role="tablist" aria-label="Choose a review">
								{
									items.map((item, index) => (
										<li class:list={["reviews__reviewer", index === 0 && "is-active"]}>
											<button
												type="button"
												role="tab"
												class="reviews__reviewer-btn"
												data-tab
												data-index={index}
												aria-selected={index === 0 ? "true" : "false"}
												aria-label={`Review by ${item.author}`}
												tabindex={index === 0 ? 0 : -1}
											>
												<span class="reviews__avatar" aria-hidden="true">
													{initials(item.author)}
												</span>
												<span class="reviews__meta">
													<span class="reviews__name">{item.author}</span>
													<span class="reviews__rating">
														<span class="reviews__stars" aria-hidden="true">★★★★★</span>
														{item.country && <span class="reviews__country">· {item.country}</span>}
													</span>
												</span>
											</button>
										</li>
									))
								}
							</ul>

							<!-- Curve connecting the avatars (desktop only) -->
							<svg
								class="reviews__curve"
								viewBox="0 0 12 144"
								preserveAspectRatio="none"
								aria-hidden="true"
							>
								<path
									d="M6 2 C 10 28, 2 58, 6 84 C 10 110, 2 140, 6 142"
									fill="none"
									stroke="currentColor"
									stroke-width="0.8"
								/>
							</svg>
						</div>

						<!-- Right: quote -->
						<div class="reviews__quote-col">
							<blockquote class="reviews__quote">
								<span class="reviews__glyph" aria-hidden="true">&ldquo;</span>
								<p data-quote>{items[0]?.quote}</p>
								<footer class="reviews__quote-foot">
									<cite class="reviews__quote-author" data-author>{items[0]?.author}</cite>
									{isDemoCard && <span class="reviews__flag">Sample</span>}
								</footer>
							</blockquote>

							<div class="reviews__controls">
								<button
									type="button"
									class="reviews__ctrl reviews__ctrl--prev"
									data-prev
									aria-label="Previous review"
								>
									<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
										<path
											d="M15 18l-6-6 6-6"
											fill="none"
											stroke="currentColor"
											stroke-width="1.8"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</button>
								<button
									type="button"
									class="reviews__ctrl reviews__ctrl--next"
									data-next
									aria-label="Next review"
								>
									<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
										<path
											d="M9 6l6 6-6 6"
											fill="none"
											stroke="currentColor"
											stroke-width="1.8"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</button>
							</div>

							<div class="reviews__progress" aria-hidden="true">
								<span class="reviews__progress-bar" data-progress></span>
							</div>
						</div>
					</div>

					<script type="application/json" data-reviews is:inline set:html={reviewsJson}></script>
				</div>
			</Container>
		</section>
	)
}

<script>
	const INTERVAL = 3000;

	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	for (const root of document.querySelectorAll<HTMLElement>("[data-reviews]")) {
		const dataEl = root.querySelector<HTMLScriptElement>("[data-reviews]");
		const quoteEl = root.querySelector<HTMLElement>("[data-quote]");
		const authorEl = root.querySelector<HTMLElement>("[data-author]");
		const progressEl = root.querySelector<HTMLElement>("[data-progress]");
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));

		if (!dataEl || !quoteEl || !authorEl || tabs.length === 0) continue;

		let reviews: { quote: string; author: string; country?: string | null }[] = [];
		try {
			reviews = JSON.parse(dataEl.textContent ?? "[]");
		} catch {
			continue;
		}
		if (reviews.length === 0) continue;

		let active = 0;
		let timer: number | undefined;
		let paused = false;

		const paint = (index: number) => {
			active = (index + reviews.length) % reviews.length;
			const r = reviews[active];
			quoteEl.textContent = r.quote;
			authorEl.textContent = r.author;
			for (const [i, tab] of tabs.entries()) {
				const sel = i === active;
				tab.setAttribute("aria-selected", String(sel));
				tab.tabIndex = sel ? 0 : -1;
				tab.parentElement?.classList.toggle("is-active", sel);
			}
			restartProgress();
		};

		const tick = () => {
			if (paused) return;
			paint(active + 1);
			schedule();
		};

		const schedule = () => {
			window.clearTimeout(timer);
			if (reduce || paused) return;
			timer = window.setTimeout(tick, INTERVAL);
		};

		const restartProgress = () => {
			if (!progressEl || reduce) return;
			progressEl.style.animation = "none";
			void progressEl.offsetWidth;
			progressEl.style.animation = "";
		};

		paint(0);
		schedule();

		const pause = () => {
			paused = true;
			window.clearTimeout(timer);
			progressEl?.classList.add("is-paused");
		};
		const resume = () => {
			if (!paused) return;
			paused = false;
			progressEl?.classList.remove("is-paused");
			schedule();
		};

		root.addEventListener("pointerenter", pause);
		root.addEventListener("pointerleave", resume);
		root.addEventListener("focusin", pause);
		root.addEventListener("focusout", (event) => {
			if (root.contains(event.relatedTarget as Node | null)) return;
			resume();
		});

		root.querySelector("[data-prev]")?.addEventListener("click", () => {
			paint(active - 1);
			schedule();
		});
		root.querySelector("[data-next]")?.addEventListener("click", () => {
			tick();
		});

		for (const tab of tabs) {
			tab.addEventListener("click", () => {
				const i = Number(tab.dataset.index ?? 0);
				if (i === active) return;
				paint(i);
				schedule();
			});
		}

		// Arrow keys on focused tab
		root.querySelector("[role=tablist]")?.addEventListener("keydown", (event) => {
			const e = event as KeyboardEvent;
			if (e.key === "ArrowDown" || e.key === "ArrowRight") {
				e.preventDefault();
				paint(active + 1);
				tabs[active]?.focus();
			} else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
				e.preventDefault();
				paint(active - 1);
				tabs[active]?.focus();
			}
		});
	}
</script>

<style>
	.reviews {
		position: relative;
		overflow: clip;
		padding-block: var(--section-space);
		background: var(--page);
	}

	/* Big green circle partially behind the panel (mirrors the mock). */
	.reviews__circle {
		position: absolute;
		left: -12vw;
		top: 50%;
		width: 34vw;
		max-width: 480px;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--green);
		transform: translateY(-50%);
		pointer-events: none;
		z-index: 0;
	}

	.reviews__panel {
		position: relative;
		z-index: 1;
	}

	.reviews__inner {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(28px, 4vw, 56px);
		padding: clamp(28px, 4vw, 56px);
		border-radius: var(--radius-panel);
		background: var(--surface);
		color: var(--ink);
		box-shadow: 0 20px 50px -24px rgba(11, 26, 20, 0.25);
	}

	/* Left column */
	.reviews__list-col {
		position: relative;
	}

	.reviews__accent {
		display: inline-block;
		width: 36px;
		height: 3px;
		background: var(--green);
		border-radius: 2px;
		margin-bottom: 14px;
	}

	.reviews__heading {
		font-size: var(--type-h2-size);
		line-height: var(--type-h2-line);
		font-weight: 600;
		letter-spacing: -0.02em;
		margin-bottom: var(--space-lg);
		color: var(--ink);
	}

	.reviews__reviewers {
		display: grid;
		gap: 10px;
	}

	.reviews__reviewer-btn {
		display: flex;
		align-items: center;
		gap: 14px;
		width: 100%;
		padding: 10px 14px;
		border: 1px solid transparent;
		border-radius: 14px;
		background: transparent;
		color: inherit;
		text-align: left;
		transition:
			background-color var(--transition),
			border-color var(--transition),
			transform var(--transition);
	}

	.reviews__reviewer:hover .reviews__reviewer-btn,
	.reviews__reviewer.is-active .reviews__reviewer-btn {
		background: var(--mint-50);
		border-color: var(--line);
	}

	.reviews__reviewer.is-active .reviews__reviewer-btn {
		background: var(--mint-100);
	}

	:global(html[data-theme="dark"]) .reviews__reviewer:hover .reviews__reviewer-btn,
	:global(html[data-theme="dark"]) .reviews__reviewer.is-active .reviews__reviewer-btn {
		background: var(--mint-100);
		border-color: var(--line);
	}

	:global(html[data-theme="dark"]) .reviews__reviewer.is-active .reviews__reviewer-btn {
		background: var(--mint-50);
	}

	.reviews__avatar {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		flex: none;
		border-radius: 50%;
		background: var(--mint-100);
		color: var(--green-deep);
		font-size: var(--type-small-size);
		font-weight: 600;
		transition:
			transform var(--transition),
			background-color var(--transition),
			color var(--transition);
	}

	.reviews__reviewer.is-active .reviews__avatar {
		width: 52px;
		height: 52px;
		background: var(--green);
		color: var(--on-accent);
	}

	.reviews__meta {
		display: grid;
		gap: 3px;
		min-width: 0;
	}

	.reviews__name {
		font-weight: 600;
		font-size: var(--type-body-size);
		line-height: 1.2;
	}

	.reviews__reviewer.is-active .reviews__name {
		font-size: clamp(0.95rem, 1.1vw, 1.0625rem);
	}

	.reviews__rating {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: var(--type-eyebrow-size);
		color: var(--ink-muted);
	}

	.reviews__stars {
		color: var(--green);
		letter-spacing: 1px;
	}

	/* Curve connecting the avatars (desktop only) */
	.reviews__curve {
		position: absolute;
		left: 28px;
		top: 24px;
		bottom: 24px;
		width: 12px;
		height: auto;
		color: var(--line);
		pointer-events: none;
	}

	/* Right column */
	.reviews__quote-col {
		display: grid;
		grid-template-rows: 1fr auto auto;
		gap: var(--space-lg);
		align-content: center;
	}

	.reviews__quote {
		margin: 0;
	}

	.reviews__glyph {
		display: block;
		font-size: 72px;
		line-height: 1;
		color: var(--green);
		font-family: Georgia, serif;
		opacity: 0.7;
	}

	.reviews__quote p {
		margin-top: var(--space-md);
		max-width: 48ch;
		font-size: var(--type-lead-size);
		line-height: 1.55;
		color: var(--ink);
		font-style: italic;
	}

	.reviews__quote-foot {
		margin-top: var(--space-lg);
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		color: var(--ink-muted);
		font-size: var(--type-small-size);
	}

	.reviews__quote-author {
		font-style: normal;
		font-weight: 600;
		color: var(--ink);
	}

	.reviews__flag {
		padding: 3px 10px;
		border: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent);
		border-radius: var(--radius-chip);
		color: var(--ink-muted);
		font-size: var(--type-eyebrow-size);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* Controls + progress */
	.reviews__controls {
		display: flex;
		gap: var(--space-xs);
	}

	.reviews__ctrl {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
		border-radius: 50%;
		background: transparent;
		color: var(--ink);
		transition:
			border-color var(--transition),
			background-color var(--transition),
			color var(--transition);
	}

	.reviews__ctrl:hover,
	.reviews__ctrl:focus-visible {
		border-color: var(--green);
		background: var(--green);
		color: var(--on-accent);
	}

	.reviews__progress {
		height: 3px;
		width: 100%;
		max-width: 320px;
		overflow: hidden;
		border-radius: 999px;
		background: color-mix(in srgb, var(--ink) 12%, transparent);
	}

	.reviews__progress-bar {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--green);
		transform-origin: left center;
		animation: reviews-progress 3s linear infinite;
	}

	.reviews__progress-bar.is-paused {
		animation-play-state: paused;
	}

	@keyframes reviews-progress {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	@media (max-width: 900px) {
		.reviews__inner {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}

		.reviews__curve {
			display: none;
		}

		.reviews__reviewers {
			grid-auto-flow: column;
			overflow-x: auto;
			gap: var(--space-xs);
			scroll-snap-type: x mandatory;
		}

		.reviews__reviewer {
			scroll-snap-align: start;
		}

		.reviews__quote-col {
			grid-template-rows: auto auto auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reviews__progress-bar {
			animation: none;
			transform: scaleX(1);
		}

		.reviews__avatar,
		.reviews__reviewer-btn,
		.reviews__ctrl {
			transition: none;
		}
	}
</style>
