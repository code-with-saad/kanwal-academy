---
import type { EditProxy } from "emdash";
import Container from "./Container.astro";
import { site } from "../config/site";
import { emailHref, phoneHref, type SiteContact } from "../utils/site-config";

interface Props {
	contact: SiteContact;
	siteName?: string;
	settingsEdit?: EditProxy;
}

const { contact, siteName = site.name, settingsEdit } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer tone-dark">
	<Container>
		<div class="footer__grid">
			<div class="footer__brand">
				<a href="/" class="footer__wordmark" aria-label={`${siteName} home`}>
					<img
						class="footer__logo"
						src="/images/kanwal-logo-on-dark.png"
						alt={siteName}
						width="240"
						height="56"
					/>
				</a>
				<p class="footer__tagline" {...settingsEdit?.footer_tagline}>
					{contact.footer.tagline}
				</p>
				{
					contact.socialLinks.length > 0 && (
						<ul class="footer__social">
							{contact.socialLinks.map((link) => (
								<li>
									<a href={link.url} target="_blank" rel="noopener noreferrer">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					)
				}
			</div>

			<nav class="footer__column" aria-labelledby="footer-explore">
				<h2 id="footer-explore" class="footer__heading" {...settingsEdit?.footer_explore_label}>
					{contact.footer.exploreLabel}
				</h2>
				<ul class="footer__links">
					{
						site.footerLinks.map((item, index) => {
							const labels = [
								["footer_courses_label", contact.footer.coursesLabel],
								["footer_pricing_label", contact.footer.pricingLabel],
								["footer_teachers_label", contact.footer.teachersLabel],
								["footer_trial_label", contact.footer.trialLabel],
								["footer_contact_link_label", contact.footer.contactLinkLabel],
							] as const;
							const [field, label] = labels[index] ?? ["footer_courses_label", item.label];
							return (
							<li>
								<a href={item.url} {...settingsEdit?.[field]}>{label}</a>
							</li>
							);
						})
					}
				</ul>
			</nav>

			<div class="footer__column">
				<h2 class="footer__heading" {...settingsEdit?.footer_contact_label}>
					{contact.footer.contactLabel}
				</h2>
				<address class="footer__address">
					<span {...settingsEdit?.address}>{contact.address}</span>
					<a href={phoneHref(contact.phone)} {...settingsEdit?.phone}>{contact.phone}</a>
					<a href={emailHref(contact.email)} {...settingsEdit?.email}>{contact.email}</a>
				</address>
			</div>
		</div>

		<div class="footer__bottom">
			<p>
				&copy; {year} {siteName}. <span {...settingsEdit?.footer_copyright_label}>{contact.footer.copyrightLabel}</span>
			</p>
			<ul class="footer__legal">
				{
					site.legal.map((item) => {
						const isTerms = item.url.includes("terms");
						const field = isTerms ? "footer_terms_label" : "footer_privacy_label";
						const label = isTerms ? contact.footer.termsLabel : contact.footer.privacyLabel;
						return (
							<li>
								<a href={item.url} {...settingsEdit?.[field]}>{label}</a>
							</li>
						);
					})
				}
			</ul>
		</div>
	</Container>
</footer>

<style>
	.site-footer {
		padding-block: var(--space-3xl) var(--space-lg);
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.footer__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.8fr) minmax(120px, 0.8fr) minmax(0, 1fr);
		gap: var(--space-2xl);
		padding-bottom: var(--space-2xl);
	}

	.footer__wordmark {
		display: inline-flex;
		align-items: center;
		color: var(--text-on-dark);
		font-family: var(--font-heading, Georgia, serif);
		font-size: clamp(1.375rem, 2vw, 1.75rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.footer__logo {
		display: block;
		height: 56px;
		width: auto;
		object-fit: contain;
	}

	.footer__wordmark:hover {
		color: var(--sage);
	}

	.footer__tagline {
		max-width: 36ch;
		margin-top: var(--space-md);
		color: var(--muted-on-dark);
		font-size: var(--size-small);
	}

	.footer__social {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
		margin-top: var(--space-md);
	}

	.footer__social a {
		color: var(--text-on-dark);
		font-size: var(--size-small);
		text-decoration: none;
	}

	.footer__social a:hover {
		color: var(--sage);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.footer__heading {
		margin-bottom: var(--space-md);
		color: var(--muted-on-dark);
		font-family: var(--font-body, "Instrument Sans", Arial, sans-serif);
		font-size: var(--size-eyebrow);
		font-weight: 600;
		letter-spacing: var(--tracking-eyebrow);
		line-height: 1.2;
		text-transform: uppercase;
	}

	.footer__links {
		display: grid;
		gap: var(--space-xs);
	}

	.footer__links a,
	.footer__address a {
		color: var(--text-on-dark);
		font-size: var(--size-small);
		text-decoration: none;
		transition: color var(--transition);
	}

	.footer__links a:hover,
	.footer__address a:hover {
		color: var(--sage);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.footer__address {
		display: grid;
		gap: var(--space-xs);
		color: var(--muted-on-dark);
		font-size: var(--size-small);
		font-style: normal;
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--line-dark);
		color: var(--muted-on-dark);
		font-size: 0.875rem;
	}

	.footer__legal {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
	}

	.footer__legal a {
		color: var(--muted-on-dark);
		text-decoration: none;
	}

	.footer__legal a:hover {
		color: var(--text-on-dark);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	@media (max-width: 800px) {
		.footer__grid {
			grid-template-columns: 1fr 1fr;
		}

		.footer__brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 520px) {
		.footer__grid {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
</style>
