---
import type { EditProxy, ImageValue } from "emdash";
import { Image } from "emdash/ui";
import ResponsiveImage from "./ResponsiveImage.astro";
import Container from "./Container.astro";
import Newsletter from "./Newsletter.astro";
import SocialLinks from "./SocialLinks.astro";
import { site } from "../config/site";
import { emailHref, phoneHref, type SiteContact } from "../utils/site-config";
import { localizePath, useUi } from "../i18n";

interface Props {
	contact: SiteContact;
	siteName?: string;
	settingsEdit?: EditProxy;
	courseNames?: Array<{ name: string; href?: string }>;
	logoLight?: ImageValue | null;
	logoDark?: ImageValue | null;
}

const { locale, t } = useUi(Astro);
const { contact, siteName = site.name, settingsEdit, courseNames, logoLight, logoDark } = Astro.props;
const year = new Date().getFullYear();
const logoSize = (logo?: ImageValue | null) => {
	const sourceWidth = logo?.width ?? 1668;
	const sourceHeight = logo?.height ?? 712;
	const width = Math.min(260, sourceWidth);
	return { width, height: Math.round((sourceHeight / sourceWidth) * width) };
};
const lightLogoSize = logoSize(logoLight);
const darkLogoSize = logoSize(logoDark);

const links = courseNames?.length
	? courseNames.map((c) => ({ label: c.name, href: localizePath(c.href ?? "/#courses", locale) }))
	: [
			{ label: t.footer.courseRecitation, href: localizePath("/#courses", locale) },
			{ label: t.footer.courseTajweed, href: localizePath("/#courses", locale) },
			{ label: t.footer.courseMemorization, href: localizePath("/#courses", locale) },
		];

const academyLinks = [
	{ label: t.footer.aboutLabel, href: localizePath("/#about", locale) },
	{ label: contact.footer.pricingLabel, href: localizePath("/#pricing", locale), field: "footer_pricing_label" as const },
	{ label: contact.footer.trialLabel, href: localizePath("/#book", locale), field: "footer_trial_label" as const },
	{ label: contact.footer.contactLinkLabel, href: localizePath("/#book", locale), field: "footer_contact_link_label" as const },
];
---

<footer class="site-footer">
	<Container>
		<div class="footer__top">
			<div class="footer__brand">
				<a href={localizePath("/", locale)} class="footer__logo-link" aria-label={`${siteName}, ${t.a11y.home}`}>
					{logoLight ? (
						<Image
							image={logoLight}
							alt={siteName}
							class="footer__logo footer__logo--on-light"
							width={lightLogoSize.width}
							height={lightLogoSize.height}
							sizes="260px"
							loading="lazy"
						/>
					) : (
						<ResponsiveImage
							class="footer__logo footer__logo--on-light"
							src="/images/kanwal-logo-on-light.png"
							alt={siteName}
							width={260}
							height={111}
							sizes="260px"
							loading="lazy"
						/>
					)}
					{logoDark ? (
						<Image
							image={logoDark}
							alt={siteName}
							class="footer__logo footer__logo--on-dark"
							width={darkLogoSize.width}
							height={darkLogoSize.height}
							sizes="260px"
							loading="lazy"
						/>
					) : (
						<ResponsiveImage
							class="footer__logo footer__logo--on-dark"
							src="/images/kanwal-logo-on-dark.png"
							alt={siteName}
							width={260}
							height={111}
							sizes="260px"
							loading="lazy"
						/>
					)}
				</a>
				<p class="footer__description" {...settingsEdit?.footer_tagline}>
					{contact.footer.tagline}
				</p>
				<SocialLinks links={contact.socialLinks} />
			</div>

			<nav class="footer__column" aria-labelledby="footer-courses">
				<h2 id="footer-courses" class="footer__heading" {...settingsEdit?.footer_courses_label}>
					{contact.footer.coursesLabel}
				</h2>
				<ul class="footer__links">
					{
						links.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="footer__column" aria-labelledby="footer-academy">
				<h2 id="footer-academy" class="footer__heading" {...settingsEdit?.footer_academy_label}>
					{contact.footer.academyLabel}
				</h2>
				<ul class="footer__links">
					{
						academyLinks.map((link) => {
							const field = "field" in link ? link.field : null;
							return (
								<li>
									<a href={link.href} {...(field ? settingsEdit?.[field] : {})}>{link.label}</a>
								</li>
							);
						})
					}
				</ul>
			</nav>

			<div class="footer__column">
				<h2 class="footer__heading" {...settingsEdit?.footer_contact_label}>
					{contact.footer.contactLabel}
				</h2>
				<address class="footer__address">
					<span {...settingsEdit?.address}>{contact.address}</span>
					<a href={phoneHref(contact.phone)} {...settingsEdit?.phone}><bdi dir="ltr">{contact.phone}</bdi></a>
					<a href={emailHref(contact.email)} {...settingsEdit?.email}><bdi dir="ltr">{contact.email}</bdi></a>
				</address>
			</div>
		</div>

		<div class="footer__news">
			<div class="footer__news-copy">
				<h2 class="footer__news-heading" {...settingsEdit?.footer_stay_in_touch}>
					{contact.footer.stayInTouch}
				</h2>
				<p class="footer__news-consent">
					{contact.footer.newsletterConsent}
				</p>
			</div>
			<div class="footer__news-form">
				<Newsletter />
			</div>
		</div>

		<div class="footer__bottom">
			<p class="footer__copy">
				<bdi dir="ltr">&copy; {year}</bdi> {siteName}. <span {...settingsEdit?.footer_copyright_label}>{contact.footer.copyrightLabel}</span>
			</p>
			<ul class="footer__legal">
				{
					site.legal.map((item) => {
						const isTerms = item.href.includes("terms");
						const field = isTerms ? "footer_terms_label" : "footer_privacy_label";
						const label = isTerms ? contact.footer.termsLabel : contact.footer.privacyLabel;
						return (
							<li>
								<a href={localizePath(item.href, locale)} {...(field ? settingsEdit?.[field] : {})}>{label}</a>
							</li>
						);
					})
				}
			</ul>
		</div>
	</Container>
</footer>

<style>
	.site-footer {
		padding-block: var(--space-3xl) var(--space-lg);
		background: var(--page);
		color: var(--ink);
		border-top: 1px solid var(--line);
		margin-top: auto;
	}

	.footer__top {
		display: grid;
		grid-template-columns: minmax(0, 1.8fr) repeat(3, minmax(0, 1fr));
		gap: var(--space-2xl);
		padding-bottom: var(--space-2xl);
	}

	.footer__logo-link {
		display: inline-flex;
		align-items: center;
		color: var(--ink);
		text-decoration: none;
	}

	.footer__logo {
		display: block;
		min-height: 96px;
		width: auto;
		max-width: 260px;
		height: auto;
		object-fit: contain;
	}

	:global(.footer__logo--on-dark) {
		display: none;
	}

	:global(html[data-theme="dark"] .footer__logo--on-light) {
		display: none;
	}

	:global(html[data-theme="dark"] .footer__logo--on-dark) {
		display: block;
	}

	.footer__description {
		max-width: 36ch;
		margin-top: var(--space-md);
		color: var(--type-copy-color);
		font-size: var(--type-small-size);
		line-height: var(--type-small-line);
	}

	.footer__heading {
		margin-bottom: var(--space-md);
		color: var(--ink);
		font-size: var(--type-small-size);
		font-weight: 600;
		line-height: 1.2;
	}

	.footer__links {
		display: grid;
		gap: var(--space-xs);
	}

	.footer__links a,
	.footer__address a {
		color: var(--type-copy-color);
		font-size: var(--type-small-size);
		text-decoration: none;
		transition: color var(--transition);
	}

	.footer__links a:hover,
	.footer__address a:hover {
		color: var(--green-deep);
	}

	.footer__address {
		display: grid;
		gap: var(--space-xs);
		color: var(--type-copy-color);
		font-size: var(--type-small-size);
		font-style: normal;
		line-height: var(--type-small-line);
	}

	.footer__news {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: start;
		gap: clamp(24px, 4vw, 48px);
		padding-top: var(--space-xl);
		border-top: 1px solid var(--line);
		margin-top: var(--space-2xl);
	}

	.footer__news-copy {
		display: grid;
		gap: var(--space-sm);
		min-width: 0;
	}

	.footer__news-heading {
		margin: 0;
		color: var(--ink);
		font-size: var(--type-h3-size);
		font-weight: var(--type-card-title-weight);
		line-height: var(--type-card-title-line);
	}

	.footer__news-consent {
		margin: 0;
		color: var(--type-copy-color);
		font-size: var(--type-small-size);
		line-height: var(--type-small-line);
		max-width: 40ch;
	}

	.footer__news-consent a {
		color: var(--green-deep);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.footer__news-consent a:hover {
		color: var(--green);
	}

	.footer__news-form {
		justify-self: start;
		width: 100%;
		max-width: 480px;
		min-width: 0;
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--line);
		color: var(--type-copy-color);
		font-size: var(--type-small-size);
	}

	.footer__copy {
		margin: 0;
	}

	.footer__legal {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
	}

	.footer__legal a {
		color: var(--type-copy-color);
		text-decoration: none;
	}

	.footer__legal a:hover {
		color: var(--green-deep);
	}

	@media (max-width: 900px) {
		.footer__top {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: var(--space-xl);
		}

		.footer__brand {
			grid-column: 1 / -1;
		}

		.footer__news {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 520px) {
		.footer__top {
			grid-template-columns: 1fr;
		}

		.footer__bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
