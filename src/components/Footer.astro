---
import Container from "./Container.astro";
import { site } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer tone-dark">
	<Container>
		<div class="footer__grid">
			<div class="footer__brand">
				<a href="/" class="footer__wordmark">{site.name}</a>
				<p class="footer__tagline">
					Online Qur'an education from Karachi, Pakistan. Every student starts with a free trial
					class.
				</p>
			</div>

			<nav class="footer__column" aria-labelledby="footer-explore">
				<h2 id="footer-explore" class="footer__heading">Explore</h2>
				<ul class="footer__links">
					{
						site.footerLinks.map((item) => (
							<li>
								<a href={item.url}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="footer__column">
				<h2 class="footer__heading">Contact</h2>
				<address class="footer__address">
					<span>{site.address}</span>
					<a href={site.phoneHref}>{site.phone}</a>
					<a href={site.emailHref}>{site.email}</a>
				</address>
			</div>
		</div>

		<div class="footer__bottom">
			<p>&copy; {year} {site.name}. All rights reserved.</p>
			<ul class="footer__legal">
				{
					site.legal.map((item) => (
						<li>
							<a href={item.url}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</div>
	</Container>
</footer>

<style>
	.site-footer {
		padding-block: var(--space-3xl) var(--space-lg);
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.footer__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.8fr) minmax(120px, 0.8fr) minmax(0, 1fr);
		gap: var(--space-2xl);
		padding-bottom: var(--space-2xl);
	}

	.footer__wordmark {
		display: inline-block;
		color: var(--text-on-dark);
		font-family: var(--font-heading, Georgia, serif);
		font-size: clamp(1.375rem, 2vw, 1.75rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	.footer__wordmark:hover {
		color: var(--sage);
	}

	.footer__tagline {
		max-width: 36ch;
		margin-top: var(--space-md);
		color: var(--muted-on-dark);
		font-size: var(--size-small);
	}

	.footer__heading {
		margin-bottom: var(--space-md);
		color: var(--muted-on-dark);
		font-family: var(--font-body, "Instrument Sans", Arial, sans-serif);
		font-size: var(--size-eyebrow);
		font-weight: 600;
		letter-spacing: var(--tracking-eyebrow);
		line-height: 1.2;
		text-transform: uppercase;
	}

	.footer__links {
		display: grid;
		gap: var(--space-xs);
	}

	.footer__links a,
	.footer__address a {
		color: var(--text-on-dark);
		font-size: var(--size-small);
		text-decoration: none;
		transition: color var(--transition);
	}

	.footer__links a:hover,
	.footer__address a:hover {
		color: var(--sage);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.footer__address {
		display: grid;
		gap: var(--space-xs);
		color: var(--muted-on-dark);
		font-size: var(--size-small);
		font-style: normal;
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--line-dark);
		color: var(--muted-on-dark);
		font-size: 0.875rem;
	}

	.footer__legal {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
	}

	.footer__legal a {
		color: var(--muted-on-dark);
		text-decoration: none;
	}

	.footer__legal a:hover {
		color: var(--text-on-dark);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	@media (max-width: 800px) {
		.footer__grid {
			grid-template-columns: 1fr 1fr;
		}

		.footer__brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 520px) {
		.footer__grid {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
</style>
