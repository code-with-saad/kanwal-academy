---
import type { EditProxy } from "emdash";
import Container from "./Container.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../config/site";
import { emailHref, phoneHref, type SiteContact } from "../utils/site-config";

interface Props {
	contact: SiteContact;
	siteName?: string;
	settingsEdit?: EditProxy;
}

const { contact, siteName = site.name, settingsEdit } = Astro.props;
const year = new Date().getFullYear();

const courseLinks = [
	{ label: "Qur'anic Recitation", href: "/#courses" },
	{ label: "Tajweed Proficiency", href: "/#courses" },
	{ label: "Memorization Excellence", href: "/#courses" },
];

const academyLinks = [
	{ label: "About", href: "/#about" },
	{ label: contact.footer.teachersLabel, href: "/#teachers", field: "footer_teachers_label" as const },
	{ label: contact.footer.pricingLabel, href: "/#pricing", field: "footer_pricing_label" as const },
	{ label: contact.footer.trialLabel, href: "/#book", field: "footer_trial_label" as const },
	{ label: contact.footer.contactLinkLabel, href: "/#book", field: "footer_contact_link_label" as const },
];
---

<footer class="site-footer">
	<Container>
		<div class="footer__top">
			<div class="footer__brand">
				<a href="/" class="footer__logo-link" aria-label={`${siteName}, home`}>
					<img
						class="footer__logo footer__logo--on-light"
						src="/images/kanwal-logo-on-light.png"
						alt={siteName}
						width="1668"
						height="712"
					/>
					<img
						class="footer__logo footer__logo--on-dark"
						src="/images/kanwal-logo-on-dark.png"
						alt={siteName}
						width="1668"
						height="712"
					/>
				</a>
				<p class="footer__description" {...settingsEdit?.footer_tagline}>
					{contact.footer.tagline}
				</p>
			</div>

			<nav class="footer__column" aria-labelledby="footer-courses">
				<h2 id="footer-courses" class="footer__heading" {...settingsEdit?.footer_courses_label}>
					{contact.footer.coursesLabel}
				</h2>
				<ul class="footer__links">
					<li>
						<a href="/#courses">{contact.footer.coursesLabel}</a>
					</li>
					{
						courseLinks.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="footer__column" aria-labelledby="footer-academy">
				<h2 id="footer-academy" class="footer__heading">Academy</h2>
				<ul class="footer__links">
					{
						academyLinks.map((link) => {
							const field = "field" in link ? link.field : null;
							return (
								<li>
									<a href={link.href} {...(field ? settingsEdit?.[field] : {})}>{link.label}</a>
								</li>
							);
						})
					}
				</ul>
			</nav>

			<div class="footer__column">
				<h2 class="footer__heading" {...settingsEdit?.footer_contact_label}>
					{contact.footer.contactLabel}
				</h2>
				<address class="footer__address">
					<span {...settingsEdit?.address}>{contact.address}</span>
					<a href={phoneHref(contact.phone)} {...settingsEdit?.phone}>{contact.phone}</a>
					<a href={emailHref(contact.email)} {...settingsEdit?.email}>{contact.email}</a>
				</address>
			</div>
		</div>

		<div class="footer__bottom">
			<p class="footer__copy">
				&copy; {year} {siteName}. <span {...settingsEdit?.footer_copyright_label}>{contact.footer.copyrightLabel}</span>
			</p>
			<ul class="footer__legal">
				{
					site.legal.map((item) => {
						const isTerms = item.href.includes("terms");
						const field = isTerms ? "footer_terms_label" : "footer_privacy_label";
						const label = isTerms ? contact.footer.termsLabel : contact.footer.privacyLabel;
						return (
							<li>
								<a href={item.href} {...settingsEdit?.[field]}>{label}</a>
							</li>
						);
					})
				}
			</ul>
			<div class="footer__end">
				<ThemeToggle />
				<button
					class="footer__top-btn"
					type="button"
					data-go-top
					aria-label="Go to top"
					hidden
				>
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
						<path
							d="M12 19V5m-6 6 6-6 6 6"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</button>
			</div>
		</div>
	</Container>
</footer>

<script>
	const goTop = document.querySelector<HTMLButtonElement>("[data-go-top]");
	if (goTop) {
		const update = () => {
			goTop.hidden = window.scrollY < 320;
		};
		window.addEventListener("scroll", update, { passive: true });
		update();
		document.addEventListener("astro:after-swap", update);
		goTop.addEventListener("click", () => {
			window.scrollTo({
				top: 0,
				behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
					? "auto"
					: "smooth",
			});
		});
	}
</script>

<style>
	.site-footer {
		padding-block: var(--space-3xl) var(--space-lg);
		background: var(--page);
		color: var(--ink);
		border-top: 1px solid var(--line);
		margin-top: auto;
	}

	.footer__top {
		display: grid;
		grid-template-columns: minmax(0, 1.8fr) repeat(3, minmax(0, 1fr));
		gap: var(--space-2xl);
		padding-bottom: var(--space-2xl);
	}

	.footer__logo-link {
		display: inline-flex;
		align-items: center;
		color: var(--ink);
		text-decoration: none;
	}

	.footer__logo {
		display: block;
		min-height: 96px;
		width: auto;
		max-width: 260px;
		height: auto;
		object-fit: contain;
	}

	.footer__logo--on-dark {
		display: none;
	}

	:global(html[data-theme="dark"]) .footer__logo--on-light {
		display: none;
	}

	:global(html[data-theme="dark"]) .footer__logo--on-dark {
		display: block;
	}

	.footer__description {
		max-width: 36ch;
		margin-top: var(--space-md);
		color: var(--ink-muted);
		font-size: var(--size-small);
		line-height: 1.6;
	}

	.footer__heading {
		margin-bottom: var(--space-md);
		color: var(--ink);
		font-family: var(--font-heading);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.2;
	}

	.footer__links {
		display: grid;
		gap: var(--space-xs);
	}

	.footer__links a,
	.footer__address a {
		color: var(--ink-muted);
		font-size: var(--size-small);
		text-decoration: none;
		transition: color var(--transition);
	}

	.footer__links a:hover,
	.footer__address a:hover {
		color: var(--green-deep);
	}

	.footer__address {
		display: grid;
		gap: var(--space-xs);
		color: var(--ink-muted);
		font-size: var(--size-small);
		font-style: normal;
		line-height: 1.6;
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--line);
		color: var(--ink-muted);
		font-size: 0.875rem;
	}

	.footer__copy {
		margin: 0;
	}

	.footer__legal {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
	}

	.footer__legal a {
		color: var(--ink-muted);
		text-decoration: none;
	}

	.footer__legal a:hover {
		color: var(--green-deep);
	}

	.footer__end {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.footer__top-btn {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
		border-radius: var(--radius-button);
		background: transparent;
		color: var(--ink);
		transition:
			border-color var(--transition),
			color var(--transition),
			background-color var(--transition);
	}

	.footer__top-btn:hover {
		border-color: var(--ink);
		background: color-mix(in srgb, var(--ink) 5%, transparent);
	}

	.footer__top-btn[hidden] {
		display: none;
	}

	@media (max-width: 900px) {
		.footer__top {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: var(--space-xl);
		}

		.footer__brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 520px) {
		.footer__top {
			grid-template-columns: 1fr;
		}

		.footer__bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
