---
/**
 * Course card for the home page: image on top, then name, chips, summary and
 * actions. The image follows the static convention /images/courses/<slug>.png;
 * until the file exists a labelled placeholder is shown.
 */
import type { EditProxy, ImageValue } from "emdash";
import { Image } from "emdash/ui";
import Button from "./Button.astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";

import { useUi } from "../i18n";

const { t } = useUi(Astro);

interface Props {
	slug: string;
	title: string;
	summary?: string;
	level?: string;
	href: string;
	imageSrc?: string;
	imageAlt?: string;
	image?: ImageValue | null;
	edit?: EditProxy;
	homeEdit?: EditProxy;
	trialLabel?: string;
	detailsLabel?: string;
	formatLabel?: string;
}

const {
	slug,
	title,
	summary,
	level,
	href,
	imageSrc,
	imageAlt,
	image,
	edit,
	homeEdit,
	trialLabel = t.actions.bookFreeTrial,
	detailsLabel = t.actions.seeDetails,
	formatLabel = t.home.courses_format_label,
} = Astro.props;
---

<article class="course-card">
	<div class="course-card__media" {...edit?.image}>
		{
			image ? (
				<Image
					image={image}
					alt={image.alt || imageAlt || `An open Qur'an on a wooden rehal for the ${title} course`}
					class="course-card__image"
					width={image.width ?? 800}
					height={image.height ?? 500}
					sizes="(max-width: 560px) calc(100vw - 32px), (max-width: 900px) 45vw, 30vw"
					loading="lazy"
				/>
			) : (
				<ImagePlaceholder
					src={imageSrc ?? `/images/courses/${slug}.png`}
					label={title}
					alt={imageAlt ?? `An open Qur'an on a wooden rehal for the ${title} course`}
					ratio="16 / 10"
					sizes="(max-width: 560px) calc(100vw - 32px), (max-width: 900px) 45vw, 30vw"
				/>
			)
		}
	</div>

	<div class="course-card__body">
		<h3 class="course-card__title" {...edit?.name}>{title}</h3>

		<ul class="course-card__chips">
			{level && <li class="course-card__chip" {...edit?.level}>{level}</li>}
			<li class="course-card__chip course-card__chip--accent" {...homeEdit?.courses_format_label}>{formatLabel}</li>
		</ul>

		{summary && <p class="course-card__summary" {...edit?.summary}>{summary}</p>}

		<div class="course-card__cta">
			<button
				type="button"
				class="course-card__trial-btn"
				data-book-cta
				data-prefill-course={title}
				{...homeEdit?.courses_trial_cta}
			>
				{trialLabel}
			</button>
			<Button href={href} variant="secondary" edit={homeEdit?.courses_details_cta}>{detailsLabel}</Button>
		</div>
	</div>
</article>

<style>
	.course-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--surface-2);
		color: var(--ink);
	}

	.course-card__media {
		border-bottom: 1px solid var(--line);
	}

	.course-card__image {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	.course-card__body {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: var(--space-sm);
		flex: 1;
		padding: var(--space-lg);
	}

	.course-card__title {
		font-size: var(--type-h3-size);
	}

	.course-card__chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
	}

	.course-card__chip {
		padding: 4px 10px;
		border: 1px solid var(--line);
		border-radius: var(--radius-button);
		background: color-mix(in srgb, var(--band) 50%, transparent);
		color: var(--ink-muted);
		font-size: var(--type-eyebrow-size);
		font-weight: 600;
		letter-spacing: 0.1em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.course-card__chip--accent {
		border-color: color-mix(in srgb, var(--accent) 45%, transparent);
		background: color-mix(in srgb, var(--sage) 16%, transparent);
		/* Sage-deep alone is 4.27:1 on this tint; darken it past 4.5:1. */
		color: color-mix(in srgb, var(--accent) 80%, var(--ink));
	}

	.course-card__summary {
		color: var(--ink-muted);
		font-size: var(--type-small-size);
		line-height: 1.55;
	}

	.course-card__cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		width: 100%;
		margin-top: auto;
		padding-top: var(--space-md);
	}

	.course-card__cta :global(.btn) {
		flex: 1 1 150px;
	}

	/* Modal trigger button styled as primary */
	.course-card__trial-btn {
		flex: 1 1 150px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 44px;
		padding: 0 20px;
		border: 1px solid var(--green);
		border-radius: var(--radius-button);
		background: var(--green);
		color: var(--on-accent);
		font: inherit;
		font-size: var(--type-small-size);
		font-weight: 500;
		cursor: pointer;
		transition: background-color var(--transition), border-color var(--transition);
	}

	.course-card__trial-btn:hover { background: var(--green-deep); border-color: var(--green-deep); }
	.course-card__trial-btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
</style>
