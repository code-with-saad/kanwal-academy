---
/**
 * Course card for the home page: image on top, then name, chips, summary and
 * actions. The image follows the static convention /images/courses/<slug>.png;
 * until the file exists a labelled placeholder is shown.
 */
import type { EditProxy, ImageValue } from "emdash";
import { Image } from "emdash/ui";
import Button from "./Button.astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface Props {
	slug: string;
	title: string;
	summary?: string;
	level?: string;
	href: string;
	imageSrc?: string;
	imageAlt?: string;
	image?: ImageValue | null;
	edit?: EditProxy;
	homeEdit?: EditProxy;
	trialLabel?: string;
	detailsLabel?: string;
	formatLabel?: string;
}

const {
	slug,
	title,
	summary,
	level,
	href,
	imageSrc,
	imageAlt,
	image,
	edit,
	homeEdit,
	trialLabel = "Book free trial",
	detailsLabel = "See details",
	formatLabel = "Live one on one",
} = Astro.props;
---

<article class="course-card">
	<div class="course-card__media" {...edit?.image}>
		{
			image ? (
				<Image
					image={image}
					alt={image.alt ?? imageAlt ?? `An open Qur'an on a wooden rehal for the ${title} course`}
					class="course-card__image"
				/>
			) : (
				<ImagePlaceholder
					src={imageSrc ?? `/images/courses/${slug}.png`}
					label={title}
					alt={imageAlt ?? `An open Qur'an on a wooden rehal for the ${title} course`}
					ratio="16 / 10"
				/>
			)
		}
	</div>

	<div class="course-card__body">
		<h3 class="course-card__title" {...edit?.name}>{title}</h3>

		<ul class="course-card__chips">
			{level && <li class="course-card__chip" {...edit?.level}>{level}</li>}
			<li class="course-card__chip course-card__chip--accent" {...homeEdit?.courses_format_label}>{formatLabel}</li>
		</ul>

		{summary && <p class="course-card__summary" {...edit?.summary}>{summary}</p>}

		<div class="course-card__cta">
			<Button href={`/free-trial?course=${encodeURIComponent(slug)}`} variant="primary" edit={homeEdit?.courses_trial_cta}>
				{trialLabel}
			</Button>
			<Button href={href} variant="secondary" edit={homeEdit?.courses_details_cta}>{detailsLabel}</Button>
		</div>
	</div>
</article>

<style>
	.course-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--surface-2);
		color: var(--ink);
	}

	.course-card__media {
		border-bottom: 1px solid var(--line);
	}

	.course-card__image {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	.course-card__body {
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: var(--space-sm);
		flex: 1;
		padding: var(--space-lg);
	}

	.course-card__title {
		font-size: 1.375rem;
	}

	.course-card__chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
	}

	.course-card__chip {
		padding: 4px 10px;
		border: 1px solid var(--line);
		border-radius: var(--radius-button);
		background: color-mix(in srgb, var(--band) 50%, transparent);
		color: var(--ink-muted);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.course-card__chip--accent {
		border-color: color-mix(in srgb, var(--accent) 45%, transparent);
		background: color-mix(in srgb, var(--sage) 16%, transparent);
		/* Sage-deep alone is 4.27:1 on this tint; darken it past 4.5:1. */
		color: color-mix(in srgb, var(--accent) 80%, var(--ink));
	}

	.course-card__summary {
		color: var(--ink-muted);
		font-size: var(--size-small);
		line-height: 1.55;
	}

	.course-card__cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		width: 100%;
		margin-top: auto;
		padding-top: var(--space-md);
	}

	.course-card__cta :global(.btn) {
		flex: 1 1 150px;
	}
</style>
