---
import type { FieldAnnotation } from "emdash";

interface Props {
	href?: string;
	variant?: "primary" | "secondary";
	size?: "md" | "lg";
	type?: "button" | "submit" | "reset";
	class?: string;
	edit?: Partial<FieldAnnotation>;
	/** Scrolls to the inline #book form and prefills it, instead of navigating. */
	book?: boolean;
	prefillPlan?: string;
	prefillCourse?: string;
}

const {
	href,
	variant = "primary",
	size = "md",
	type = "button",
	class: className,
	edit,
	book,
	prefillPlan,
	prefillCourse,
} = Astro.props;

const classes = ["btn", `btn--${variant}`, size === "lg" && "btn--lg", className];
const bookAttrs = book
	? {
			"data-book-cta": "",
			...(prefillPlan ? { "data-prefill-plan": prefillPlan } : {}),
			...(prefillCourse ? { "data-prefill-course": prefillCourse } : {}),
		}
	: {};
---

{
	book ? (
		<button type="button" class:list={classes} {...bookAttrs} {...edit}>
			<slot />
		</button>
	) : href ? (
		<a {href} class:list={classes} {...edit}>
			<slot />
		</a>
	) : (
		<button {type} class:list={classes} {...edit}>
			<slot />
		</button>
	)
}

<style>
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-xs);
		height: 48px;
		padding: 0 24px;
		border: 1px solid transparent;
		border-radius: var(--radius-button);
		font-size: var(--type-button-size);
		font-weight: var(--type-button-weight);
		line-height: 1;
		text-align: center;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color var(--transition),
			border-color var(--transition),
			color var(--transition);
	}

	.btn--lg {
		height: 52px;
		padding: 0 28px;
		font-size: var(--type-body-size);
	}

	.btn--primary {
		border-color: var(--green);
		background: var(--green);
		color: var(--on-accent);
	}

	.btn--primary:hover {
		background: var(--green-deep);
		border-color: var(--green-deep);
	}

	.btn--secondary {
		border-color: color-mix(in srgb, var(--ink) 20%, transparent);
		background: transparent;
		color: var(--ink);
	}

	.btn--secondary:hover {
		border-color: var(--ink);
		background: color-mix(in srgb, var(--ink) 5%, transparent);
	}

	/* Inside dark panels the outline uses the current (light) text colour. */
	:global(.tone-dark) .btn--secondary {
		border-color: color-mix(in srgb, var(--ink) 22%, transparent);
		color: var(--ink);
	}

	:global(.tone-dark) .btn--secondary:hover {
		border-color: var(--ink);
	}

	:global(.tone-dark) .btn--primary {
		background: var(--green);
		border-color: var(--green);
		color: var(--on-accent);
	}
</style>
