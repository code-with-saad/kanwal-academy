---
import { Font } from "astro:assets";
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site, type NavItem } from "../config/site";
import { getSiteContact } from "../utils/site-config";
import { resolveSiteIdentity } from "../utils/site";
import "../styles/global.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	headerTone?: "dark" | "light";
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	content,
	headerTone = Astro.url.pathname === "/" ? "dark" : "light",
} = Astro.props;

const [settingsResult, menuResult, contactResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getSiteContact(),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(contactResult.cacheHint);
}

const { siteTitle, siteTagline, titleSeparator } = resolveSiteIdentity(settingsResult.data);
const fullTitle = title
	? title.includes(siteTitle)
		? title
		: `${title} ${titleSeparator} ${siteTitle}`
	: siteTitle;

const isButtonItem = (item: { cssClasses?: string | null }) =>
	item.cssClasses?.split(/\s+/).includes("button") ?? false;
const menuItems = menuResult.data?.items ?? [];
const menuLinks = menuItems
	.filter((item) => !isButtonItem(item))
	.map((item): NavItem => ({ label: item.label, url: item.url }));
const menuButton = menuItems.find(isButtonItem);

const headerItems = menuLinks.length > 0 ? menuLinks : [...site.nav];
const headerCta: NavItem = menuButton
	? { label: menuButton.label, url: menuButton.url }
	: site.cta;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteTagline || site.description,
	canonical: canonical ?? `${Astro.url.origin}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#101a16" />
		<link rel="icon" href="/images/kanwal-logo-on-light.png" />
		<link rel="apple-touch-icon" href="/images/kanwal-logo-on-light.png" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-display" preload={[{ style: "normal" }]} />
		<Font cssVariable="--font-arabic" />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		<Header
			items={headerItems}
			cta={headerCta}
			tone={headerTone}
			currentPath={Astro.url.pathname}
			siteName={siteTitle}
		/>
		<main id="main">
			<slot />
		</main>
		<Footer
			contact={contactResult.data}
			settingsEdit={contactResult.entry?.edit}
			siteName={siteTitle}
		/>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
