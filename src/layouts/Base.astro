---
import { Font } from "astro:assets";
import { getSiteSettingsWithCacheHint } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Newsletter from "../components/Newsletter.astro";
import { site, type NavItem } from "../config/site";
import { getSiteContact } from "../utils/site-config";
import { resolveSiteIdentity } from "../utils/site";
import "../styles/global.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	headerTone?: "dark" | "light";
	nav?: NavItem[];
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	content,
	headerTone = Astro.url.pathname === "/" ? "dark" : "light",
	nav,
} = Astro.props;

const [settingsResult, contactResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getSiteContact(),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(contactResult.cacheHint);
}

const { siteTitle, siteTagline, titleSeparator } = resolveSiteIdentity(settingsResult.data);
const fullTitle = title
	? title.includes(siteTitle)
		? title
		: `${title} ${titleSeparator} ${siteTitle}`
	: siteTitle;

const headerItems = nav ?? [...site.nav];
const headerCta = site.cta;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteTagline || site.description,
	canonical: canonical ?? `${Astro.url.origin}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#FCFEFD" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0D1612" media="(prefers-color-scheme: dark)" />
		<script is:inline>
			(function () {
				try {
					var media = window.matchMedia("(prefers-color-scheme: dark)");
					var apply = function () {
						var url = new URL(window.location.href);
						var param = url.searchParams.get("theme");
						var stored = localStorage.getItem("theme");
						var theme =
							param === "light" || param === "dark"
								? param
								: stored === "light" || stored === "dark"
									? stored
									: media.matches
										? "dark"
										: "light";
						document.documentElement.setAttribute("data-theme", theme);
					};
					apply();
					media.addEventListener("change", apply);
					document.addEventListener("astro:after-swap", apply);
				} catch (e) {
					/* If storage is blocked, fall back to the light theme. */
				}
			})();
		</script>
		<link rel="icon" href="/images/kanwal-mark-on-light.png" />
		<link rel="apple-touch-icon" href="/images/kanwal-mark-on-light.png" />
		<script is:inline>
			(function () {
				try {
					if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
						document.documentElement.classList.add("js-motion");
						window.setTimeout(function () {
							if (document.documentElement.getAttribute("data-motion-ready") !== "1") {
								document.documentElement.classList.remove("js-motion");
							}
						}, 4000);
					}
				} catch (e) {
					/* Without matchMedia, leave the page static. */
				}
			})();
		</script>
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-arabic" />
	</head>
	<body data-is-home={Astro.url.pathname === "/" ? true : undefined}>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">Skip to content</a>
		<div class="sheet">
			<Header
				items={headerItems}
				cta={headerCta}
				tone={headerTone}
				currentPath={Astro.url.pathname}
				siteName={siteTitle}
			/>
			<main id="main">
				<slot />
			</main>
			<Newsletter />
			<Footer
				contact={contactResult.data}
				settingsEdit={contactResult.entry?.edit}
				siteName={siteTitle}
			/>
			<button
				type="button"
				class="page-go-top"
				data-page-top
				aria-label="Back to top"
				hidden
			>
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
					<path
						d="M12 19V5m-6 6 6-6 6 6"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</button>
		</div>
		<EmDashBodyEnd page={pageCtx} />
		<script>
			import "../scripts/motion";
		</script>
		<script>
			const goTop = document.querySelector<HTMLButtonElement>("[data-page-top]");
			if (goTop) {
				let hidden = true;
				const update = () => {
					const want = window.scrollY > 400;
					if (want !== !hidden) {
						goTop.toggleAttribute("hidden", !want);
						hidden = !want;
					}
				};
				window.addEventListener("scroll", update, { passive: true });
				update();
				document.addEventListener("astro:after-swap", update);
				goTop.addEventListener("click", () => {
					window.scrollTo({
						top: 0,
						behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
							? "auto"
							: "smooth",
					});
					goTop.focus();
				});
			}
		</script>
		<style>
			.page-go-top {
				position: fixed;
				right: 16px; /* max(16px, calc((100vw - var(--container)) / 2 + 8px)) */
				bottom: 24px;
				z-index: 40;
				display: grid;
				place-items: center;
				width: 48px;
				height: 48px;
				padding: 0;
				border: 1px solid var(--line);
				border-radius: 50%;
				background: var(--surface);
				color: var(--ink);
				box-shadow: 0 8px 24px -14px rgba(11, 26, 20, 0.4);
				transition:
					opacity 200ms var(--ease-out),
					transform 200ms var(--ease-out),
					background-color var(--transition),
					border-color var(--transition),
					color var(--transition);
			}

			.page-go-top:hover {
				background: var(--green);
				border-color: var(--green);
				color: var(--on-accent);
				transform: translateY(-2px);
			}

			.page-go-top:focus-visible {
				outline: 2px solid var(--focus);
				outline-offset: 3px;
			}

			.page-go-top[hidden] {
				opacity: 0;
				pointer-events: none;
				transform: translateY(8px);
			}

			@media (max-width: 560px) {
				.page-go-top {
					right: 16px;
					bottom: 16px;
					width: 44px;
					height: 44px;
				}

				.page-go-top svg {
					width: 18px;
					height: 18px;
				}
			}
		</style>
	</body>
</html>
