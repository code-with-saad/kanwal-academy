---
import { Font } from "astro:assets";
import { getSiteSettingsWithCacheHint, getTranslations } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import JsonLd from "../components/JsonLd.astro";
import MobileBar from "../components/MobileBar.astro";
import { site, type NavItem } from "../config/site";
import { getSiteContact, whatsappHref } from "../utils/site-config";
import { resolveSiteIdentity } from "../utils/site";
import {
	LOCALES,
	LOCALE_HREFLANG,
	OG_LOCALE,
	getLocalizedCollection,
	localizePath,
	stripLocalePrefix,
	useUi,
} from "../i18n";
import { localizedCta, localizedNav } from "../i18n/nav";
import "../styles/global.css";

interface Props {
	title?: string;
	titleIsComplete?: boolean;
	pageTitle?: string | null;
	description?: string | null;
	keywords?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	/** Localized breadcrumb trail; Home is prepended automatically. */
	breadcrumbs?: Array<{ name: string; path: string }>;
	nav?: NavItem[];
	siteContact?: Awaited<ReturnType<typeof getSiteContact>>;
	footerCourses?: { name: string }[];
	/** Hide the footer newsletter (About has its own closing CTA). */
	hideNewsletter?: boolean;
	/** Float the pill header over a full-bleed hero (Home does this by default). */
	overlayHeader?: boolean;
}

const { locale, t, dir } = useUi(Astro);
const { path: routePath } = stripLocalePrefix(Astro.url.pathname);
const isHome = routePath === "/";

const {
	title,
	titleIsComplete = false,
	pageTitle,
	description,
	keywords,
	image,
	canonical,
	robots,
	content,
	breadcrumbs,
	nav,
	siteContact: providedContact,
	footerCourses: providedFooterCourses,
	hideNewsletter = false,
	overlayHeader = false,
} = Astro.props;

const [settingsResult, contactResult, coursesResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	providedContact ? Promise.resolve(providedContact) : getSiteContact(locale),
	providedFooterCourses
		? Promise.resolve(null)
		: getLocalizedCollection("courses", locale, {
				status: "published",
				orderBy: { order: "asc" },
			}),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(contactResult.cacheHint);
	if (coursesResult) Astro.cache.set(coursesResult.cacheHint);
}

const footerCourseNames = providedFooterCourses ?? coursesResult!.entries
	.filter((c) => c.data.visible !== false)
	.map((c) => ({
		name:
			coursesResult!.fallbackLocale && c.id in t.catalog.courses
				? t.catalog.courses[c.id as keyof typeof t.catalog.courses].name
				: String(c.data.name ?? ""),
	}));

const { siteTitle, siteTagline, titleSeparator } = resolveSiteIdentity(settingsResult.data);
const localizedSiteName = contactResult.data.brandName;
const fullTitle = title
	? titleIsComplete || title.includes(siteTitle)
		? title
		: `${title} ${titleSeparator} ${siteTitle}`
	: siteTitle;

const headerItems = localizedNav(nav ?? [...site.nav], t, locale);
const headerCta = localizedCta(site.cta, t, locale);

// Floating WhatsApp button: the academy's best contact channel. Bottom-right
// and always visible; the back-to-top button stacks just above it so the two
// floating actions read as one column instead of opposing corners.
const whatsappFabHref = whatsappHref(
	contactResult.data.whatsappNumber || contactResult.data.phone,
);

const translations = content && !isHome
	? await getTranslations(content.collection, content.id)
	: null;
const translatedSlugs = new Map(
	(translations?.translations ?? [])
	.filter((translation) => translation.status === "published" && translation.slug)
		.map((translation) => [translation.locale, translation.slug]),
);

// CMS translations may use a different slug in each language.
const pathForLocale = (code: (typeof LOCALES)[number]) =>
	localizePath(
		isHome
			? "/"
			: content && translatedSlugs.has(code)
				? `/${translatedSlugs.get(code)}`
				: stripLocalePrefix(Astro.url.pathname).path,
		code,
	);
const localeAlternates = LOCALES.map((code) => ({
	hreflang: LOCALE_HREFLANG[code],
	href: `${Astro.url.origin}${pathForLocale(code)}`,
}));
const languagePaths = {
	en: pathForLocale("en"),
	ar: pathForLocale("ar"),
};

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteTagline || site.description,
	canonical: canonical ?? `${Astro.url.origin}${pathForLocale(locale)}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

// Structured data: the organization is described once per page, and the
// breadcrumb trail follows the visible page hierarchy in the active locale.
const origin = Astro.url.origin;
const organizationUrl = `${origin}${localizePath("/", locale)}`;
const logoUrl = new URL(
	contactResult.data.logoLight?.src || "/images/kanwal-logo-on-light.png",
	origin,
).href;
const crumbTrail = [{ name: t.nav.home, path: "/" }, ...(breadcrumbs ?? [])];
const organizationJsonLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: localizedSiteName,
	url: organizationUrl,
	logo: logoUrl,
	email: contactResult.data.email,
	telephone: contactResult.data.phone,
	address: {
		"@type": "PostalAddress",
		addressLocality: contactResult.data.address,
	},
	contactPoint: [
		{
			"@type": "ContactPoint",
			telephone: contactResult.data.phone,
			email: contactResult.data.email,
			contactType: "customer support",
			availableLanguage: ["English", "Arabic"],
		},
	],
	...(contactResult.data.socialLinks.length > 0
		? { sameAs: contactResult.data.socialLinks.map((link) => link.url) }
		: {}),
};
const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: crumbTrail.map((crumb, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: crumb.name,
		item: `${origin}${localizePath(crumb.path, locale)}`,
	})),
};
---

<!doctype html>
<html lang={locale} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			window.gtag = function () {
				window.dataLayer.push(arguments);
			};
			window.addEventListener(
				"load",
				function () {
					var loadAnalytics = function () {
						if (document.getElementById("google-analytics")) return;
						var script = document.createElement("script");
						script.id = "google-analytics";
						script.async = true;
						script.src = "https://www.googletagmanager.com/gtag/js?id=G-K83ZX1P07K";
						document.head.appendChild(script);
						window.gtag("js", new Date());
						window.gtag("config", "G-K83ZX1P07K");
					};
					var loadOnInteraction = function () {
						window.clearTimeout(analyticsTimer);
						loadAnalytics();
					};
					var analyticsTimer = window.setTimeout(loadAnalytics, 10000);
					window.addEventListener("pointerdown", loadOnInteraction, {
						once: true,
						passive: true,
					});
					window.addEventListener("keydown", loadOnInteraction, { once: true });
				},
				{ once: true },
			);
		</script>
		<meta name="theme-color" content="#FCFEFD" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0D1612" media="(prefers-color-scheme: dark)" />
		<script is:inline>
			(function () {
				try {
					var media = window.matchMedia("(prefers-color-scheme: dark)");
					var apply = function () {
						var url = new URL(window.location.href);
						var param = url.searchParams.get("theme");
						var stored = localStorage.getItem("theme");
						var theme =
							param === "light" || param === "dark"
								? param
								: stored === "light" || stored === "dark"
									? stored
									: media.matches
										? "dark"
										: "light";
						document.documentElement.setAttribute("data-theme", theme);
					};
					apply();
					media.addEventListener("change", apply);
					document.addEventListener("astro:after-swap", apply);
				} catch (e) {
					/* If storage is blocked, fall back to the light theme. */
				}
			})();
		</script>
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<script is:inline>
			(function () {
				try {
					if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
						document.documentElement.classList.add("js-motion");
						window.setTimeout(function () {
							if (document.documentElement.getAttribute("data-motion-ready") !== "1") {
								document.documentElement.classList.remove("js-motion");
							}
						}, 4000);
					}
				} catch (e) {
					/* Without matchMedia, leave the page static. */
				}
			})();
		</script>
		<title>{fullTitle}</title>
		{keywords && <meta name="keywords" content={keywords} />}
		{
			localeAlternates.map((alternate) => (
				<link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
			))
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={localeAlternates.find((alternate) => alternate.hreflang === "en")?.href}
		/>
		<meta property="og:locale" content={OG_LOCALE[locale]} />
		{
			localeAlternates
				.filter((alternate) => alternate.hreflang !== locale)
				.map((alternate) => (
					<meta property="og:locale:alternate" content={OG_LOCALE[alternate.hreflang as "en" | "ar"]} />
				))
		}
		<EmDashHead page={pageCtx} />
		<JsonLd data={organizationJsonLd} />
		<JsonLd data={breadcrumbJsonLd} />
		<Font cssVariable="--font-body" preload={[{ weight: 400, subset: "latin" }]} />
		{
			// The Arabic UI font ships only on /ar. Preload just the two
			// weights used above the fold (body 500, headings 700); the rest
			// stay font-display: swap. English pages never fetch this family.
			locale === "ar" && (
				<Font
					cssVariable="--font-arabic-ui"
					preload={[
						{ weight: 500, subset: "arabic" },
						{ weight: 700, subset: "arabic" },
					]}
				/>
			)
		}
		{locale === "ar" && <Font cssVariable="--font-arabic" />}
		<slot name="head" />
	</head>
	<body
		data-is-home={isHome ? true : undefined}
		data-overlay-header={overlayHeader ? true : undefined}
		data-locale={locale}
		data-locale-prefix={locale === "en" ? "" : `/${locale}`}
	>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">{t.a11y.skipToContent}</a>
		<div class="sheet">
			<Header
				items={headerItems}
				cta={headerCta}
				currentPath={Astro.url.pathname}
				siteName={localizedSiteName}
				headerMarkLight={contactResult.data.headerMarkLight}
				headerMarkDark={contactResult.data.headerMarkDark}
				languagePaths={languagePaths}
			/>
			<main id="main">
				<slot />
			</main>
			<Footer
				contact={contactResult.data}
				settingsEdit={contactResult.entry?.edit}
				siteName={localizedSiteName}
				courseNames={footerCourseNames}
				logoLight={contactResult.data.logoLight}
				logoDark={contactResult.data.logoDark}
				showNewsletter={!hideNewsletter}
			/>
			<MobileBar />
			<button
				type="button"
				class="page-go-top"
				data-page-top
				aria-label={t.a11y.backToTop}
				hidden
			>
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
					<path
						d="M12 19V5m-6 6 6-6 6 6"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</button>
			{whatsappFabHref && (
				<a
					href={whatsappFabHref}
					class="whatsapp-fab"
					target="_blank"
					rel="noopener noreferrer"
					aria-label={t.actions.whatsappUs}
					title={t.actions.whatsappUs}
				>
					<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false" fill="currentColor">
						<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
					</svg>
					<span class="visually-hidden">{t.actions.whatsappUs}</span>
				</a>
			)}
		</div>
		<EmDashBodyEnd page={pageCtx} />
		<script>
			import "../scripts/motion";
		</script>
		<script>
			// Global CTA controller: every [data-book-cta] button either brings
			// the visitor to the inline #book form (home) or navigates there with
			// the prefill values as query params (other pages and old deep links).
			document.addEventListener("click", (e) => {
				const target = e.target;
				if (!(target instanceof Element)) return;
				const btn = target.closest<HTMLElement>("[data-book-cta]");
				if (!btn) return;
				e.preventDefault();
				const plan = btn.dataset.prefillPlan ?? "";
				const course = btn.dataset.prefillCourse ?? "";
				const book = document.getElementById("book");
				if (!book) {
					const params = new URLSearchParams();
					if (plan) params.set("plan", plan);
					if (course) params.set("course", course);
					const qs = params.toString();
					const prefix = document.body.dataset.localePrefix ?? "";
					window.location.href = `${prefix}/contact-us${qs ? `?${qs}` : ""}#book`;
					return;
				}

				const selectOption = (field: string, value: string) => {
					if (!value) return;
					const select = book.querySelector(field) as HTMLSelectElement | null;
					if (!select) return;
					const option = Array.from(select.options).find((item) => {
						const needle = value.trim().toLowerCase();
						return (
							item.value.toLowerCase() === needle ||
							(item.dataset.optionId ?? "").toLowerCase() === needle ||
							(item.dataset.optionSlug ?? "").toLowerCase() === needle
						);
					});
					if (option) select.value = option.value;
				};

				selectOption("#book-plan", plan);
				selectOption("#book-course", course);
				const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				book.scrollIntoView({
					behavior: reducedMotion ? "auto" : "smooth",
					block: "start",
				});
				window.setTimeout(
					() =>
						(book.querySelector("#book-name") as HTMLInputElement | null)?.focus({
							preventScroll: true,
						}),
					reducedMotion ? 0 : 550,
				);
			});
		</script>
		<script>
			const goTop = document.querySelector<HTMLButtonElement>("[data-page-top]");
			if (goTop) {
				let hidden = true;
				const update = () => {
					const want = window.scrollY > 400;
					if (want !== !hidden) {
						goTop.toggleAttribute("hidden", !want);
						hidden = !want;
					}
				};
				window.addEventListener("scroll", update, { passive: true });
				update();
				document.addEventListener("astro:after-swap", update);
				goTop.addEventListener("click", () => {
					window.scrollTo({
						top: 0,
						behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
							? "auto"
							: "smooth",
					});
					goTop.focus();
				});
			}
		</script>
		<style>
			.page-go-top {
				position: fixed;
				inset-inline-end: 16px; /* max(16px, calc((100vw - var(--container)) / 2 + 8px)) */
				/* One gap above the 56px WhatsApp fab: 24 + 56 + 12. */
				bottom: 92px;
				z-index: 40;
				display: grid;
				place-items: center;
				/* Same footprint as the WhatsApp fab below it. */
				width: 56px;
				height: 56px;
				padding: 0;
				border: 1px solid var(--line);
				border-radius: 50%;
				background: var(--surface);
				color: var(--ink);
				box-shadow: 0 8px 24px -14px rgba(11, 26, 20, 0.4);
				transition:
					opacity 200ms var(--ease-out),
					transform 200ms var(--ease-out),
					background-color var(--transition),
					border-color var(--transition),
					color var(--transition);
			}

			.page-go-top:hover {
				background: var(--green);
				border-color: var(--green);
				color: var(--on-accent);
				transform: translateY(-2px);
			}

			.page-go-top:focus-visible {
				outline: 2px solid var(--focus);
				outline-offset: 3px;
			}

			.page-go-top[hidden] {
				opacity: 0;
				pointer-events: none;
				transform: translateY(8px);
			}

			@media (max-width: 560px) {
				.page-go-top {
					width: 52px;
					height: 52px;
				}

				.page-go-top svg {
					width: 22px;
					height: 22px;
				}
			}

			/* Clear of the mobile bottom bar and stacked above the WhatsApp fab. */
			@media (max-width: 767px) {
				.page-go-top {
					bottom: calc(var(--mobile-bar-height) + env(safe-area-inset-bottom) + 16px + 52px + 12px);
				}
			}

			/* Floating WhatsApp button: bottom-right, always visible; the
			 * back-to-top button stacks above it. */
			.whatsapp-fab {
				position: fixed;
				inset-inline-end: 16px;
				bottom: 24px;
				z-index: 40;
				display: grid;
				place-items: center;
				width: 56px;
				height: 56px;
				border-radius: 50%;
				background: var(--green-deep);
				color: var(--on-accent);
				box-shadow: 0 10px 28px -12px rgba(11, 26, 20, 0.55);
				transition:
					transform 200ms var(--ease-out),
					background-color var(--transition);
			}

			.whatsapp-fab:hover {
				background: var(--green);
				transform: translateY(-2px);
			}

			.whatsapp-fab:focus-visible {
				outline: 2px solid var(--focus);
				outline-offset: 3px;
			}

			@media (max-width: 767px) {
				.whatsapp-fab {
					bottom: calc(var(--mobile-bar-height) + env(safe-area-inset-bottom) + 16px);
					width: 52px;
					height: 52px;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.whatsapp-fab {
					transition: none;
				}

				.whatsapp-fab:hover {
					transform: none;
				}
			}
		</style>
	</body>
</html>
