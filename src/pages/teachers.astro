---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Section from "../components/Section.astro";

const { entries: teachers, cacheHint } = await getEmDashCollection("teachers", {
	status: "published",
	orderBy: { order: "asc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const initials = (name: string) =>
	name
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part[0]?.toUpperCase() ?? "")
		.join("");
---

<Base
	title="Teachers"
	description="Meet the teachers at Kanwal Quran Academy. One-to-one Qur'an lessons online."
>
	<Section space="tight">
		<Container>
			<div class="page-intro">
				<Eyebrow>Teachers</Eyebrow>
				<h1>Teachers who listen.</h1>
				<p>
					Every lesson is one to one. We match students with a teacher who fits their course,
					level and time zone.
				</p>
			</div>
		</Container>
	</Section>

	<Section space="tight">
		<Container>
			{
				teachers.length > 0 ? (
					<ul class="teacher-grid">
						{teachers.map((teacher) => (
							<li class="teacher-card">
								{teacher.data.photo ? (
									<div class="teacher-card__photo">
										<Image
											image={teacher.data.photo}
											alt={teacher.data.photo.alt || teacher.data.name}
										/>
									</div>
								) : (
									<div class="teacher-card__photo teacher-card__photo--initials" aria-hidden="true">
										{initials(teacher.data.name)}
									</div>
								)}
								<div class="teacher-card__body">
									<h2>{teacher.data.name}</h2>
									<p class="teacher-card__role">{teacher.data.role}</p>
									{teacher.data.bio && <p>{teacher.data.bio}</p>}
									{teacher.data.qualifications && (
										<ul class="teacher-card__qualifications">
											{teacher.data.qualifications
												.split("\n")
												.map((line) => line.trim())
												.filter(Boolean)
												.map((line) => (
													<li>{line}</li>
												))}
										</ul>
									)}
								</div>
							</li>
						))}
					</ul>
				) : (
					<div class="empty-note">
						<h2>Teacher profiles are being added.</h2>
						<p>
							We will introduce your teacher before your first class. Contact us and we will
							answer any questions about their experience and teaching style.
						</p>
						<Button href="/contact" variant="secondary">Contact us</Button>
					</div>
				)
			}
		</Container>
	</Section>
</Base>

<style>
	.teacher-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--space-xl);
	}

	.teacher-card {
		display: grid;
		align-content: start;
		gap: var(--space-md);
	}

	.teacher-card__photo {
		overflow: hidden;
		border-radius: var(--radius-card);
		background: var(--band);
		aspect-ratio: 4 / 3;
	}

	.teacher-card__photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.teacher-card__photo--initials {
		display: grid;
		place-items: center;
		color: var(--accent);
		font-family: var(--font-heading, Georgia, serif);
		font-size: 3rem;
		font-weight: 600;
	}

	.teacher-card__body h2 {
		font-size: var(--size-h3);
	}

	.teacher-card__role {
		margin-top: 4px;
		color: var(--accent);
		font-size: var(--size-small);
		font-weight: 600;
	}

	.teacher-card__body > p:not(.teacher-card__role) {
		margin-top: var(--space-sm);
		color: var(--ink-muted);
		font-size: var(--size-small);
	}

	.teacher-card__qualifications {
		display: grid;
		gap: 4px;
		margin-top: var(--space-sm);
		color: var(--ink-muted);
		font-size: var(--size-small);
	}

	.teacher-card__qualifications li {
		padding-inline-start: 14px;
		position: relative;
	}

	.teacher-card__qualifications li::before {
		content: "";
		position: absolute;
		inset-inline-start: 0;
		top: 0.7em;
		width: 5px;
		height: 1px;
		background: var(--accent);
	}

	.empty-note {
		max-width: 56ch;
		padding-top: var(--space-lg);
		border-top: 1px solid var(--line);
	}

	.empty-note h2 {
		font-size: var(--size-h3);
	}

	.empty-note p {
		margin-top: var(--space-md);
		color: var(--ink-muted);
	}

	.empty-note :global(.btn) {
		margin-top: var(--space-lg);
	}
</style>
