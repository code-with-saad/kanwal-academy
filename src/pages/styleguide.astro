---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Chip from "../components/Chip.astro";
import Container from "../components/Container.astro";
import CourseRow from "../components/CourseRow.astro";
import Eyebrow from "../components/Eyebrow.astro";
import PlanCard from "../components/PlanCard.astro";
import Section from "../components/Section.astro";
import Step from "../components/Step.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { site } from "../config/site";
import { useUi } from "../i18n";

const { locale } = useUi(Astro);

const themeTokens = [
	{ name: "--page", light: "#FCFEFD", dark: "#0D1612" },
	{ name: "--mint-300", light: "#A9D4C4", dark: "#1B3A2E" },
	{ name: "--mint-100", light: "#D6ECE2", dark: "#162A22" },
	{ name: "--mint-50", light: "#EAF5F0", dark: "#1A2F26" },
	{ name: "--ink", light: "#0B1A14", dark: "#EAF4EF" },
	{ name: "--ink-muted", light: "#5A6C63", dark: "#9DB3A8" },
	{ name: "--line", light: "#E1EBE6", dark: "#24362E" },
	{ name: "--green", light: "#0E8660", dark: "#3FC391" },
	{ name: "--green-deep", light: "#0A6B4B", dark: "#6FD9AE" },
	{ name: "--deep", light: "#0F3D2E", dark: "#0A1F18" },
];

const palette = [
	{ name: "page", value: "#FCFEFD" },
	{ name: "mint-300", value: "#A9D4C4" },
	{ name: "mint-100", value: "#D6ECE2" },
	{ name: "mint-50", value: "#EAF5F0" },
	{ name: "ink", value: "#0B1A14" },
	{ name: "ink-muted", value: "#5A6C63" },
	{ name: "line", value: "#E1EBE6" },
	{ name: "green", value: "#0E8660" },
	{ name: "green-deep", value: "#0A6B4B" },
	{ name: "deep", value: "#0F3D2E" },
];

const plans = [
	{
		slug: "plan-i",
		name: "Plan I",
		price: 20,
		classesPerWeek: 1,
		classesPerMonth: 4,
		hoursPerMonth: 2,
	},
	{
		slug: "plan-ii",
		name: "Plan II",
		price: 40,
		classesPerWeek: 2,
		classesPerMonth: 8,
		hoursPerMonth: 4,
		isPopular: true,
	},
	{
		slug: "plan-iii",
		name: "Plan III",
		price: 82,
		classesPerWeek: 4,
		classesPerMonth: 16,
		hoursPerMonth: 8,
	},
	{
		slug: "plan-iv",
		name: "Plan IV",
		price: 102,
		classesPerWeek: 5,
		classesPerMonth: 20,
		hoursPerMonth: 10,
	},
];

const courses = [
	{
		title: "Qur'anic Recitation",
		summary:
			"Build fluent, accurate recitation with a teacher who listens and corrects in real time.",
		level: "All levels",
	},
	{
		title: "Tajweed Proficiency",
		summary:
			"Learn the rules of tajweed and apply them consistently in your daily recitation.",
		level: "Intermediate",
	},
	{
		title: "Memorization Excellence",
		summary:
			"Follow a structured hifz plan with regular revision and one-to-one accountability.",
		level: "Advanced",
	},
];

const steps = [
	{
		title: "Book your free trial",
		body: "Choose a plan and pick a time that works for you. The trial class is free.",
	},
	{
		title: "Meet your teacher",
		body: "We match you with a teacher for your course and level, then assess where you are.",
	},
	{
		title: "Start your plan",
		body: "Your teacher builds a weekly schedule around your goals and keeps you accountable.",
	},
];
---

<Base
	title="Styleguide"
	description="Internal component and token reference for the Kanwal Quran Academy site."
	robots="noindex, nofollow"
>
	<Section space="tight">
		<Container>
			<div class="intro">
				<Eyebrow>Internal reference</Eyebrow>
				<h1>Styleguide</h1>
				<p>
					Every token and shared component in one place. This page is not indexed and is not part
					of the public navigation.
				</p>
				<div class="theme-demo">
					<ThemeToggle />
					<span>Try the theme switch. It also lives in the header and footer.</span>
				</div>
			</div>
		</Container>
	</Section>

	<Section tone="sand" space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow>Section and Container</Eyebrow>
				<h2>Layout primitives</h2>
				<p>
					<code>Section</code> sets the background and vertical rhythm. <code>Container</code> sets
					the 1200px content width and the 32px page gutter.
				</p>
			</div>
			<div class="demo-panel">
				<p>This panel sits inside a mint <code>Section</code> and a narrow <code>Container</code>.</p>
			</div>
		</Container>
	</Section>

	<Section space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow>Colour</Eyebrow>
				<h2>Mint palette</h2>
				<p>All colour comes from these tokens. No gradients and no off-palette accents.</p>
			</div>
			<ul class="swatches">
				{
					palette.map((colour) => (
						<li class="swatch">
							<span class="swatch__chip" style={`background: ${colour.value}`} aria-hidden="true" />
							<span class="swatch__name">{colour.name}</span>
							<span class="swatch__value">{colour.value}</span>
						</li>
					))
				}
			</ul>
		</Container>
	</Section>

	<Section space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow>Theme</Eyebrow>
				<h2>Semantic tokens, light and dark</h2>
				<p>
					Components use these tokens, not raw palette values. The page is full bleed on
					<code>--page</code> at every width.
				</p>
			</div>
			<ul class="theme-table">
				<li class="theme-row theme-row--head">
					<span>Token</span>
					<span>Light</span>
					<span>Dark</span>
				</li>
				{
					themeTokens.map((token) => (
						<li class="theme-row">
							<code class="theme-row__name">{token.name}</code>
							<span class="theme-row__value">
								<span class="theme-row__chip" style={`background: ${token.light}`} aria-hidden="true" />
								{token.light}
							</span>
							<span class="theme-row__value">
								<span class="theme-row__chip" style={`background: ${token.dark}`} aria-hidden="true" />
								{token.dark}
							</span>
						</li>
					))
				}
			</ul>
		</Container>
	</Section>

	<Section space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow>Typography</Eyebrow>
				<h2>One family, one scale</h2>
				<p>
					Figtree (400, 500, 600, 700) is loaded from this site and used for every piece of
					Latin text. On /ar, IBM Plex Sans Arabic is used for every Arabic UI string, while
					Amiri is reserved for Qur'anic text. Every component inherits <code>--font</code>.
					No other font-family is allowed outside the Arabic UI tokens.
				</p>
			</div>
			<ul class="type-scale">
				<li class="type-scale__row">
					<p class="type-scale__meta">display / 56 1.05 600, 36 on mobile</p>
					<p class="type-scale__display">
						Learn the <span class="heading-highlight">Qur'an</span>, one verse at a time.
					</p>
				</li>
				<li class="type-scale__row">
					<p class="type-scale__meta">h2 / 40 1.1 600, 28 on mobile</p>
					<p class="type-scale__h2">Courses built around your goals.</p>
				</li>
				<li class="type-scale__row">
					<p class="type-scale__meta">h3 / 24 1.25 600, 20 on mobile</p>
					<p class="type-scale__h3">A teacher who knows your name.</p>
				</li>
				<li class="type-scale__row">
					<p class="type-scale__meta">lead / 19 1.6 400</p>
					<p class="type-scale__lead">
						Every student starts with a free trial class. Meet your teacher before you choose a
						plan.
					</p>
				</li>
				<li class="type-scale__row">
					<p class="type-scale__meta">body / 17 1.6 400</p>
					<p class="type-scale__body">
						Lessons run live in a video call, so you only need a phone, tablet or laptop with a
						camera. Your teacher listens while you recite.
					</p>
				</li>
				<li class="type-scale__row">
					<p class="type-scale__meta">small / 14 1.5 500</p>
					<p class="type-scale__small">Classes each month, billing and schedule details.</p>
				</li>
				<li class="type-scale__row">
					<p class="type-scale__meta">eyebrow / 13 uppercase 600, tracking .12em</p>
					<Eyebrow>Small label</Eyebrow>
				</li>
				<li class="type-scale__row">
					<p class="type-scale__meta">Arabic / Amiri only</p>
					<p class="arabic" lang="ar" dir="rtl">{site.bismillah}</p>
				</li>
			</ul>
		</Container>
	</Section>

	<Section space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow>Buttons</Eyebrow>
				<h2>Primary and secondary, fully round</h2>
				<p>Primary fills <code>--green</code> with white text. Secondary is an outline. Height 48px (52px large).</p>
			</div>
			<div class="button-row">
				<Button href="/free-trial" variant="primary">Get free trial</Button>
				<Button href="/pricing" variant="secondary">View plans</Button>
				<Button href="/free-trial" variant="primary" size="lg">Large primary</Button>
			</div>
		</Container>
	</Section>

	{
		locale === "ar" && (
			<Section space="tight">
				<Container>
					<div class="section-head">
						<Eyebrow>اختيار الخط</Eyebrow>
						<h2>خط الواجهة العربية: مقارنة</h2>
						<p>
							الخط الحالي هو IBM Plex Sans Arabic. البديل هو Cairo. السطور أدناه
							بالأوزان والأحجام نفسها المستخدمة في الموقع، حتى تختار الأوضح
							للقراءة.
						</p>
					</div>
					<div class="font-compare">
						{[
							{
								name: "IBM Plex Sans Arabic",
								note: "الخط الحالي",
								className: "font-sample--plex",
							},
							{
								name: "Cairo",
								note: "البديل",
								className: "font-sample--cairo",
							},
						].map((font) => (
							<article class="font-card">
								<header class="font-card__head">
									<span class="font-card__badge">{font.note}</span>
									<span class="font-card__name" dir="ltr">{font.name}</span>
								</header>
								<div
									class:list={["font-card__sample", font.className]}
									lang="ar"
									dir="rtl"
								>
									<p class="font-card__h">اتلُ القرآن مع معلم يعرف اسمك.</p>
									<p class="font-card__body">
										دروس فردية في التلاوة والتجويد والحفظ. ابدأ بحصة تجريبية
										مجانية أينما كنت.
									</p>
									<p class="font-card__small">
										حصص كل شهر، والفوترة، وتفاصيل الجدول.
									</p>
									<div class="font-card__row">
										<span class="font-card__pill">تجربة مجانية</span>
										<span class="font-card__btn">احجز حصة تجريبية</span>
									</div>
								</div>
							</article>
						))}
					</div>
				</Container>
			</Section>
		)
	}

	<Section tone="dark" space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow>Buttons on dark</Eyebrow>
				<h2>Secondary inherits the current text colour</h2>
				<p>The outline uses the current text colour, so it stays legible on every dark panel.</p>
			</div>
			<div class="button-row">
				<Button href="/free-trial" variant="primary">Get free trial</Button>
				<Button href="/pricing" variant="secondary">View plans</Button>
			</div>
		</Container>
	</Section>

	<Section space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow>Chips</Eyebrow>
				<h2>Outlined pills, 36px tall</h2>
				<p>1px outline of <code>--ink</code> at 20%. Hover or selected fills <code>--green</code> with white text.</p>
			</div>
			<div class="chip-row">
				<Chip href="/courses/quranic-recitation">Qur'anic Recitation</Chip>
				<Chip href="/courses/tajweed-proficiency">Tajweed Proficiency</Chip>
				<Chip href="/courses/memorization-excellence">Memorization Excellence</Chip>
				<Chip href="/free-trial" selected>Free trial</Chip>
				<Chip>Plain chip</Chip>
			</div>
		</Container>
	</Section>

	<Section tone="sand" space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow>Plans</Eyebrow>
				<h2>PlanCard</h2>
				<p>
					Plan II is inverted. Cards have a 20px radius and sit on the page colour with a
					1px <code>--line</code> border.
				</p>
			</div>
			<div class="plan-grid">
				{
					plans.map((plan) => (
						<PlanCard plan={plan} />
					))
				}
			</div>
		</Container>
	</Section>

	<Section space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow>Courses</Eyebrow>
				<h2>CourseRow</h2>
				<p>Numbered rows. Hovering a row fills it with <code>--green</code> and white text.</p>
			</div>
			<ol class="course-list">
				{
					courses.map((course, index) => (
						<CourseRow
							index={index + 1}
							title={course.title}
							summary={course.summary}
							level={course.level}
							prefillCourse={course.title}
						/>
					))
				}
			</ol>
		</Container>
	</Section>

	<Section tone="sand" space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow>Free trial</Eyebrow>
				<h2>Step</h2>
				<p>Three steps in a row, each separated by a top rule.</p>
			</div>
			<ol class="step-grid">
				{
					steps.map((step, index) => (
						<Step number={index + 1} title={step.title} body={step.body} />
					))
				}
			</ol>
		</Container>
	</Section>

	<Section space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow>Featured plan</Eyebrow>
				<h2>PlanCard with bismillah</h2>
				<p>Used as the featured plan in darker panels.</p>
			</div>
			<div class="featured-demo">
				<PlanCard
					plan={plans[1]}
					href="/free-trial?plan=plan-ii"
				/>
			</div>
		</Container>
	</Section>
</Base>

<style>
	.intro {
		display: grid;
		gap: var(--space-md);
		max-width: 52ch;
	}

	.intro p {
		color: var(--ink-muted);
		font-size: var(--type-lead-size);
	}

	.section-head {
		display: grid;
		gap: var(--space-sm);
		max-width: 60ch;
		margin-bottom: var(--space-xl);
	}

	.section-head p {
		color: var(--ink-muted);
	}

	.section-head code {
		padding: 0.1em 0.35em;
		border-radius: 4px;
		background: color-mix(in srgb, var(--line) 45%, transparent);
		font-size: var(--type-small-size);
	}

	.demo-panel {
		padding: var(--space-lg) var(--space-xl);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--page);
	}

	.swatches {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
		gap: var(--space-md);
	}

	.swatch {
		display: grid;
		gap: 2px;
		padding: var(--space-sm);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--page);
	}

	.swatch__chip {
		height: 56px;
		margin-bottom: var(--space-xs);
		border: 1px solid var(--line);
		border-radius: var(--radius-input);
	}

	.swatch__name {
		font-size: var(--type-small-size);
		font-weight: 600;
	}

	.swatch__value {
		color: var(--ink-muted);
		font-size: var(--type-eyebrow-size);
		font-variant-numeric: tabular-nums;
	}

	.type-scale {
		display: grid;
		border-top: 1px solid var(--line);
	}

	.type-scale__row {
		display: grid;
		gap: var(--space-xs);
		padding-block: var(--space-lg);
		border-bottom: 1px solid var(--line);
	}

	.type-scale__meta {
		color: var(--ink-muted);
		font-size: var(--type-eyebrow-size);
		font-weight: 600;
		letter-spacing: var(--type-eyebrow-tracking);
		text-transform: uppercase;
	}

	.type-scale__display {
		font-size: var(--type-display-size);
		font-weight: var(--type-display-weight);
		line-height: var(--type-display-line);
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.type-scale__h2 {
		font-size: var(--type-h2-size);
		font-weight: var(--type-h2-weight);
		line-height: var(--type-h2-line);
	}

	.type-scale__h3 {
		font-size: var(--type-h3-size);
		font-weight: var(--type-h3-weight);
		line-height: var(--type-h3-line);
	}

	.type-scale__lead {
		font-size: var(--type-lead-size);
		line-height: var(--type-lead-line);
	}

	.type-scale__body {
		font-size: var(--type-body-size);
		line-height: var(--type-body-line);
	}

	.type-scale__small {
		font-size: var(--type-small-size);
		font-weight: var(--type-small-weight);
		line-height: var(--type-small-line);
	}

	.arabic {
		color: var(--green-deep);
		font-size: var(--type-h3-size);
		line-height: 1.8;
	}

	.button-row,
	.chip-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm);
	}

	.plan-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: var(--space-md);
	}

	.course-list {
		max-width: 820px;
	}

	.step-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-xl);
	}

	.featured-demo {
		max-width: 360px;
	}

	.theme-demo {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		margin-top: var(--space-md);
		color: var(--ink-muted);
		font-size: var(--type-small-size);
	}

	.theme-table {
		display: grid;
		border-top: 1px solid var(--line);
	}

	.theme-row {
		display: grid;
		grid-template-columns: 1.1fr 1fr 1fr;
		gap: var(--space-md);
		align-items: center;
		padding-block: 10px;
		border-bottom: 1px solid var(--line);
		font-size: var(--type-small-size);
	}

	.theme-row--head {
		color: var(--ink-muted);
		font-size: var(--type-eyebrow-size);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.theme-row__name {
		color: var(--green-deep);
	}

	.theme-row__value {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		color: var(--ink-muted);
		font-variant-numeric: tabular-nums;
	}

	.theme-row__chip {
		flex: none;
		width: 16px;
		height: 16px;
		border: 1px solid var(--line);
		border-radius: 3px;
	}

	@media (max-width: 560px) {
		.theme-row {
			grid-template-columns: 1fr 1fr;
		}

		.theme-row--head span:first-child {
			display: none;
		}

		.theme-row__name {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 760px) {
		.step-grid {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}
	}

	/* Arabic UI font comparison (/styleguide in ar only). */
	.font-compare {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-md);
	}

	.font-card {
		display: grid;
		gap: var(--space-md);
		padding: var(--space-lg);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		background: var(--surface);
	}

	.font-card__head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-xs);
		color: var(--ink-muted);
		font-size: var(--type-small-size);
	}

	.font-card__badge {
		display: inline-flex;
		align-items: center;
		height: 26px;
		padding-inline: 10px;
		border-radius: 999px;
		background: var(--mint-100);
		color: var(--green-deep);
		font-weight: 600;
	}

	.font-card__name {
		font-weight: 600;
		color: var(--ink);
	}

	.font-card__sample {
		display: grid;
		gap: var(--space-sm);
		direction: rtl;
		text-align: start;
	}

	.font-card__h {
		margin: 0;
		color: var(--ink);
		font-size: var(--type-h3-size);
		font-weight: 700;
		line-height: 1.45;
		letter-spacing: 0;
	}

	.font-card__body {
		margin: 0;
		color: var(--ink);
		font-size: var(--type-body-size);
		font-weight: 500;
		line-height: 1.8;
		letter-spacing: 0;
	}

	.font-card__small {
		margin: 0;
