---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Section from "../components/Section.astro";
import { emailHref, getSiteContact, phoneHref } from "../utils/site-config";

const [{ data: contact, cacheHint: contactCacheHint }, faqsResult] = await Promise.all([
	getSiteContact(),
	getEmDashCollection("faqs", {
		status: "published",
		orderBy: { order: "asc" },
	}),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(contactCacheHint);
	Astro.cache.set(faqsResult.cacheHint);
}

const faqs = faqsResult.entries;
---

<Base
	title="Contact"
	description="Contact Kanwal Quran Academy in Karachi, Pakistan by phone or email."
>
	<Section space="tight">
		<Container>
			<div class="page-intro">
				<Eyebrow>Contact</Eyebrow>
				<h1>Talk to us about your first class.</h1>
				<p>
					Tell us the student's age, the course you are interested in and your time zone. We will
					reply with the next available trial slot.
				</p>
			</div>
		</Container>
	</Section>

	<Section space="tight">
		<Container>
			<div class="contact-grid">
				<div class="contact-panel">
					<h2>Reach us directly</h2>
					<address class="contact-details">
						<span>{contact.address}</span>
						<a href={phoneHref(contact.phone)}>{contact.phone}</a>
						<a href={emailHref(contact.email)}>{contact.email}</a>
					</address>
					<div class="contact-actions">
						<Button href="/free-trial" variant="primary">Get free trial</Button>
						<Button href={emailHref(contact.email)} variant="secondary">Send an email</Button>
					</div>
					<p class="contact-note">
						We teach online, so students can join from any country. Lessons are scheduled in your
						time zone.
					</p>
				</div>

				<div class="contact-faqs">
					<h2>Common questions</h2>
					<ul class="faq-list">
						{
							faqs.map((faq) => (
								<li>
									<details>
										<summary>{faq.data.question}</summary>
										<p>{faq.data.answer}</p>
									</details>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</Container>
	</Section>
</Base>

<style>
	.contact-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(32px, 6vw, 80px);
		align-items: start;
	}

	.contact-panel h2,
	.contact-faqs h2 {
		font-size: var(--size-h3);
	}

	.contact-details {
		display: grid;
		gap: var(--space-sm);
		margin-top: var(--space-lg);
		color: var(--ink-muted);
		font-style: normal;
	}

	.contact-details a {
		color: var(--ink);
		text-decoration: none;
	}

	.contact-details a:hover {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-xl);
	}

	.contact-note {
		max-width: 42ch;
		margin-top: var(--space-lg);
		padding-top: var(--space-md);
		border-top: 1px solid var(--line);
		color: var(--ink-muted);
		font-size: var(--size-small);
	}

	.faq-list {
		margin-top: var(--space-lg);
	}

	.faq-list li {
		border-top: 1px solid var(--line);
	}

	.faq-list li:last-child {
		border-bottom: 1px solid var(--line);
	}

	.faq-list summary {
		padding-block: var(--space-md);
		font-weight: 600;
		cursor: pointer;
	}

	.faq-list summary:hover {
		color: var(--accent);
	}

	.faq-list details p {
		max-width: 62ch;
		padding-bottom: var(--space-md);
		color: var(--ink-muted);
		font-size: var(--size-small);
	}

	@media (max-width: 860px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
