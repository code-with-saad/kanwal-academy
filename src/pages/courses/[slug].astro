---
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Button from "../../components/Button.astro";
import Container from "../../components/Container.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Section from "../../components/Section.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: course, cacheHint } = await getEmDashEntry("courses", slug);
if (!course) return Astro.rewrite("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(course, {
	siteUrl: Astro.url.origin,
	path: `/courses/${course.id}`,
	defaultTitle: course.data.name,
	defaultDescription: course.data.summary,
});
---

<Base
	title={seo.title}
	pageTitle={course.data.name}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "courses", id: course.data.id, slug: course.id }}
>
	<Section space="tight">
		<Container size="narrow">
			<a href="/courses" class="back-link">All courses</a>

			<header class="course-header">
				<Eyebrow>{course.data.level}</Eyebrow>
				<h1 {...course.edit.name}>{course.data.name}</h1>
				<p class="course-summary" {...course.edit.summary}>{course.data.summary}</p>
			</header>

			<div class="prose" {...course.edit.description}>
				<PortableText value={course.data.description} />
			</div>

			<div class="course-actions">
				<Button href={`/free-trial?course=${encodeURIComponent(course.id)}`} variant="primary">
					Get free trial
				</Button>
				<Button href="/pricing" variant="secondary">View plans</Button>
			</div>
		</Container>
	</Section>
</Base>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: var(--space-xl);
		color: var(--ink-muted);
		font-size: var(--size-small);
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.course-header {
		margin-bottom: var(--space-xl);
	}

	.course-header h1 {
		margin-top: var(--space-md);
		font-size: var(--size-h2);
	}

	.course-summary {
		max-width: 52ch;
		margin-top: var(--space-md);
		color: var(--ink-muted);
		font-size: clamp(1.0625rem, 0.5vw + 1rem, 1.25rem);
	}

	.course-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-2xl);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--line);
	}
</style>
