---
/**
 * Courses page, in the About design language: mint hero panel with an
 * arch-framed photograph, the course journey rows, a method panel, the
 * "how a class works" steps and two course-specific feature splits. Page
 * copy lives in the courses_page collection; the journey copy stays shared
 * with Home.
 */
import { Font } from "astro:assets";
import { getEmDashEntry, getSeoMeta } from "emdash";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import CourseRow from "../../components/CourseRow.astro";
import CtaPanel from "../../components/CtaPanel.astro";
import Curve from "../../components/Curve.astro";
import FeatureSplit from "../../components/FeatureSplit.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import PageHero from "../../components/PageHero.astro";
import Section from "../../components/Section.astro";
import WisdomPanel from "../../components/WisdomPanel.astro";
import { getLocalizedCollection, localizePath, useUi } from "../../i18n";
import { getPageCopy } from "../../i18n/pages";
import { getCourseCopy } from "../../utils/catalog";
import { makeHomeText } from "../../utils/home-copy";
import { makePageImage, makePageRows, makePageText } from "../../utils/page-copy";
import { getSiteContact } from "../../utils/site-config";

const { locale, t } = useUi(Astro);
const copy = getPageCopy(locale).courses;

const [homeResult, coursesResult, pageResult, contactResult] = await Promise.all([
	getEmDashEntry("home_page", "home", { locale }),
	getLocalizedCollection("courses", locale, {
		status: "published",
		orderBy: { order: "asc" },
	}),
	getEmDashEntry("courses_page", "courses", { locale }),
	getSiteContact(locale),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(homeResult.cacheHint);
	Astro.cache.set(coursesResult.cacheHint);
	Astro.cache.set(pageResult.cacheHint);
	Astro.cache.set(contactResult.cacheHint);
}

const homePage = homeResult.entry;
const homeText = makeHomeText(
	homePage?.data as Record<string, unknown> | undefined,
	homeResult.fallbackLocale,
	locale,
	t,
);
// Page-specific copy lives in the Courses page collection; the shared Home
// journey heading and introduction still read the Home entry.
const pageData = pageResult.entry?.data as Record<string, unknown> | undefined;
const pageText = makePageText(pageData, pageResult.fallbackLocale, locale);
const pageRows = makePageRows(pageData, pageResult.fallbackLocale, locale);
const pageImage = makePageImage(pageData, pageResult.fallbackLocale, locale);
const seo =
	pageResult.entry && !pageResult.fallbackLocale
		? getSeoMeta(pageResult.entry, {
				siteUrl: Astro.url.origin,
				path: localizePath("/courses", locale),
				defaultTitle: copy.title,
				defaultDescription: copy.description,
			})
		: null;

const courses = coursesResult.entries.filter((course) => course.data.visible !== false);

const heroChips = pageRows<{ label: string }>(
	"hero_chips",
	copy.heroChips.map((label) => ({ label })),
).map((row) => row.label);
const lessonIcons = ["book-trial", "teacher", "calendar-check"] as const;
const lessonSteps = pageRows<{ title: string; text: string }>(
	"lessons_steps",
	copy.lessonsSteps,
).map((step, i) => ({ ...step, icon: lessonIcons[i] ?? "book-trial" }));

const split2List = pageText("split2_list_items", copy.split2List.join("\n"))
	.split("\n")
	.map((line) => line.trim())
	.filter(Boolean);
---

<Base
	title={seo?.title ?? copy.title}
	description={seo?.description ?? copy.description}
	image={seo?.ogImage ?? undefined}
	robots={seo?.robots ?? undefined}
	breadcrumbs={[{ name: t.nav.courses, path: "/courses" }]}
	overlayHeader
>
	<!-- Amiri carries the Arabic brand watermark in the hero. -->
	<Font slot="head" cssVariable="--font-arabic" />

	<div class="inner">
		<PageHero
			eyebrow={pageText("eyebrow", copy.eyebrow)}
			headingBefore={pageText("hero_heading_before", copy.headingBefore)}
			headingHighlight={pageText("hero_heading_highlight", copy.headingHighlight)}
			headingAfter={pageText("hero_heading_after", copy.headingAfter)}
			heading={pageText("heading", copy.heading)}
			lead={pageText("lead", copy.lead)}
			imageSrc={pageImage("hero_image")?.src ?? "/images/hero-courses.png"}
			imageAlt={pageText("hero_image_alt", copy.heroImageAlt)}
			badge={pageText("hero_badge", copy.heroBadge)}
			chips={heroChips}
		/>

		<Section id="courses">
			<Container>
				<div class="journey-head">
					<div class="journey-head__copy">
						<h2>{homeText("courses_journey_heading")}</h2>
						<p>{homeText("courses_journey_intro")}</p>
					</div>
				</div>

				<ol class="journey-list">
					{
						courses.map((course, index) => (
							<CourseRow
								index={index + 1}
								title={getCourseCopy(course, coursesResult.fallbackLocale, t).name}
								summary={getCourseCopy(course, coursesResult.fallbackLocale, t).summary}
								level={getCourseCopy(course, coursesResult.fallbackLocale, t).level}
								arabic={locale === "ar" ? undefined : course.data.arabic_name}
								prefillCourse={course.id}
							/>
						))
					}
				</ol>

				<p class="journey-note">{pageText("note", copy.note)}</p>
			</Container>
		</Section>

		<Section tone="sand" class="section--curve">
			<Container>
				<WisdomPanel
					eyebrow={pageText("method_eyebrow", copy.methodEyebrow)}
					titleBefore={pageText("method_heading_before", copy.methodBefore)}
					titleHighlight={pageText("method_heading_highlight", copy.methodHighlight)}
					titleAfter={pageText("method_heading_after", copy.methodAfter)}
					paragraph1={pageText("method_text", copy.methodText)}
					image={pageImage("method_image")}
					imageSrc="/images/section-phone.png"
					imageAlt={pageText("method_image_alt", copy.methodImageAlt)}
					years={contactResult.data.stats.years}
					imageMaxHeight={420}
				/>
			</Container>
			<Curve fill="var(--page)" line="var(--mint-300)" />
		</Section>

		<Section id="how-it-works">
			<Container>
				<HowItWorks
					eyebrow={pageText("lessons_eyebrow", copy.lessonsEyebrow)}
					heading={pageText("lessons_heading", copy.lessonsHeading)}
					steps={lessonSteps}
				/>
			</Container>
		</Section>

		<Section tone="sand" class="section--curve">
			<Container>
				<div class="study-stack">
					<FeatureSplit
						headingBefore={pageText("split1_heading_before", copy.split1Before)}
						headingHighlight={pageText("split1_heading_highlight", copy.split1Highlight)}
						headingAfter={pageText("split1_heading_after", copy.split1After)}
						paragraphs={[
							pageText("split1_paragraph_1", copy.split1Text1),
							pageText("split1_paragraph_2", copy.split1Text2),
						]}
						image={pageImage("split1_image")}
						imageSrc="/images/section-phone.png"
						imageAlt={pageText("split1_image_alt", copy.split1ImageAlt)}
						imageLabel={pageText("split1_image_label", copy.split1ImageLabel)}
						imageRatio="4 / 3"
						buttonLabel={t.actions.bookFreeTrial}
					/>

					<FeatureSplit
						headingBefore={pageText("split2_heading_before", copy.split2Before)}
						headingHighlight={pageText("split2_heading_highlight", copy.split2Highlight)}
						headingAfter={pageText("split2_heading_after", copy.split2After)}
						paragraphs={[pageText("split2_paragraph_1", copy.split2Text1)]}
						image={pageImage("split2_image")}
						imageSrc="/images/section-memorize.jpg"
						imageAlt={pageText("split2_image_alt", copy.split2ImageAlt)}
						imageLabel={pageText("split2_image_label", copy.split2ImageLabel)}
						imageRatio="4 / 3"
						list={split2List}
						buttonLabel={t.actions.bookFreeTrial}
						imageFirst
					/>
				</div>
			</Container>
			<Curve fill="var(--page)" line="var(--mint-300)" />
		</Section>

		<CtaPanel
			heading={pageText("cta_heading", copy.ctaHeading)}
			text={pageText("cta_text", copy.ctaText)}
			primaryHref={localizePath("/contact-us#book", locale)}
			primaryLabel={t.actions.bookFreeTrial}
			secondaryHref={localizePath("/pricing", locale)}
			secondaryLabel={t.actions.seePlans}
		/>
	</div>
</Base>

<style>
	/* One rhythm for the whole page, same as About: 96px desktop, 56px mobile. */
	.inner {
		--section-gap: clamp(56px, 8vw, 96px);
	}

	.inner :global(.section--space-normal),
	.inner :global(.section--space-tight) {
		padding-block: var(--section-gap);
	}

	.inner :global(.section--curve) {
		position: relative;
		overflow: clip;
	}

	.journey-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-lg);
		margin-bottom: var(--space-xl);
	}

	.journey-head__copy {
		display: grid;
		gap: var(--space-md);
		max-width: 54ch;
	}

	.journey-head__copy p {
		max-width: 48ch;
		color: var(--type-copy-color);
	}

	.journey-list {
		display: grid;
	}

	.journey-note {
		margin-top: var(--space-lg);
		max-width: 60ch;
		color: var(--type-copy-color);
		font-size: var(--type-small-size);
		line-height: var(--type-small-line);
	}

	.study-stack {
		display: grid;
		gap: clamp(56px, 8vw, 104px);
	}
</style>