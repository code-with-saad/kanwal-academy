---
/**
 * Courses page. Renders the same "Start your journey" section as the Home
 * page: course rows and both feature splits with their images.
 */
import { getEmDashEntry } from "emdash";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import CourseRow from "../../components/CourseRow.astro";
import CtaPanel from "../../components/CtaPanel.astro";
import FeatureSplit from "../../components/FeatureSplit.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import { getLocalizedCollection, localizePath, useUi } from "../../i18n";
import { getPageCopy } from "../../i18n/pages";
import { getCourseCopy } from "../../utils/catalog";
import { makeHomeText } from "../../utils/home-copy";
import { makePageText } from "../../utils/page-copy";

const { locale, t } = useUi(Astro);
const copy = getPageCopy(locale).courses;

const [homeResult, coursesResult, pageResult] = await Promise.all([
	getEmDashEntry("pages", "home", { locale }),
	getLocalizedCollection("courses", locale, {
		status: "published",
		orderBy: { order: "asc" },
	}),
	getEmDashEntry("courses_page", "courses", { locale }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(homeResult.cacheHint);
	Astro.cache.set(coursesResult.cacheHint);
	Astro.cache.set(pageResult.cacheHint);
}

const homePage = homeResult.entry;
const homeText = makeHomeText(
	homePage?.data as Record<string, unknown> | undefined,
	homeResult.fallbackLocale,
	locale,
	t,
);
// Page-specific copy lives in the Courses page collection; shared Home
// sections (journey, splits) still read the Home entry.
const pageText = makePageText(
	pageResult.entry?.data as Record<string, unknown> | undefined,
	pageResult.fallbackLocale,
	locale,
);

const courses = coursesResult.entries.filter((course) => course.data.visible !== false);

const split2List = homeText("split2_list_items")
	.split("\n")
	.map((line) => line.trim())
	.filter(Boolean);
---

<Base
	title={copy.title}
	description={copy.description}
	breadcrumbs={[{ name: t.nav.courses, path: "/courses" }]}
>
	<Section space="tight">
		<Container>
			<PageHeader
				eyebrow={pageText("eyebrow", copy.eyebrow)}
				heading={pageText("heading", copy.heading)}
				lead={pageText("lead", copy.lead)}
			/>
		</Container>
	</Section>

	<Section id="courses">
		<Container>
			<div class="journey-head">
				<div class="journey-head__copy">
					<h2>{homeText("courses_journey_heading")}</h2>
					<p>{homeText("courses_journey_intro")}</p>
				</div>
			</div>

			<ol class="journey-list">
				{
					courses.map((course, index) => (
						<CourseRow
							index={index + 1}
							title={getCourseCopy(course, coursesResult.fallbackLocale, t).name}
							summary={getCourseCopy(course, coursesResult.fallbackLocale, t).summary}
							level={getCourseCopy(course, coursesResult.fallbackLocale, t).level}
							arabic={locale === "ar" ? undefined : course.data.arabic_name}
							prefillCourse={course.id}
						/>
					))
				}
			</ol>

			<div class="study-stack">
				<FeatureSplit
					headingBefore={homeText("split1_heading_before")}
					headingHighlight={homeText("split1_heading_highlight")}
					paragraphs={[
						homeText("split1_paragraph_1"),
						homeText("split1_paragraph_2"),
					]}
					image={homePage?.data.split1_image}
					imageSrc="/images/section-phone.png"
					imageAlt={homeText("split1_image_alt") || t.images.split1}
					imageLabel={homeText("split1_image_label")}
					imageRatio="4 / 3"
					buttonLabel={t.actions.bookFreeTrial}
				/>

				<FeatureSplit
					headingBefore={homeText("split2_heading_before")}
					headingHighlight={homeText("split2_heading_highlight")}
					paragraphs={[homeText("split2_paragraph_1")]}
					image={homePage?.data.split2_image}
					imageSrc="/images/section-memorize.jpg"
					imageAlt={homeText("split2_image_alt") || t.images.split2}
					imageLabel={homeText("split2_image_label")}
					imageRatio="4 / 3"
					list={split2List}
					buttonLabel={t.actions.bookFreeTrial}
					imageFirst
				/>
			</div>
		</Container>
	</Section>

	<CtaPanel
		heading={pageText("cta_heading", copy.ctaHeading)}
		text={pageText("cta_text", copy.ctaText)}
		primaryHref={localizePath("/contact-us#book", locale)}
		primaryLabel={t.actions.bookFreeTrial}
		secondaryHref={localizePath("/pricing", locale)}
		secondaryLabel={t.actions.seePlans}
	/>
</Base>

<style>
	.journey-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-lg);
		margin-bottom: var(--space-xl);
	}

	.journey-head__copy {
		display: grid;
		gap: var(--space-md);
		max-width: 54ch;
	}

	.journey-head__copy p {
		max-width: 48ch;
		color: var(--type-copy-color);
	}

	.journey-list {
		display: grid;
	}

	.study-stack {
		display: grid;
		gap: clamp(56px, 8vw, 104px);
		margin-top: clamp(56px, 8vw, 104px);
	}
</style>
