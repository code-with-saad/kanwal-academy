---
import { getEmDashCollection, getEmDashEntry, getSeoMeta } from "emdash";
import type { ContentEntry, ImageValue } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import BookTrial from "../components/BookTrial.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import CourseRow from "../components/CourseRow.astro";
import Eyebrow from "../components/Eyebrow.astro";
import FeatureCards from "../components/FeatureCards.astro";
import FeatureSplit from "../components/FeatureSplit.astro";
import HowItWorks from "../components/HowItWorks.astro";
import PlanCard from "../components/PlanCard.astro";
import PricingCarousel from "../components/PricingCarousel.astro";
import Section from "../components/Section.astro";
import StandingOut from "../components/StandingOut.astro";
import StatsBand from "../components/StatsBand.astro";
import Testimonials from "../components/Testimonials.astro";
import WisdomPanel from "../components/WisdomPanel.astro";
import { site } from "../config/site";
import { heroImage } from "../config/images";
import { getSiteContact } from "../utils/site-config";
import { isDemoMode } from "../utils/env";
import { formatUsdPrice } from "../utils/price";
import { hasDigits, isolateLtr } from "../utils/number";
import { getLocalizedCollection, localizePath, useUi } from "../i18n";
import type { Page } from "../../emdash-env";

interface HomePageFields {
	home_headline?: string;
	home_lead?: string;
	home_image?: ImageValue;
	home_reach_text?: string;
	home_cta_label?: string;
	feature_card_1_title?: string;
	feature_card_1_text?: string;
	feature_card_1_chip?: string;
	feature_card_2_title?: string;
	feature_card_2_text?: string;
	feature_card_3_title?: string;
	feature_card_3_text?: string;
	feature_card_4_title?: string;
	feature_card_4_text?: string;
	courses_journey_heading?: string;
	courses_journey_intro?: string;
	courses_format_label?: string;
	split1_heading_before?: string;
	split1_heading_highlight?: string;
	split1_paragraph_1?: string;
	split1_paragraph_2?: string;
	split1_image?: ImageValue;
	split1_image_label?: string;
	split2_heading_before?: string;
	split2_heading_highlight?: string;
	split2_paragraph_1?: string;
	split2_list_items?: string;
	split2_image?: ImageValue;
	split2_image_label?: string;
	stats_eyebrow?: string;
	stats_heading?: string;
	stats_description?: string;
	about_eyebrow?: string;
	about_title_before?: string;
	about_title_highlight?: string;
	about_paragraph_1?: string;
	about_paragraph_2?: string;
	about_image?: ImageValue;
	about_image_alt?: string;
	standing_eyebrow?: string;
	standing_heading?: string;
	standing_item_1_title?: string;
	standing_item_1_text?: string;
	standing_item_2_title?: string;
	standing_item_2_text?: string;
	standing_item_3_title?: string;
	standing_item_3_text?: string;
	pricing_eyebrow?: string;
	pricing_heading?: string;
	pricing_intro?: string;
	pricing_period_label?: string;
	pricing_classes_week_label?: string;
	pricing_classes_month_label?: string;
	pricing_hours_label?: string;
	pricing_popular_label?: string;
	pricing_select_cta?: string;
	trial_eyebrow?: string;
	trial_heading?: string;
	trial_step_1_title?: string;
	trial_step_1_body?: string;
	trial_step_2_title?: string;
	trial_step_2_body?: string;
	trial_step_3_title?: string;
	trial_step_3_body?: string;
	testimonials_heading?: string;
	book_eyebrow?: string;
	book_heading?: string;
	book_lead?: string;
	book_contact_label?: string;
	book_note?: string;
	book_form_title?: string;
	book_form_sub?: string;
	book_submit_label?: string;
}

type HomeTextField = {
	[K in keyof HomePageFields]-?: HomePageFields[K] extends string | undefined ? K : never;
}[keyof HomePageFields];

const { locale, t } = useUi(Astro);

const [
	coursesResult,
	plansResult,
	testimonialsResult,
	contactResult,
	homeResult,
] = await Promise.all([
	getLocalizedCollection("courses", locale, {
		status: "published",
		orderBy: { order: "asc" },
	}),
	getLocalizedCollection("plans", locale, {
		status: "published",
		orderBy: { order: "asc" },
	}),
	getEmDashCollection("testimonials", {
		locale,
		status: "published",
		orderBy: { order: "asc" },
	}),
	getSiteContact(locale),
	getEmDashEntry("pages", "home", { locale }),
]);

// Home content is edited in EmDash and should never be served from a stale
// route or edge response. The other page routes retain their normal caching.
Astro.response.headers.set("Cache-Control", "no-store");

const courses = coursesResult.entries.filter(
	(c) => c.data.visible !== false,
);
const plans = plansResult.entries.filter(
	(p) => p.data.visible !== false,
);
const testimonials = testimonialsResult.entries.filter(
	(testimonial) =>
		testimonial.data.consent_given === true &&
		testimonial.data.visible !== false,
);
const contact = contactResult.data;
const demo = isDemoMode();
const navItems = [...site.nav];

const getCourseCopy = (course: (typeof courses)[number]) => {
	if (coursesResult.fallbackLocale && course.id in t.catalog.courses) {
		return t.catalog.courses[course.id as keyof typeof t.catalog.courses];
	}
	return {
		name: String(course.data.name ?? ""),
		summary: String(course.data.summary ?? ""),
		level: String(course.data.level ?? ""),
	};
};

const getPlanName = (plan: (typeof plans)[number]) =>
	plansResult.fallbackLocale && plan.id in t.catalog.plans
		? t.catalog.plans[plan.id as keyof typeof t.catalog.plans]
		: String(plan.data.name ?? "");

const homePage = homeResult.entry as ContentEntry<Page & HomePageFields> | null;
// Prefer the CMS value whenever it is present, even an empty string (which
// means the editor intentionally cleared the field). Only fall back when the
// field is truly missing (null/undefined), never to hide a CMS value behind a
// hard-coded default or an empty-string fallback.
const homeText = (field: HomeTextField): string => {
	if (locale !== "en" && homeResult.fallbackLocale) return t.home[field];
	const value = homePage?.data[field];
	if (value == null) return t.home[field];
	return typeof value === "string" ? value.trim() : t.home[field];
};
const homeEdit = homeResult.fallbackLocale ? undefined : homePage?.edit;
const seo = homePage && !homeResult.fallbackLocale
	? getSeoMeta(homePage, {
			siteUrl: Astro.url.origin,
			path: localizePath("/", locale),
			defaultTitle: site.name,
			defaultDescription: site.description,
		})
	: null;

const rawHeadline = homeText("home_headline");
// Strip markdown-style asterisks the CMS uses for word highlighting.
const heroHeadline = rawHeadline.replace(/\*([^*]+)\*/g, "$1");
const heroLead = homeText("home_lead");

const toPlanCard = (plan: (typeof plans)[number]) => ({
	slug: plan.id,
	name: getPlanName(plan),
	price: plan.data.price,
	currencySymbol: plan.data.currency_symbol ?? "$",
	// The CMS stores an English "/ month"; Arabic uses the localized label.
	billingPeriod: locale === "en" ? (plan.data.billing_period ?? "/ month") : undefined,
	classesPerWeek: plan.data.classes_per_week,
	classesPerMonth: plan.data.classes_per_month,
	hoursPerMonth: plan.data.hours_per_month,
	isPopular: plan.data.is_popular ?? false,
});

const lowestPlanPrice = plans.length
	? Math.min(...plans.map((plan) => Number(plan.data.price)))
	: 20;

// Build the four floating feature cards from CMS values, interpolating dynamic tokens.
// Numeric tokens are wrapped in an LTR isolate so "5+" and "$20" keep their
// order inside the Arabic sentence instead of rendering as "+5" and "20$".
const replaceTokens = (template: string, tokens: Record<string, string | number>) =>
	template.replace(/\{(\w+)\}/g, (match, key) => {
		const value = tokens[key];
		if (value === undefined) return match;
		const text = String(value);
		return hasDigits(text) ? isolateLtr(text) : text;
	});

const featureTokens = {
	countries: contact.stats.countries,
	price: formatUsdPrice(lowestPlanPrice),
};

const featureCards = [
	{
		title: replaceTokens(homeText("feature_card_1_title"), featureTokens),
		text: replaceTokens(homeText("feature_card_1_text"), featureTokens),
		href: "#book",
		icon: "trial" as const,
		isFirst: true,
		chipLabel: homeText("feature_card_1_chip"),
	},
	{
		title: replaceTokens(homeText("feature_card_2_title"), featureTokens),
		text: replaceTokens(homeText("feature_card_2_text"), featureTokens),
		href: "#pricing",
		icon: "price" as const,
	},
	{
		title: replaceTokens(homeText("feature_card_3_title"), featureTokens),
		text: replaceTokens(homeText("feature_card_3_text"), featureTokens),
		href: testimonials.length > 0 || demo ? "#testimonials" : "#about",
		icon: "globe" as const,
	},
	{
		title: replaceTokens(homeText("feature_card_4_title"), featureTokens),
		text: replaceTokens(homeText("feature_card_4_text"), featureTokens),
		href: "#how-it-works",
		icon: "device" as const,
	},
];

// Standing out items from CMS
const standingItems = [
	{
		number: "01",
		title: homeText("standing_item_1_title"),
		text: homeText("standing_item_1_text"),
		icon: "clock" as const,
	},
	{
		number: "02",
		title: homeText("standing_item_2_title"),
		text: homeText("standing_item_2_text"),
		icon: "book" as const,
	},
	{
		number: "03",
		title: homeText("standing_item_3_title"),
		text: homeText("standing_item_3_text"),
		icon: "screens" as const,
	},
];

// How it works steps from CMS
const howItWorksSteps = [
	{
		title: homeText("trial_step_1_title"),
		text: homeText("trial_step_1_body"),
		icon: "book-trial" as const,
	},
	{
		title: homeText("trial_step_2_title"),
		text: homeText("trial_step_2_body"),
		icon: "teacher" as const,
	},
	{
		title: homeText("trial_step_3_title"),
		text: homeText("trial_step_3_body"),
		icon: "calendar-check" as const,
	},
];

// Split list items from newline-separated CMS text
const split2List = homeText("split2_list_items")
	.split("\n")
	.map((line) => line.trim())
	.filter(Boolean);

// Course pills for the hero header area
type CoursePill = {
	href: string;
	label: string;
	icon: "book" | "waves" | "bookmark" | "headset";
};
const coursePills: CoursePill[] = courses.slice(0, 3).map((c, i) => ({
	href: localizePath("/#courses", locale),
	label: getCourseCopy(c).name,
	icon: (["book", "waves", "bookmark"] as const)[i] ?? "book",
}));
coursePills.push({
	href: localizePath("/#book", locale),
	label: homeText("courses_format_label"),
	icon: "headset" as const,
});

// The testimonials section is only rendered when it has content.
const hasTestimonials = testimonials.length > 0 || demo;
---

<Base
	title={
		locale === "ar"
			? "أكاديمية كنول | دروس القرآن الكريم والتجويد عبر الإنترنت"
			: "Online Quran Classes with Certified Tutors | Kanwal Quran Academy"
	}
	titleIsComplete
	description={
		locale === "ar"
			? "تعلم القرآن الكريم عبر الإنترنت مع معلمين معتمدين. تقدم أكاديمية كنول دورات مخصصة في التلاوة، التجويد، وتحفيظ القرآن. احجز جلستك التجريبية المجانية."
			: "Learn Quran online with personalized one-on-one sessions. Kanwal Quran Academy offers expert courses in Recitation, Tajweed, and Hifz. Book a free trial today."
	}
	keywords={
		locale === "ar"
			? "أكاديمية تحفيظ القرآن, تعلم القرآن عن بعد, دروس تجويد, معلم قرآن, أكاديمية كنول"
			: "online quran academy, learn quran online, online tajweed classes, online hifz program, quran tutor, kanwal quran academy"
	}
	image={seo?.ogImage}
	canonical={
		locale === "ar"
			? "https://kanwalquranacademy.com/ar/"
			: "https://kanwalquranacademy.com/"
	}
	robots={seo?.robots}
	content={
		homePage ? { collection: "pages", id: homePage.data.id, slug: homePage.id } : undefined
	}
	nav={navItems}
>
	<!-- ===== HERO ===== -->
	<section id="home" class="hero" data-hero>
		<!-- Gradient background -->
		<div class="hero__bg" aria-hidden="true"></div>

		<!-- Star motifs near edges -->
		<div class="hero__stars" aria-hidden="true">
			<svg class="hero__star hero__star--tl" viewBox="0 0 80 80" width="80" height="80">
				<g fill="none" stroke="currentColor" stroke-width="0.8">
					<rect x="20" y="20" width="40" height="40" />
					<rect x="20" y="20" width="40" height="40" transform="rotate(45 40 40)" />
					<circle cx="40" cy="40" r="14" />
				</g>
			</svg>
			<svg class="hero__star hero__star--tr" viewBox="0 0 80 80" width="64" height="64">
				<g fill="none" stroke="currentColor" stroke-width="0.8">
					<rect x="20" y="20" width="40" height="40" />
					<rect x="20" y="20" width="40" height="40" transform="rotate(45 40 40)" />
					<circle cx="40" cy="40" r="14" />
				</g>
			</svg>
			<svg class="hero__star hero__star--bl" viewBox="0 0 80 80" width="56" height="56">
				<g fill="none" stroke="currentColor" stroke-width="0.8">
					<rect x="20" y="20" width="40" height="40" />
					<rect x="20" y="20" width="40" height="40" transform="rotate(45 40 40)" />
					<circle cx="40" cy="40" r="14" />
				</g>
			</svg>
			<svg class="hero__star hero__star--br" viewBox="0 0 80 80" width="72" height="72">
				<g fill="none" stroke="currentColor" stroke-width="0.8">
					<rect x="20" y="20" width="40" height="40" />
					<rect x="20" y="20" width="40" height="40" transform="rotate(45 40 40)" />
					<circle cx="40" cy="40" r="14" />
				</g>
			</svg>
		</div>

		<Container>
			<div class="hero__grid">
				<!-- Left: Copy -->
				<div class="hero__copy" data-reveal="up">
					<h1 class="hero__headline" {...homeEdit?.home_headline}>{heroHeadline}</h1>
					<p class="hero__lead" data-reveal="up" data-reveal-delay="120" {...homeEdit?.home_lead}>
						{heroLead}
					</p>
					<p class="hero__reach" data-reveal="up" data-reveal-delay="200">
						<svg
							class="hero__reach-icon"
							viewBox="0 0 20 20"
							width="18"
							height="18"
							aria-hidden="true"
							focusable="false"
						>
							<circle cx="10" cy="10" r="8.5" fill="none" stroke="currentColor" stroke-width="1.3" />
							<ellipse cx="10" cy="10" rx="3.5" ry="8.5" fill="none" stroke="currentColor" stroke-width="1.3" />
							<path d="M1.5 10h17" stroke="currentColor" stroke-width="1.3" />
						</svg>
						<span>{replaceTokens(homeText("home_reach_text"), { countries: contact.stats.countries })}</span>
					</p>
					<button type="button" class="hero__cta" data-book-cta data-reveal="up" data-reveal-delay="280">
						{homeText("home_cta_label")}
						<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M4 10h12m-5-5 5 5-5 5" />
						</svg>
					</button>
				</div>

				<!-- Right: Visual + Chips -->
				<div class="hero__visual-group">
					<!-- Desktop: circle + chips side by side -->
					<!-- Mobile: white card containing both -->
					<div class="hero__visual-card">
						<div class="hero__visual">
							<div class="quran-stage">
								<!-- Mint circle backdrop -->
								<span class="quran-stage__backdrop" aria-hidden="true"></span>
								<!-- Ornamental geometric ring (rotating) -->
								<svg class="quran-stage__ring" viewBox="0 0 200 200" aria-hidden="true">
									<g fill="none" stroke="currentColor" stroke-width="0.55" opacity="0.35">
										<circle cx="100" cy="100" r="96" />
										<path d="M100 6 L108 92 L194 100 L108 108 L100 194 L92 108 L6 100 L92 92 Z" />
										<path d="M100 6 L108 92 L194 100 L108 108 L100 194 L92 108 L6 100 L92 92 Z" transform="rotate(22.5 100 100)" />
										<circle cx="100" cy="100" r="72" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(45 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(90 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(135 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(180 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(225 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(270 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(315 100 100)" />
										<circle cx="100" cy="100" r="48" />
									</g>
								</svg>
								<!-- Quran image -->
								<figure class="quran-stage__figure" {...homeEdit?.home_image}>
									<span class="quran-stage__float">
										{
											homePage?.data.home_image ? (
												<Image
													image={homePage.data.home_image}
													alt={t.images.hero}
													class="quran-stage__image"
													priority
												/>
											) : (
												<img src={heroImage.src} alt={t.images.hero} class="quran-stage__image" />
											)
										}
									</span>
								</figure>
							</div>
						</div>

						<!-- Course pill chips -->
						<div class="hero__chips">
							{
								coursePills.map((pill) => (
									<a href={pill.href} class="course-pill">
										<span class="course-pill__icon" aria-hidden="true">
											{pill.icon === "book" && (
												<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
													<path d="M12 6.1c-1.9-1.55-4.25-2-7-1.9v13.6c2.75-.1 5.1.35 7 1.9 1.9-1.55 4.25-2 7-1.9V4.2c-2.75-.1-5.1.35-7 1.9zm0 0v13.6" />
												</svg>
											)}
											{pill.icon === "waves" && (
												<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
													<path d="M5.25 10.5v3M8.5 8.25v7.5M12 6.25v11.5M15.5 8.25v7.5M18.75 10.5v3" />
												</svg>
											)}
											{pill.icon === "bookmark" && (
												<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
													<path d="M7.25 4.5h9.5v15l-4.75-3.5-4.75 3.5z" />
												</svg>
											)}
											{pill.icon === "headset" && (
												<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
													<path d="M6.25 15.75v-2.25a5.75 5.75 0 0 1 11.5 0v2.25" />
													<rect x="4.75" y="15" width="3.75" height="5.25" rx="1.7" />
													<rect x="15.5" y="15" width="3.75" height="5.25" rx="1.7" />
												</svg>
											)}
										</span>
										<span class="course-pill__label">{pill.label}</span>
									</a>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</Container>

		<!-- Wave at bottom edge -->
		<div class="hero__wave" aria-hidden="true">
			<svg viewBox="0 0 1440 100" preserveAspectRatio="none">
				<path class="hero__wave-path hero__wave-path--back" d="M0,45 C200,85 440,10 720,50 C1000,90 1240,15 1440,45 L1440,100 L0,100 Z" />
				<path class="hero__wave-path hero__wave-path--front" d="M0,60 C280,25 560,85 860,45 C1080,18 1300,65 1440,50 L1440,100 L0,100 Z" />
			</svg>
		</div>
	</section>

	<!-- ===== FLOATING FEATURE CARDS ===== -->
	<div class="hero-cards">
		<Container>
			<FeatureCards cards={featureCards} />
		</Container>
	</div>

	<!-- ===== REST OF PAGE ===== -->
	<Section id="about" class="section--after-hero">
		<Container>
			<WisdomPanel
				eyebrow={homeText("about_eyebrow")}
				titleBefore={homeText("about_title_before")}
				titleHighlight={homeText("about_title_highlight")}
				paragraph1={homeText("about_paragraph_1")}
				paragraph2={homeText("about_paragraph_2")}
				image={homePage?.data.about_image}
				imageAlt={homeText("about_image_alt")}
				years={contact.stats.years}
			/>
		</Container>
	</Section>

	<Section id="standing-out" space="tight">
		<Container>
			<StandingOut
				eyebrow={homeText("standing_eyebrow")}
				heading={homeText("standing_heading")}
				items={standingItems}
			/>
		</Container>
	</Section>

	<Section id="courses">
		<Container>
			<div class="journey-head">
				<div class="journey-head__copy">
					<h2 data-reveal-words {...homeEdit?.courses_journey_heading}>
						{homeText("courses_journey_heading")}
					</h2>
					<p data-reveal="up" data-reveal-delay="80" {...homeEdit?.courses_journey_intro}>
						{homeText("courses_journey_intro")}
					</p>
				</div>
				<Button book variant="secondary">{t.actions.bookFreeTrial}</Button>
			</div>

			<ol class="journey-list">
				{
					courses.map((course, index) => (
						<CourseRow
							index={index + 1}
							title={getCourseCopy(course).name}
							summary={getCourseCopy(course).summary}
							level={getCourseCopy(course).level}
							arabic={locale === "ar" ? undefined : course.data.arabic_name}
							prefillCourse={course.id}
						/>
					))
				}
			</ol>

			<div class="study-stack">
				<FeatureSplit
					headingBefore={homeText("split1_heading_before")}
					headingHighlight={homeText("split1_heading_highlight")}
					paragraphs={[
						homeText("split1_paragraph_1"),
						homeText("split1_paragraph_2"),
					]}
					image={homePage?.data.split1_image}
