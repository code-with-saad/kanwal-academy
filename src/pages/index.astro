	<Section id="pricing">
		<Container>
			<div class="section-head">
				<Eyebrow edit={homeEdit?.pricing_eyebrow}>
					{homeText("pricing_eyebrow")}
				</Eyebrow>
				<h2 {...homeEdit?.pricing_heading} data-reveal-words>
					{homeText("pricing_heading")}
				</h2>
