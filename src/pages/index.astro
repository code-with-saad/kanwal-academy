---
import { getEmDashCollection, getEmDashEntry, getSeoMeta } from "emdash";
import type { ContentEntry, ImageValue } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import BookTrial from "../components/BookTrial.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import CourseRow from "../components/CourseRow.astro";
import Eyebrow from "../components/Eyebrow.astro";
import FeatureCards from "../components/FeatureCards.astro";
import FeatureSplit from "../components/FeatureSplit.astro";
import PlanCard from "../components/PlanCard.astro";
import Section from "../components/Section.astro";
import StandingOut from "../components/StandingOut.astro";
import StatsBand from "../components/StatsBand.astro";
import Step from "../components/Step.astro";
import TeachersGrid from "../components/TeachersGrid.astro";
import Testimonials from "../components/Testimonials.astro";
import WisdomPanel from "../components/WisdomPanel.astro";
import { site, teacherNavItem } from "../config/site";
import { heroImage } from "../config/images";
import { getSiteContact } from "../utils/site-config";
import { isDemoMode } from "../utils/env";
import { formatUsdPrice } from "../utils/price";
import type { Page } from "../../emdash-env";

interface HomePageFields {
	home_eyebrow?: string;
	home_headline?: string;
	home_highlight?: string;
	home_lead?: string;
	home_image?: ImageValue;
	home_primary_cta?: string;
	home_secondary_cta?: string;
	courses_eyebrow?: string;
	courses_heading?: string;
	courses_intro?: string;
	courses_trial_cta?: string;
	courses_details_cta?: string;
	courses_format_label?: string;
	pricing_eyebrow?: string;
	pricing_heading?: string;
	pricing_intro?: string;
	pricing_period_label?: string;
	pricing_classes_week_label?: string;
	pricing_classes_month_label?: string;
	pricing_hours_label?: string;
	pricing_popular_label?: string;
	pricing_select_cta?: string;
	trial_eyebrow?: string;
	trial_heading?: string;
	trial_step_1_title?: string;
	trial_step_1_body?: string;
	trial_step_2_title?: string;
	trial_step_2_body?: string;
	trial_step_3_title?: string;
	trial_step_3_body?: string;
}

type HomeTextField = Exclude<keyof HomePageFields, "home_image">;

const [
	coursesResult,
	plansResult,
	testimonialsResult,
	contactResult,
	homeResult,
	teachersResult,
] = await Promise.all([
	getEmDashCollection("courses", {
		status: "published",
		orderBy: { order: "asc" },
	}),
	getEmDashCollection("plans", {
		status: "published",
		orderBy: { order: "asc" },
	}),
	getEmDashCollection("testimonials", {
		status: "published",
		orderBy: { order: "asc" },
	}),
	getSiteContact(),
	getEmDashEntry("pages", "home"),
	getEmDashCollection("teachers", {
		status: "published",
		orderBy: { order: "asc" },
	}),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(coursesResult.cacheHint);
	Astro.cache.set(plansResult.cacheHint);
	Astro.cache.set(testimonialsResult.cacheHint);
	Astro.cache.set(contactResult.cacheHint);
	Astro.cache.set(homeResult.cacheHint);
	Astro.cache.set(teachersResult.cacheHint);
}

const courses = coursesResult.entries;
const plans = plansResult.entries;
const testimonials = testimonialsResult.entries.filter(
	(testimonial) => testimonial.data.consent_given === true,
);
const teachers = teachersResult.entries;
const contact = contactResult.data;
const demo = isDemoMode();
const hasTeachers = teachers.length > 0 || demo;
const navItems = hasTeachers
	? [...site.nav.slice(0, 4), teacherNavItem, ...site.nav.slice(4)]
	: [...site.nav];

// Arabic course names supplied by the academy.
const courseArabic: Record<string, string> = {
	"quranic-recitation": "القراءة",
	"tajweed-proficiency": "التجويد",
	"memorization-excellence": "الحفظ",
};

const homePage = homeResult.entry as ContentEntry<Page & HomePageFields> | null;
const homeText = (field: HomeTextField, fallback: string) =>
	homePage?.data[field]?.trim() || fallback;
const homeEdit = homePage?.edit;
const seo = homePage
	? getSeoMeta(homePage, {
			siteUrl: Astro.url.origin,
			path: "/",
			defaultTitle: site.name,
			defaultDescription: site.description,
		})
	: null;

const rawHeadline = homeText(
	"home_headline",
	"Recite the Qur'an with a teacher who knows your name.",
);
// Strip markdown-style asterisks the CMS uses for word highlighting.
const heroHeadline = rawHeadline.replace(/\*([^*]+)\*/g, "$1");
const heroLead = homeText(
	"home_lead",
	"One-to-one lessons in recitation, tajweed and memorization. Start with a free trial class from wherever you are.",
);

const toPlanCard = (plan: (typeof plans)[number]) => ({
	slug: plan.id,
	name: plan.data.name,
	price: plan.data.price,
	classesPerWeek: plan.data.classes_per_week,
	classesPerMonth: plan.data.classes_per_month,
	hoursPerMonth: plan.data.hours_per_month,
	isPopular: plan.data.is_popular ?? false,
});

const lowestPlanPrice = plans.length
	? Math.min(...plans.map((plan) => Number(plan.data.price)))
	: 20;

const [recitationCourse, tajweedCourse, memorizationCourse] = courses;

// Pill chips linking to course sections.
const coursePills = [
	{
		href: "/#courses",
		label: recitationCourse?.data.name ?? "Qur'anic Recitation",
		icon: "book" as const,
	},
	{
		href: "/#courses",
		label: tajweedCourse?.data.name ?? "Tajweed Proficiency",
		icon: "waves" as const,
	},
	{
		href: "/#courses",
		label: memorizationCourse?.data.name ?? "Memorization Excellence",
		icon: "bookmark" as const,
	},
	{
		href: "/#book",
		label: "Live one-to-one",
		icon: "headset" as const,
	},
];

// The testimonials section is only rendered when it has content, so the
// globe card falls back to #about when it is hidden.
const hasTestimonials = testimonials.length > 0 || demo;

const featureCards = [
	{
		title: "Free trial class",
		text: "Meet your teacher first.",
		href: "#book",
		icon: "trial" as const,
		isFirst: true,
	},
	{
		title: `Plans from ${formatUsdPrice(lowestPlanPrice)}/month`,
		text: "Choose a weekly pace.",
		href: "#pricing",
		icon: "price" as const,
	},
	{
		title: `Students in ${contact.stats.countries} countries`,
		text: "Join families worldwide.",
		href: hasTestimonials ? "#testimonials" : "#about",
		icon: "globe" as const,
	},
	{
		title: "Learn on any device",
		text: "Phone, tablet or laptop.",
		href: "#how-it-works",
		icon: "device" as const,
	},
];

const steps = [
	{
		title: homeText("trial_step_1_title", "Book your free trial"),
		body: homeText(
			"trial_step_1_body",
			"Choose a plan and pick a time that works for you. The trial class is free.",
		),
		titleEdit: homeEdit?.trial_step_1_title,
		bodyEdit: homeEdit?.trial_step_1_body,
	},
	{
		title: homeText("trial_step_2_title", "Meet your teacher"),
		body: homeText(
			"trial_step_2_body",
			"We match you with a teacher for your course and level, then assess where you are.",
		),
		titleEdit: homeEdit?.trial_step_2_title,
		bodyEdit: homeEdit?.trial_step_2_body,
	},
	{
		title: homeText("trial_step_3_title", "Start your plan"),
		body: homeText(
			"trial_step_3_body",
			"Your teacher builds a weekly schedule around your goals and keeps you accountable.",
		),
		titleEdit: homeEdit?.trial_step_3_title,
		bodyEdit: homeEdit?.trial_step_3_body,
	},
];
---

<Base
	title={seo?.title}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={
		homePage ? { collection: "pages", id: homePage.data.id, slug: homePage.id } : undefined
	}
	nav={navItems}
>
	<!-- ===== HERO ===== -->
	<section id="home" class="hero" data-hero>
		<!-- Gradient background -->
		<div class="hero__bg" aria-hidden="true"></div>

		<!-- Star motifs near edges -->
		<div class="hero__stars" aria-hidden="true">
			<svg class="hero__star hero__star--tl" viewBox="0 0 80 80" width="80" height="80">
				<g fill="none" stroke="currentColor" stroke-width="0.8">
					<rect x="20" y="20" width="40" height="40" />
					<rect x="20" y="20" width="40" height="40" transform="rotate(45 40 40)" />
					<circle cx="40" cy="40" r="14" />
				</g>
			</svg>
			<svg class="hero__star hero__star--tr" viewBox="0 0 80 80" width="64" height="64">
				<g fill="none" stroke="currentColor" stroke-width="0.8">
					<rect x="20" y="20" width="40" height="40" />
					<rect x="20" y="20" width="40" height="40" transform="rotate(45 40 40)" />
					<circle cx="40" cy="40" r="14" />
				</g>
			</svg>
			<svg class="hero__star hero__star--bl" viewBox="0 0 80 80" width="56" height="56">
				<g fill="none" stroke="currentColor" stroke-width="0.8">
					<rect x="20" y="20" width="40" height="40" />
					<rect x="20" y="20" width="40" height="40" transform="rotate(45 40 40)" />
					<circle cx="40" cy="40" r="14" />
				</g>
			</svg>
			<svg class="hero__star hero__star--br" viewBox="0 0 80 80" width="72" height="72">
				<g fill="none" stroke="currentColor" stroke-width="0.8">
					<rect x="20" y="20" width="40" height="40" />
					<rect x="20" y="20" width="40" height="40" transform="rotate(45 40 40)" />
					<circle cx="40" cy="40" r="14" />
				</g>
			</svg>
		</div>

		<Container>
			<div class="hero__grid">
				<!-- Left: Copy -->
				<div class="hero__copy" data-reveal="up">
					<h1 class="hero__headline">{heroHeadline}</h1>
					<p class="hero__lead" data-reveal="up" data-reveal-delay="120">
						{heroLead}
					</p>
					<p class="hero__reach" data-reveal="up" data-reveal-delay="200">
						<svg
							class="hero__reach-icon"
							viewBox="0 0 20 20"
							width="18"
							height="18"
							aria-hidden="true"
							focusable="false"
						>
							<circle cx="10" cy="10" r="8.5" fill="none" stroke="currentColor" stroke-width="1.3" />
							<ellipse cx="10" cy="10" rx="3.5" ry="8.5" fill="none" stroke="currentColor" stroke-width="1.3" />
							<path d="M1.5 10h17" stroke="currentColor" stroke-width="1.3" />
						</svg>
						<span>Students learning from {contact.stats.countries} countries</span>
					</p>
					<a href="#book" class="hero__cta" data-reveal="up" data-reveal-delay="280">
						Start your free trial
						<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M4 10h12m-5-5 5 5-5 5" />
						</svg>
					</a>
				</div>

				<!-- Right: Visual + Chips -->
				<div class="hero__visual-group">
					<!-- Desktop: circle + chips side by side -->
					<!-- Mobile: white card containing both -->
					<div class="hero__visual-card">
						<div class="hero__visual">
							<div class="quran-stage">
								<!-- Mint circle backdrop -->
								<span class="quran-stage__backdrop" aria-hidden="true"></span>
								<!-- Ornamental geometric ring (rotating) -->
								<svg class="quran-stage__ring" viewBox="0 0 200 200" aria-hidden="true">
									<g fill="none" stroke="currentColor" stroke-width="0.55" opacity="0.35">
										<circle cx="100" cy="100" r="96" />
										<path d="M100 6 L108 92 L194 100 L108 108 L100 194 L92 108 L6 100 L92 92 Z" />
										<path d="M100 6 L108 92 L194 100 L108 108 L100 194 L92 108 L6 100 L92 92 Z" transform="rotate(22.5 100 100)" />
										<circle cx="100" cy="100" r="72" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(45 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(90 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(135 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(180 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(225 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(270 100 100)" />
										<path d="M100 28 Q128 64 100 100 Q72 64 100 28" transform="rotate(315 100 100)" />
										<circle cx="100" cy="100" r="48" />
									</g>
								</svg>
								<!-- Quran image -->
								<figure class="quran-stage__figure" {...homeEdit?.home_image}>
									<span class="quran-stage__float">
										{
											homePage?.data.home_image ? (
												<Image
													image={homePage.data.home_image}
													alt={heroImage.alt}
													class="quran-stage__image"
													priority
												/>
											) : (
												<img src={heroImage.src} alt={heroImage.alt} class="quran-stage__image" />
											)
										}
									</span>
								</figure>
							</div>
						</div>

						<!-- Course pill chips -->
						<div class="hero__chips">
							{
								coursePills.map((pill) => (
									<a href={pill.href} class="course-pill">
										<span class="course-pill__icon" aria-hidden="true">
											{pill.icon === "book" && (
												<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
													<path d="M12 6.1c-1.9-1.55-4.25-2-7-1.9v13.6c2.75-.1 5.1.35 7 1.9 1.9-1.55 4.25-2 7-1.9V4.2c-2.75-.1-5.1.35-7 1.9zm0 0v13.6" />
												</svg>
											)}
											{pill.icon === "waves" && (
												<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
													<path d="M5.25 10.5v3M8.5 8.25v7.5M12 6.25v11.5M15.5 8.25v7.5M18.75 10.5v3" />
												</svg>
											)}
											{pill.icon === "bookmark" && (
												<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
													<path d="M7.25 4.5h9.5v15l-4.75-3.5-4.75 3.5z" />
												</svg>
											)}
											{pill.icon === "headset" && (
												<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
													<path d="M6.25 15.75v-2.25a5.75 5.75 0 0 1 11.5 0v2.25" />
													<rect x="4.75" y="15" width="3.75" height="5.25" rx="1.7" />
													<rect x="15.5" y="15" width="3.75" height="5.25" rx="1.7" />
												</svg>
											)}
										</span>
										<span class="course-pill__label">{pill.label}</span>
									</a>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</Container>

		<!-- Wave at bottom edge -->
		<div class="hero__wave" aria-hidden="true">
			<svg viewBox="0 0 1440 100" preserveAspectRatio="none">
				<path class="hero__wave-path hero__wave-path--back" d="M0,45 C200,85 440,10 720,50 C1000,90 1240,15 1440,45 L1440,100 L0,100 Z" />
				<path class="hero__wave-path hero__wave-path--front" d="M0,60 C280,25 560,85 860,45 C1080,18 1300,65 1440,50 L1440,100 L0,100 Z" />
			</svg>
		</div>
	</section>

	<!-- ===== FLOATING FEATURE CARDS ===== -->
	<div class="hero-cards">
		<Container>
			<FeatureCards cards={featureCards} />
		</Container>
	</div>

	<!-- ===== REST OF PAGE ===== -->
	<Section id="about" class="section--after-hero">
		<Container>
			<WisdomPanel years={contact.stats.years} />
		</Container>
	</Section>

	<Section id="standing-out" space="tight">
		<Container>
			<StandingOut />
		</Container>
	</Section>

	<Section id="courses">
		<Container>
			<div class="journey-head">
				<div class="journey-head__copy">
					<h2 data-reveal-words>Start your journey</h2>
					<p data-reveal="up" data-reveal-delay="80">
						Three courses, each taught one to one. Pick the path that matches where you are and
						your teacher will set the pace from there.
					</p>
				</div>
				<Button href="/#book" variant="secondary">Book free trial</Button>
			</div>

			<ol class="journey-list">
				{
					courses.map((course, index) => (
						<CourseRow
							index={index + 1}
							title={course.data.name}
							summary={course.data.summary}
							level={course.data.level}
							arabic={courseArabic[course.id]}
							href={`/?course=${encodeURIComponent(course.id)}#book`}
						/>
					))
				}
			</ol>

			<div class="study-stack">
				<FeatureSplit
					headingBefore="Easy Qur'an learning"
					headingHighlight="online"
					paragraphs={[
						"Lessons run live in a video call, so you only need a phone, tablet or laptop with a camera. Your teacher shares the page you are reading and listens while you recite.",
						"The same teacher stays with you each week, so corrections and progress carry over from class to class.",
					]}
					imageSrc="/images/section-phone.png"
					imageAlt="A student joining a Qur'an lesson on a phone"
					imageLabel="Lesson on a phone (4:3)"
					imageRatio="4 / 3"
					buttonLabel="Book free trial"
					buttonHref="/#book"
				/>

				<FeatureSplit
					headingBefore="How to memorize the Qur'an"
					headingHighlight="with confidence"
					paragraphs={[
						"Memorization grows in small, steady steps. Your teacher sets a monthly target, listens to what you have learned, and revises with you before adding new lines.",
					]}
					imageSrc="/images/section-memorize.jpg"
					imageAlt="An open Qur'an with a page marker, ready for memorization practice"
					imageLabel="Memorization practice (4:3)"
					imageRatio="4 / 3"
					list={[
						"Set your intention",
						"Create a quiet space",
						"Listen and repeat",
						"Revise daily",
						"Break it into small parts",
						"Choose one surah at a time",
					]}
					buttonLabel="Book free trial"
					buttonHref="/#book"
					imageFirst
				/>
			</div>
		</Container>
	</Section>

	<!-- ===== STATS BAND ===== -->
	<StatsBand
		students={contact.stats.students}
		sessions={contact.stats.sessions}
		countries={contact.stats.countries}
	/>

	<Section id="how-it-works" space="tight">
		<Container>
			<div class="section-head">
				<Eyebrow edit={homeEdit?.trial_eyebrow}>
					{homeText("trial_eyebrow", "Free trial")}
				</Eyebrow>
				<h2 {...homeEdit?.trial_heading} data-reveal-words>
					{homeText("trial_heading", "How the free trial works")}
				</h2>
			</div>
			<ol class="steps">
				{
					steps.map((step, index) => (
						<Step
							number={index + 1}
							title={step.title}
							body={step.body}
							titleEdit={step.titleEdit}
							bodyEdit={step.bodyEdit}
						/>
					))
				}
			</ol>
		</Container>
	</Section>

	<Section id="pricing">
		<Container>
			<div class="section-head section-head--center">
				<Eyebrow edit={homeEdit?.pricing_eyebrow}>
					{homeText("pricing_eyebrow", "Pricing")}
				</Eyebrow>
				<h2 {...homeEdit?.pricing_heading} data-reveal-words>
					{homeText("pricing_heading", "Choose a plan that fits your week.")}
				</h2>
				<p class="section-lead" {...homeEdit?.pricing_intro} data-reveal="up" data-reveal-delay="80">
					{homeText(
						"pricing_intro",
						"Every plan is billed monthly and starts with a free trial class. Prices are in US dollars.",
					)}
				</p>
			</div>

			<div class="plan-grid" role="region" aria-label="Monthly plans">
				{
					plans.map((plan, index) => (
						<PlanCard
							plan={toPlanCard(plan)}
							variant={plan.data.is_popular ? "inverted" : "default"}
							href={`/?plan=${encodeURIComponent(plan.id)}#book`}
							revealDelay={index * 80}
							planEdit={plan.edit}
							homeEdit={homeEdit}
							periodLabel={homeText("pricing_period_label", "/ month")}
							classesWeekLabel={homeText(
								"pricing_classes_week_label",
								"Classes each week",
							)}
							classesMonthLabel={homeText(
								"pricing_classes_month_label",
								"Classes each month",
							)}
							hoursLabel={homeText("pricing_hours_label", "Teaching hours each month")}
							popularLabel={homeText("pricing_popular_label", "Most popular")}
							selectLabel={homeText("pricing_select_cta", "Select plan")}
						/>
					))
				}
			</div>
		</Container>
	</Section>

	{
		teachers.length > 0 || demo ? (
			<Section id="teachers">
				<Container>
					<div class="section-head">
						<Eyebrow>Teachers</Eyebrow>
						<h2 data-reveal-words>Meet your teachers</h2>
						<p class="section-lead" data-reveal="up" data-reveal-delay="80">
							Every lesson is one to one. We match students with a teacher who fits their
							course, level and time zone.
						</p>
					</div>
					<TeachersGrid teachers={teachers} demo={demo} />
				</Container>
			</Section>
		) : null
	}

	{
		hasTestimonials ? (
			<div id="testimonials">
				<Testimonials
					reviews={testimonials.map((testimonial) => ({
						quote: testimonial.data.quote,
						author: testimonial.data.author,
						country: testimonial.data.country,
					}))}
					demo={demo}
				/>
			</div>
		) : null
	}

	<Section id="book">
		<Container>
			<BookTrial
				contact={contact}
				plans={plans.map((plan) => ({
					id: plan.id,
					name: plan.data.name,
					price: plan.data.price,
				}))}
				courses={courses.map((course) => ({ id: course.id, name: course.data.name }))}
			/>
		</Container>
	</Section>
</Base>

<script>
	// Pause decorative loops while the hero is off screen.
	const hero = document.querySelector<HTMLElement>("[data-hero]");
	if (hero) {
		const ring = hero.querySelector<SVGSVGElement>(".quran-stage__ring");
		const floatEl = hero.querySelector<HTMLElement>(".quran-stage__float");
		const observer = new IntersectionObserver(
			([entry]) => {
				const offscreen = !entry?.isIntersecting;
				if (ring) ring.style.animationPlayState = offscreen ? "paused" : "running";
				if (floatEl) floatEl.style.animationPlayState = offscreen ? "paused" : "running";
			},
			{ threshold: 0.15 },
		);
		observer.observe(hero);
	}
</script>

