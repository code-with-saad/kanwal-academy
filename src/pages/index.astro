---
import { getEmDashCollection, getEmDashEntry, getSeoMeta } from "emdash";
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import CourseRow from "../components/CourseRow.astro";
import Eyebrow from "../components/Eyebrow.astro";
import PlanCard from "../components/PlanCard.astro";
import Section from "../components/Section.astro";
import Step from "../components/Step.astro";
import { site } from "../config/site";
import { getSiteContact } from "../utils/site-config";

const [coursesResult, plansResult, testimonialsResult, contactResult, homeResult] =
	await Promise.all([
		getEmDashCollection("courses", {
			status: "published",
			orderBy: { order: "asc" },
		}),
		getEmDashCollection("plans", {
			status: "published",
			orderBy: { order: "asc" },
		}),
		getEmDashCollection("testimonials", {
			status: "published",
			orderBy: { order: "asc" },
		}),
		getSiteContact(),
		getEmDashEntry("pages", "home"),
	]);

if (Astro.cache?.enabled) {
	Astro.cache.set(coursesResult.cacheHint);
	Astro.cache.set(plansResult.cacheHint);
	Astro.cache.set(testimonialsResult.cacheHint);
	Astro.cache.set(contactResult.cacheHint);
	Astro.cache.set(homeResult.cacheHint);
}

const courses = coursesResult.entries;
const plans = plansResult.entries;
const testimonials = testimonialsResult.entries.filter(
	(testimonial) => testimonial.data.consent_given === true,
);
const contact = contactResult.data;

const featuredPlan = plans.find((plan) => plan.data.is_popular) ?? plans[0];
const homePage = homeResult.entry;
const seo = homePage
	? getSeoMeta(homePage, {
			siteUrl: Astro.url.origin,
			path: "/",
			defaultTitle: site.name,
			defaultDescription: site.description,
		})
	: null;

const heroEyebrow = homePage?.data.home_eyebrow?.trim() || "Online Qur'an academy";
const heroHeadline =
	homePage?.data.home_headline?.trim() ||
	"Learn the Qur'an with a teacher who knows your name.";
const heroLead =
	homePage?.data.home_lead?.trim() ||
	"One-to-one lessons in recitation, tajweed and memorization. Start with a free trial class from wherever you are.";

const toPlanCard = (plan: (typeof plans)[number]) => ({
	slug: plan.id,
	name: plan.data.name,
	price: plan.data.price,
	classesPerWeek: plan.data.classes_per_week,
	classesPerMonth: plan.data.classes_per_month,
	hoursPerMonth: plan.data.hours_per_month,
	isPopular: plan.data.is_popular ?? false,
});

const steps = [
	{
		title: "Book your free trial",
		body: "Choose a plan and pick a time that works for you. The trial class is free.",
	},
	{
		title: "Meet your teacher",
		body: "We match you with a teacher for your course and level, then assess where you are.",
	},
	{
		title: "Start your plan",
		body: "Your teacher builds a weekly schedule around your goals and keeps you accountable.",
	},
];
---

<Base
	title={seo?.title}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={
		homePage ? { collection: "pages", id: homePage.data.id, slug: homePage.id } : undefined
	}
>
	<Section tone="dark" class="hero">
		<Container>
			<div class="hero__grid">
				<div class="hero__copy">
					<Eyebrow>{heroEyebrow}</Eyebrow>
					<h1>{heroHeadline}</h1>
					<p class="hero__lead">{heroLead}</p>
					<div class="hero__actions">
						<Button href="/free-trial" variant="primary" size="lg">Get free trial</Button>
						<Button href="/courses" variant="secondary" size="lg">Explore courses</Button>
					</div>
					<p class="hero__note">
						{contact.stats.years} years teaching. Students in {contact.stats.countries}
						countries.
					</p>
				</div>

				{
					featuredPlan && (
						<div class="hero__plan">
							<PlanCard
								plan={toPlanCard(featuredPlan)}
								variant="hero"
								showBismillah
								headingLevel={2}
								href={`/free-trial?plan=${encodeURIComponent(featuredPlan.id)}`}
							/>
						</div>
					)
				}
			</div>
		</Container>
	</Section>

	<Section>
		<Container>
			<div class="split">
				<div class="split__intro">
					<Eyebrow>Courses</Eyebrow>
					<h2>Three paths through the Qur'an.</h2>
					<p class="section-lead">
						Start where you are. Your teacher will meet you there and build the lessons around
						your level.
					</p>
					<div class="section-actions">
						<Button href="/courses" variant="secondary">See all courses</Button>
					</div>
				</div>

				<ol class="course-list">
					{
						courses.map((course, index) => (
							<CourseRow
								index={index + 1}
								title={course.data.name}
								summary={course.data.summary}
								level={course.data.level}
								href={`/courses/${course.id}`}
							/>
						))
					}
				</ol>
			</div>
		</Container>
	</Section>

	<Section tone="sand" space="tight">
		<Container>
			<ul class="numbers">
				<li class="number">
					<span class="number__value">{contact.stats.years}</span>
					<span class="number__label">Years teaching</span>
				</li>
				<li class="number">
					<span class="number__value">{contact.stats.countries}</span>
					<span class="number__label">Countries served</span>
				</li>
				<li class="number">
					<span class="number__value">{contact.stats.students}</span>
					<span class="number__label">Students taught</span>
				</li>
				<li class="number">
					<span class="number__value">{contact.stats.sessions}</span>
					<span class="number__label">Sessions delivered</span>
				</li>
			</ul>
		</Container>
	</Section>

	<Section>
		<Container>
			<div class="section-head section-head--center">
				<Eyebrow>Pricing</Eyebrow>
				<h2>Choose a plan that fits your week.</h2>
				<p class="section-lead">
					Every plan is billed monthly and starts with a free trial class. Prices are in US
					dollars.
				</p>
			</div>

			<div class="plan-grid">
				{
					plans.map((plan) => (
						<PlanCard
							plan={toPlanCard(plan)}
							variant={plan.data.is_popular ? "inverted" : "default"}
							href={`/free-trial?plan=${encodeURIComponent(plan.id)}`}
						/>
					))
				}
			</div>
		</Container>
	</Section>

	<Section tone="sand">
		<Container>
			<div class="section-head">
				<Eyebrow>Free trial</Eyebrow>
				<h2>How the free trial works</h2>
			</div>
			<ol class="steps">
				{
					steps.map((step, index) => (
						<Step number={index + 1} title={step.title} body={step.body} />
					))
				}
			</ol>
		</Container>
	</Section>

	{
		testimonials.length > 0 ? (
			<Section tone="dark">
				<Container size="narrow">
					<Eyebrow>Student voices</Eyebrow>
					<blockquote class="testimonial">
						<p class="testimonial__quote">{testimonials[0].data.quote}</p>
						<footer class="testimonial__author">
							<cite>{testimonials[0].data.author}</cite>
							{testimonials[0].data.country && (
								<span>{testimonials[0].data.country}</span>
							)}
						</footer>
					</blockquote>
				</Container>
			</Section>
		) : (
			import.meta.env.DEV && (
				<Section tone="sand" space="tight">
					<Container>
						<Eyebrow>Development note</Eyebrow>
						<p class="dev-note">
							Testimonials stay hidden until a real review is added in the admin and consent is
							marked. This note only appears in development.
						</p>
					</Container>
				</Section>
			)
		)
	}
</Base>

<style>
	.hero {
		padding-block: clamp(56px, 8vw, 112px) clamp(64px, 9vw, 128px);
	}

	.hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
		gap: clamp(32px, 6vw, 80px);
		align-items: center;
	}

	.hero__copy h1 {
		max-width: 13ch;
		margin-top: var(--space-lg);
	}

	.hero__lead {
		max-width: 46ch;
		margin-top: var(--space-lg);
		color: var(--muted-on-dark);
		font-size: clamp(1.125rem, 0.5vw + 1rem, 1.3125rem);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-xl);
	}

	.hero__note {
		margin-top: var(--space-xl);
		color: var(--muted-on-dark);
		font-size: var(--size-small);
	}

	.hero__plan {
		justify-self: end;
		width: 100%;
		max-width: 380px;
	}

	.split {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(32px, 6vw, 80px);
		align-items: start;
	}

	.split__intro h2 {
		max-width: 12ch;
		margin-top: var(--space-md);
	}

	.section-lead {
		max-width: 48ch;
		margin-top: var(--space-md);
		color: var(--muted);
	}

	.section-actions {
		margin-top: var(--space-lg);
	}

	.section-head {
		max-width: 56ch;
		margin-bottom: var(--space-xl);
	}

	.section-head h2 {
		margin-top: var(--space-md);
	}

	.section-head--center {
		margin-inline: auto;
		text-align: center;
	}

	.section-head--center .section-lead {
		margin-inline: auto;
	}

	.course-list {
		min-width: 0;
	}

	.numbers {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-lg);
	}

	.number {
		padding-top: var(--space-md);
		border-top: 1px solid var(--hairline-light);
	}

	.number__value {
		display: block;
		font-family: var(--font-heading, Georgia, serif);
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.number__label {
		display: block;
		margin-top: var(--space-xs);
		color: var(--muted-ink);
		font-size: 0.875rem;
	}

	.plan-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-md);
		align-items: stretch;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-xl);
	}

	.testimonial {
		margin: var(--space-xl) 0 0;
	}

	.testimonial__quote {
		font-family: var(--font-heading, Georgia, serif);
		font-size: clamp(1.75rem, 3.4vw, 2.75rem);
		font-weight: 600;
		line-height: 1.16;
		letter-spacing: -0.015em;
	}

	.testimonial__author {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin-top: var(--space-lg);
		color: var(--muted-on-dark);
		font-size: var(--size-small);
		font-style: normal;
	}

	.testimonial__author cite {
		color: var(--text-on-dark);
		font-style: normal;
		font-weight: 600;
	}

	.dev-note {
		max-width: 56ch;
		margin-top: var(--space-md);
		color: var(--muted-ink);
	}

	@media (max-width: 1000px) {
		.hero__grid,
		.split {
			grid-template-columns: 1fr;
		}

		.hero__plan {
			justify-self: start;
		}

		.plan-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.numbers {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-md);
		}

		.steps {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}
	}

	@media (max-width: 560px) {
		.plan-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
