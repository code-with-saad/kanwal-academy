---
/**
 * Pricing page, in the About design language: mint hero panel, the full
 * Home pricing section (cards and mobile carousel), an "every plan
 * includes" panel, the free trial steps, a short FAQ and a closing CTA.
 */
import { Font } from "astro:assets";
import { getEmDashEntry, getSeoMeta } from "emdash";
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import CtaPanel from "../components/CtaPanel.astro";
import Curve from "../components/Curve.astro";
import Eyebrow from "../components/Eyebrow.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import HowItWorks from "../components/HowItWorks.astro";
import IncludesPanel from "../components/IncludesPanel.astro";
import JsonLd from "../components/JsonLd.astro";
import PageHero from "../components/PageHero.astro";
import PlanGrid from "../components/PlanGrid.astro";
import Section from "../components/Section.astro";
import { getLocalizedCollection, localizePath, useUi } from "../i18n";
import { getPageCopy } from "../i18n/pages";
import { toPlanCard } from "../utils/catalog";
import { getFaqs, faqPageJsonLd, type FaqItem } from "../utils/faqs";
import { makeHomeText } from "../utils/home-copy";
import { makePageImage, makePageRows, makePageText } from "../utils/page-copy";

const { locale, t } = useUi(Astro);
const copy = getPageCopy(locale).pricing;

const [homeResult, plansResult, faqs, pageResult] = await Promise.all([
	getEmDashEntry("home_page", "home", { locale }),
	getLocalizedCollection("plans", locale, {
		status: "published",
		orderBy: { order: "asc" },
	}),
	getFaqs(locale),
	getEmDashEntry("pricing_page", "pricing", { locale }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(homeResult.cacheHint);
	Astro.cache.set(plansResult.cacheHint);
	Astro.cache.set(faqs.cacheHint);
	Astro.cache.set(pageResult.cacheHint);
}

const homePage = homeResult.entry;
const homeText = makeHomeText(
	homePage?.data as Record<string, unknown> | undefined,
	homeResult.fallbackLocale,
	locale,
	t,
);
// Page-specific copy lives in the Pricing page collection; plan labels and
// trial steps still read the Home entry.
const pageData = pageResult.entry?.data as Record<string, unknown> | undefined;
const pageText = makePageText(pageData, pageResult.fallbackLocale, locale);
const pageRows = makePageRows(pageData, pageResult.fallbackLocale, locale);
const pageImage = makePageImage(pageData, pageResult.fallbackLocale, locale);
const seo =
	pageResult.entry && !pageResult.fallbackLocale
		? getSeoMeta(pageResult.entry, {
				siteUrl: Astro.url.origin,
				path: localizePath("/pricing", locale),
				defaultTitle: copy.title,
				defaultDescription: copy.description,
			})
		: null;

const plans = plansResult.entries
	.filter((plan) => plan.data.visible !== false)
	.map((plan) => toPlanCard(plan, plansResult.fallbackLocale, t, locale));

const heroChips = pageRows<{ label: string }>(
	"hero_chips",
	copy.heroChips.map((label) => ({ label })),
).map((row) => row.label);
const includesItems = pageRows<{ label: string }>(
	"includes_items",
	copy.includesItems.map((label) => ({ label })),
).map((row) => row.label);

// Keep the short FAQ about plans and payment, not the general parent questions.
const planFaqSlugs = ["card-for-trial", "cancel-or-pause", "free-trial", "class-length"];
const planFaqs = planFaqSlugs
	.map((slug) => faqs.items.find((item) => item.slug === slug))
	.filter((item): item is FaqItem => item !== undefined);
const pricingFaqs = planFaqs.length > 0 ? planFaqs : faqs.items.slice(0, 4);

const howItWorksSteps = [
	{
		title: homeText("trial_step_1_title"),
		text: homeText("trial_step_1_body"),
		icon: "book-trial" as const,
	},
	{
		title: homeText("trial_step_2_title"),
		text: homeText("trial_step_2_body"),
		icon: "teacher" as const,
	},
	{
		title: homeText("trial_step_3_title"),
		text: homeText("trial_step_3_body"),
		icon: "calendar-check" as const,
	},
];
---

<Base
	title={seo?.title ?? copy.title}
	description={seo?.description ?? copy.description}
	image={seo?.ogImage ?? undefined}
	robots={seo?.robots ?? undefined}
	breadcrumbs={[{ name: t.nav.pricing, path: "/pricing" }]}
	overlayHeader
>
	<!-- Amiri carries the Arabic brand watermark in the hero. -->
	<Font slot="head" cssVariable="--font-arabic" />

	<div class="inner">
		<PageHero
			eyebrow={pageText("eyebrow", copy.eyebrow)}
			headingBefore={pageText("hero_heading_before", copy.headingBefore)}
			headingHighlight={pageText("hero_heading_highlight", copy.headingHighlight)}
			headingAfter={pageText("hero_heading_after", copy.headingAfter)}
			heading={pageText("heading", copy.heading)}
			lead={pageText("lead", copy.lead)}
			imageSrc={pageImage("hero_image")?.src ?? "/images/course-tajweed.jpg"}
			imageAlt={pageText("hero_image_alt", copy.heroImageAlt)}
			badge={pageText("hero_badge", copy.heroBadge)}
			chips={heroChips}
		/>

		<Section id="pricing">
			<Container>
				<div class="section-head">
					<Eyebrow>{homeText("pricing_eyebrow")}</Eyebrow>
					<h2>{homeText("pricing_heading")}</h2>
					<p class="section-lead">{homeText("pricing_intro")}</p>
				</div>

				<PlanGrid
					plans={plans}
					periodLabel={homeText("pricing_period_label")}
					classesWeekLabel={homeText("pricing_classes_week_label")}
					classesMonthLabel={homeText("pricing_classes_month_label")}
					hoursLabel={homeText("pricing_hours_label")}
					popularLabel={homeText("pricing_popular_label")}
					selectCta={homeText("pricing_select_cta")}
				/>

				<div class="cancel-row">
					<p class="cancel-note">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="9" />
							<path d="M8.5 12.2l2.4 2.4 4.6-4.8" />
						</svg>
						{pageText("cancel_note", copy.cancelNote)}
					</p>
				</div>

				<p class="billing-note">{pageText("billing_note", copy.note)}</p>
			</Container>
		</Section>

		<Section id="includes" tone="sand" class="section--curve">
			<Container>
				<IncludesPanel
					eyebrow={pageText("includes_eyebrow", copy.includesEyebrow)}
					heading={pageText("includes_heading", copy.includesHeading)}
					lead={pageText("includes_lead", copy.includesLead)}
					items={includesItems}
				/>
			</Container>
			<Curve fill="var(--page)" line="var(--mint-300)" />
		</Section>

		<Section id="how-it-works">
			<Container>
				<HowItWorks
					eyebrow={homeText("trial_eyebrow")}
					heading={homeText("trial_heading")}
					steps={howItWorksSteps}
				/>
			</Container>
		</Section>

		{pricingFaqs.length > 0 && (
			<Section id="faq" space="tight">
				<Container size="narrow">
					<h2 class="pricing-faq__heading">{pageText("faq_heading", copy.faqHeading)}</h2>
					<FaqAccordion items={pricingFaqs} />
					<JsonLd data={faqPageJsonLd(pricingFaqs)} />
				</Container>
			</Section>
		)}

		<CtaPanel
			heading={pageText("cta_heading", copy.ctaHeading)}
			text={pageText("cta_text", copy.ctaText)}
			primaryHref={localizePath("/contact-us#book", locale)}
			primaryLabel={t.actions.bookFreeTrial}
		/>
	</div>
</Base>

<style>
	/* One rhythm for the whole page, same as About: 96px desktop, 56px mobile. */
	.inner {
		--section-gap: clamp(56px, 8vw, 96px);
	}

	.inner :global(.section--space-normal),
	.inner :global(.section--space-tight) {
		padding-block: var(--section-gap);
	}

	.inner :global(.section--curve) {
		position: relative;
		overflow: clip;
	}

	.section-head {
		max-width: 56ch;
		margin-bottom: var(--space-xl);
	}

	.section-head h2 {
		margin-top: var(--space-md);
	}

	.section-lead {
		max-width: 48ch;
		margin-top: var(--space-md);
		color: var(--type-copy-color);
	}

	.billing-note {
		margin-top: var(--space-lg);
		max-width: 60ch;
		color: var(--type-copy-color);
		font-size: var(--type-small-size);
		line-height: var(--type-small-line);
	}

	.cancel-row {
		display: flex;
		justify-content: center;
		margin-top: var(--space-lg);
	}

	.cancel-note {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 18px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--mint-50);
		color: var(--green-deep);
		font-size: var(--type-small-size);
		font-weight: 600;
	}

	.cancel-note svg {
		flex: none;
	}

	.pricing-faq__heading {
		margin-bottom: var(--space-lg);
	}
</style>