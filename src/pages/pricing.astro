---
/**
 * Pricing page. Renders the full Home pricing section (cards and mobile
 * carousel) plus the free trial steps, a short FAQ and a closing CTA.
 */
import { getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import CtaPanel from "../components/CtaPanel.astro";
import Eyebrow from "../components/Eyebrow.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import HowItWorks from "../components/HowItWorks.astro";
import PageHeader from "../components/PageHeader.astro";
import PlanGrid from "../components/PlanGrid.astro";
import Section from "../components/Section.astro";
import { getLocalizedCollection, localizePath, useUi } from "../i18n";
import { getPageCopy } from "../i18n/pages";
import { toPlanCard } from "../utils/catalog";
import { getFaqs } from "../utils/faqs";
import { makeHomeText } from "../utils/home-copy";

const { locale, t } = useUi(Astro);
const copy = getPageCopy(locale).pricing;

const [homeResult, plansResult, faqs] = await Promise.all([
	getEmDashEntry("pages", "home", { locale }),
	getLocalizedCollection("plans", locale, {
		status: "published",
		orderBy: { order: "asc" },
	}),
	getFaqs(locale, 4),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(homeResult.cacheHint);
	Astro.cache.set(plansResult.cacheHint);
	Astro.cache.set(faqs.cacheHint);
}

const homePage = homeResult.entry;
const homeText = makeHomeText(
	homePage?.data as Record<string, unknown> | undefined,
	homeResult.fallbackLocale,
	locale,
	t,
);

const plans = plansResult.entries
	.filter((plan) => plan.data.visible !== false)
	.map((plan) => toPlanCard(plan, plansResult.fallbackLocale, t, locale));

const howItWorksSteps = [
	{
		title: homeText("trial_step_1_title"),
		text: homeText("trial_step_1_body"),
		icon: "book-trial" as const,
	},
	{
		title: homeText("trial_step_2_title"),
		text: homeText("trial_step_2_body"),
		icon: "teacher" as const,
	},
	{
		title: homeText("trial_step_3_title"),
		text: homeText("trial_step_3_body"),
		icon: "calendar-check" as const,
	},
];
---

<Base
	title={copy.title}
	description={copy.description}
	breadcrumbs={[{ name: t.nav.pricing, path: "/pricing" }]}
>
	<Section space="tight">
		<Container>
			<PageHeader eyebrow={copy.eyebrow} heading={copy.heading} lead={copy.lead} />
		</Container>
	</Section>

	<Section id="pricing">
		<Container>
			<div class="section-head">
				<Eyebrow>{homeText("pricing_eyebrow")}</Eyebrow>
				<h2>{homeText("pricing_heading")}</h2>
				<p class="section-lead">{homeText("pricing_intro")}</p>
			</div>

			<PlanGrid
				plans={plans}
				periodLabel={homeText("pricing_period_label")}
				classesWeekLabel={homeText("pricing_classes_week_label")}
				classesMonthLabel={homeText("pricing_classes_month_label")}
				hoursLabel={homeText("pricing_hours_label")}
				popularLabel={homeText("pricing_popular_label")}
				selectCta={homeText("pricing_select_cta")}
			/>

			<p class="billing-note">{copy.note}</p>
		</Container>
	</Section>

	<Section id="how-it-works" space="tight">
		<Container>
			<HowItWorks
				eyebrow={homeText("trial_eyebrow")}
				heading={homeText("trial_heading")}
				steps={howItWorksSteps}
			/>
		</Container>
	</Section>

	<Section id="faq" space="tight">
		<Container size="narrow">
			<h2 class="pricing-faq__heading">{copy.faqHeading}</h2>
			<FaqAccordion items={faqs.items} />
		</Container>
	</Section>

	<CtaPanel
		heading={copy.ctaHeading}
		text={copy.ctaText}
		primaryHref={localizePath("/contact-us#book", locale)}
		primaryLabel={t.actions.bookFreeTrial}
	/>
</Base>

<style>
	.section-head {
		max-width: 56ch;
		margin-bottom: var(--space-xl);
	}

	.section-head h2 {
		margin-top: var(--space-md);
	}

	.section-lead {
		max-width: 48ch;
		margin-top: var(--space-md);
		color: var(--type-copy-color);
	}

	.billing-note {
		margin-top: var(--space-lg);
		max-width: 60ch;
		color: var(--type-copy-color);
		font-size: var(--type-small-size);
		line-height: var(--type-small-line);
	}

	.pricing-faq__heading {
		margin-bottom: var(--space-lg);
	}
</style>
