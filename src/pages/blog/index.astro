---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Section from "../../components/Section.astro";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const formatDate = (date: Date | null) =>
	date
		? date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
		: null;
---

<Base title="Blog" description="Notes and guides from Kanwal Quran Academy.">
	<Section space="tight">
		<Container>
			<div class="page-intro">
				<Eyebrow>Blog</Eyebrow>
				<h1>Notes from the academy.</h1>
				<p>Short guides for students and families learning Qur'an online.</p>
			</div>
		</Container>
	</Section>

	<Section space="tight">
		<Container>
			{
				posts.length > 0 ? (
					<ul class="post-grid">
						{posts.map((post) => (
							<li class="post-card">
								{post.data.featured_image && (
									<a href={`/blog/${post.id}`} class="post-card__image" tabindex="-1">
										<Image
											image={post.data.featured_image}
											alt={post.data.featured_image.alt || post.data.title}
										/>
									</a>
								)}
								<div class="post-card__body">
									{post.data.publishedAt && (
										<time datetime={post.data.publishedAt.toISOString()}>
											{formatDate(post.data.publishedAt)}
										</time>
									)}
									<h2>
										<a href={`/blog/${post.id}`}>{post.data.title}</a>
									</h2>
									{post.data.excerpt && <p>{post.data.excerpt}</p>}
								</div>
							</li>
						))}
					</ul>
				) : (
					<div class="empty-note">
						<h2>No articles yet.</h2>
						<p>New notes will appear here when they are published.</p>
					</div>
				)
			}
		</Container>
	</Section>
</Base>

<style>
	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--space-xl);
	}

	.post-card {
		display: grid;
		align-content: start;
		gap: var(--space-md);
	}

	.post-card__image {
		display: block;
		overflow: hidden;
		border-radius: var(--radius-card);
		background: var(--sand);
		aspect-ratio: 16 / 10;
	}

	.post-card__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.post-card__body time {
		color: var(--muted);
		font-size: 0.8125rem;
	}

	.post-card__body h2 {
		margin-top: var(--space-xs);
		font-size: var(--size-h3);
	}

	.post-card__body h2 a {
		text-decoration: none;
	}

	.post-card__body h2 a:hover {
		color: var(--sage-deep);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.post-card__body p {
		margin-top: var(--space-sm);
		color: var(--muted-ink);
		font-size: var(--size-small);
	}

	.empty-note {
		max-width: 52ch;
		padding-top: var(--space-lg);
		border-top: 1px solid var(--line);
	}

	.empty-note p {
		margin-top: var(--space-sm);
		color: var(--muted-ink);
	}
</style>
