---
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import Section from "../../components/Section.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.rewrite("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(post, {
	siteUrl: Astro.url.origin,
	path: `/blog/${post.id}`,
	defaultTitle: post.data.title,
	defaultDescription: post.data.excerpt,
});

const published = post.data.publishedAt
	? post.data.publishedAt.toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	: null;
---

<Base
	title={seo.title}
	pageTitle={post.data.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "posts", id: post.data.id, slug: post.id }}
>
	<Section space="tight">
		<Container size="narrow">
			<a href="/blog" class="back-link">All articles</a>

			<header class="post-header">
				{published && <time datetime={post.data.publishedAt?.toISOString()}>{published}</time>}
				<h1 {...post.edit.title}>{post.data.title}</h1>
				{post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
			</header>

			{post.data.featured_image && (
				<div class="post-image" {...post.edit.featured_image}>
					<Image
						image={post.data.featured_image}
						alt={post.data.featured_image.alt || post.data.title}
					/>
				</div>
			)}

			<div class="prose" {...post.edit.content}>
				<PortableText value={post.data.content} />
			</div>
		</Container>
	</Section>
</Base>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: var(--space-xl);
		color: var(--muted-ink);
		font-size: var(--size-small);
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.post-header time {
		color: var(--muted);
		font-size: 0.8125rem;
	}

	.post-header h1 {
		margin-top: var(--space-sm);
		font-size: var(--size-h2);
	}

	.post-excerpt {
		max-width: 54ch;
		margin-top: var(--space-md);
		color: var(--muted-ink);
		font-size: clamp(1.0625rem, 0.5vw + 1rem, 1.25rem);
	}

	.post-image {
		margin-top: var(--space-xl);
		overflow: hidden;
		border-radius: var(--radius-card);
	}

	.post-image :global(img) {
		width: 100%;
		height: auto;
	}

	.prose {
		margin-top: var(--space-2xl);
	}
</style>
