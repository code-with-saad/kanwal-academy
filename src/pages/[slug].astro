---
/**
 * Generic page route for the pages collection: legal pages (privacy, terms,
 * refund) and any other CMS page. Editors paste the final rich text in the
 * admin; the page renders it here, with the entry's own updated date.
 *
 * Unknown slugs return a real 404, not a redirect.
 */
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import Base from "../layouts/Base.astro";
import PageView from "../components/PageView.astro";
import { localizePath, useUi } from "../i18n";

const { locale, t } = useUi(Astro);
const slug = decodeSlug(Astro.params.slug);
if (!slug) {
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint, fallbackLocale } = await getEmDashEntry("pages", slug, {
	locale,
});
if (!page) {
	Astro.response.status = 404;
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// These three pages are legal documents: show the date the entry was updated.
const LEGAL_SLUGS = new Set(["privacy-policy", "terms-of-service", "refund-policy"]);
const isLegal = LEGAL_SLUGS.has(page.id);
const isFallback = locale === "ar" && fallbackLocale === "en";

const seo = getSeoMeta(page, {
	siteUrl: Astro.url.origin,
	path: localizePath(`/${page.id}`, locale),
});
---

<Base
	title={seo.title}
	pageTitle={page.data.title}
	description={seo.description ?? t.page.policyDescription.replace("{title}", page.data.title)}
	image={seo.ogImage}
	canonical={`${Astro.url.origin}${localizePath(`/${page.id}`, locale)}`}
	robots={seo.robots}
	breadcrumbs={[{ name: page.data.title, path: `/${page.id}` }]}
	content={{ collection: "pages", id: page.data.id, slug: page.id }}
>
	<PageView
		page={page}
		lastUpdated={isLegal ? page.data.updatedAt : undefined}
		fallback={isFallback}
	/>
</Base>
