---
/**
 * FAQ page, in the About design language: mint hero panel with fact chips,
 * the full accordion from the faqs collection and a closing CTA with a
 * WhatsApp line. Page copy lives in the faq_page collection.
 */
import { Font } from "astro:assets";
import { getEmDashEntry, getSeoMeta } from "emdash";
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import CtaPanel from "../components/CtaPanel.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import JsonLd from "../components/JsonLd.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import { localizePath, useUi } from "../i18n";
import { getPageCopy } from "../i18n/pages";
import { getFaqs, faqPageJsonLd } from "../utils/faqs";
import { makePageImage, makePageRows, makePageText } from "../utils/page-copy";
import { getSiteContact } from "../utils/site-config";

const { locale, t } = useUi(Astro);
const copy = getPageCopy(locale).faq;

const [faqs, pageResult, contactResult] = await Promise.all([
	getFaqs(locale),
	getEmDashEntry("faq_page", "faq", { locale }),
	getSiteContact(locale),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(faqs.cacheHint);
	Astro.cache.set(pageResult.cacheHint);
	Astro.cache.set(contactResult.cacheHint);
}

// Page-specific copy lives in the FAQ page collection; the questions
// themselves stay in the faqs collection.
const pageData = pageResult.entry?.data as Record<string, unknown> | undefined;
const pageText = makePageText(pageData, pageResult.fallbackLocale, locale);
const pageRows = makePageRows(pageData, pageResult.fallbackLocale, locale);
const pageImage = makePageImage(pageData, pageResult.fallbackLocale, locale);
const seo =
	pageResult.entry && !pageResult.fallbackLocale
		? getSeoMeta(pageResult.entry, {
				siteUrl: Astro.url.origin,
				path: localizePath("/faq", locale),
				defaultTitle: copy.title,
				defaultDescription: copy.description,
			})
		: null;

const factChips = pageRows<{ label: string }>(
	"facts_items",
	copy.factsItems.map((label) => ({ label })),
).map((row) => row.label);

// Group the questions by category, in the order the copy defines. Anything
// without a known category lands in a final General group.
const categoryOrder = Object.keys(copy.categoryLabels);
const faqGroups = categoryOrder
	.map((category) => ({
		category,
		label: copy.categoryLabels[category] ?? category,
		items: faqs.items.filter((item) => item.category === category),
	}))
	.filter((group) => group.items.length > 0);
const uncategorized = faqs.items.filter(
	(item) => !categoryOrder.includes(item.category),
);
if (uncategorized.length > 0) {
	faqGroups.push({
		category: "",
		label: copy.generalCategory,
		items: uncategorized,
	});
}
const groupAnchor = (category: string) =>
	`faq-${category.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "general"}`;
---

<Base
	title={seo?.title ?? copy.title}
	description={seo?.description ?? copy.description}
	image={seo?.ogImage ?? undefined}
	robots={seo?.robots ?? undefined}
	breadcrumbs={[{ name: t.nav.faq, path: "/faq" }]}
	overlayHeader
>
	<!-- Amiri carries the Arabic brand watermark in the hero. -->
	<Font slot="head" cssVariable="--font-arabic" />

	<div class="inner">
		<PageHero
			eyebrow={pageText("eyebrow", copy.eyebrow)}
			headingBefore={pageText("hero_heading_before", copy.headingBefore)}
			headingHighlight={pageText("hero_heading_highlight", copy.headingHighlight)}
			headingAfter={pageText("hero_heading_after", copy.headingAfter)}
			heading={pageText("heading", copy.heading)}
			lead={pageText("lead", copy.lead)}
			imageSrc={pageImage("hero_image")?.src ?? "/images/hero-faq.png"}
			imageAlt={pageText("hero_image_alt", copy.heroImageAlt)}
			badge={pageText("hero_badge", copy.heroBadge)}
			chips={factChips}
		/>

		<Section id="faq">
			<Container size="narrow">
				{faqGroups.length > 1 && (
					<nav class="faq-toc" aria-label={copy.title}>
						{faqGroups.map((group) => (
							<a class="faq-toc__chip" href={`#${groupAnchor(group.category)}`}>
								{group.label}
							</a>
						))}
					</nav>
				)}
				<div class="faq-groups">
					{faqGroups.map((group, index) => (
						<section
							class="faq-group"
							id={groupAnchor(group.category)}
							aria-label={group.label}
						>
							<h2 class="faq-group__heading">{group.label}</h2>
							<FaqAccordion items={group.items} openFirst={index === 0} />
						</section>
					))}
				</div>
				{faqs.items.length > 0 && <JsonLd data={faqPageJsonLd(faqs.items)} />}
				<p class="faq-more">
					<a
						href={`https://wa.me/${contactResult.data.whatsappNumber}`}
						target="_blank"
						rel="noopener noreferrer"
					>
						{pageText("more_text", copy.moreText)}
					</a>
				</p>
			</Container>
		</Section>

		<CtaPanel
			heading={pageText("cta_heading", t.home.book_heading)}
			text={pageText("cta_text", t.home.book_form_sub)}
			primaryHref={localizePath("/contact-us#book", locale)}
			primaryLabel={t.actions.bookFreeTrial}
		/>
	</div>
</Base>

<style>
	/* One rhythm for the whole page, same as About: 96px desktop, 56px mobile. */
	.inner {
		--section-gap: clamp(56px, 8vw, 96px);
	}

	.inner :global(.section--space-normal),
	.inner :global(.section--space-tight) {
		padding-block: var(--section-gap);
	}

	.faq-toc {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-bottom: var(--space-xl);
	}

	.faq-toc__chip {
		display: inline-flex;
		align-items: center;
		height: 36px;
		padding-inline: 18px;
		border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
		border-radius: 999px;
		color: var(--ink);
		font-size: var(--type-small-size);
		text-decoration: none;
		transition:
			background-color var(--transition),
			color var(--transition),
			border-color var(--transition);
	}

	.faq-toc__chip:hover,
	.faq-toc__chip:focus-visible {
		background: var(--green);
		border-color: var(--green);
		color: var(--on-accent);
	}

	.faq-groups {
		display: grid;
		gap: clamp(40px, 6vw, 64px);
	}

	.faq-group {
		scroll-margin-top: calc(var(--header-height) + 32px);
	}

	.faq-group__heading {
		margin-bottom: var(--space-md);
		font-size: clamp(1.375rem, 2.4vw, 1.75rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.faq-more {
		margin-top: var(--space-xl);
		text-align: center;
	}

	.faq-more a {
		color: var(--green-deep);
		font-weight: 500;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
</style>