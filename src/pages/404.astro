---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import { localizePath, useUi } from "../i18n";

const { locale, t } = useUi(Astro);
---

<Base title={t.notFound.title} robots="noindex, nofollow">
	<Section>
		<Container>
			<div class="not-found">
				<p class="not-found__code">404</p>
				<h1>{t.notFound.title}</h1>
				<p class="not-found__lead">
					{t.notFound.lead}
				</p>
				<div class="not-found__actions">
					<Button href={localizePath("/", locale)} variant="primary">{t.actions.goHome}</Button>
					<Button href={localizePath("/#book", locale)} variant="secondary">{t.actions.contactUs}</Button>
				</div>
			</div>
		</Container>
	</Section>
</Base>

<style>
	.not-found {
		display: grid;
		justify-items: start;
		gap: var(--space-md);
		max-width: 52ch;
		padding-block: var(--space-2xl);
	}

	.not-found__code {
		color: var(--ink-muted);
		font-size: calc(var(--type-display-size) * 2);
		font-weight: 600;
		line-height: 0.9;
		letter-spacing: -0.03em;
	}

	.not-found__lead {
		color: var(--ink-muted);
		font-size: var(--type-lead-size);
	}

	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-sm);
	}
</style>
